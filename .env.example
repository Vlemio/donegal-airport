# This project uses Keystatic Cloud for content management (see
# keystatic.config.ts) — no GitHub OAuth app credentials are needed here.

# ID of the secret GitHub Gist the Donegal FIDS pushes flights.json to.
# Not a credential by itself, but kept out of committed source.
FLIGHTS_GIST_ID=

# Optional — raises the anonymous 60/hr GitHub API read limit to 5000/hr.
# Same fine-grained "Gist: read and write" token the FIDS uses to write.
FLIGHTS_GIST_TOKEN=
