---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { getLocale, altLocalePath, t, type Locale } from "../i18n";

// TODO: swap for the real GA4 Measurement ID once it's created (see
// CLAUDE.md / the ago-2026 cookie-consent conversation for the
// access-control notes on who should own that Google account). Left as a
// placeholder — same pattern as WEB3FORMS_KEY in contact.astro — so gtag.js
// simply isn't loaded at all until a real ID replaces this string.
const GA4_MEASUREMENT_ID = "REPLACE_WITH_REAL_GA4_ID";
const hasGA4 = !GA4_MEASUREMENT_ID.startsWith("REPLACE_WITH");

interface Props {
  title: string;
  description?: string;
  /** Optional theme class for <html>, e.g. "ops-theme" for /flights. */
  pageTheme?: string;
  /** Path (relative to /public) of the Open Graph image. */
  ogImage?: string;
  /** Force noindex regardless of the sitewide pitch-preview flag below —
      for internal tool pages that must never appear in search results. */
  noindex?: boolean;
}

const {
  title,
  description = "",
  pageTheme = "",
  ogImage = "/og-default.png",
  noindex = false,
} = Astro.props;

const locale: Locale = getLocale(Astro.url.pathname);
const altPath = altLocalePath(Astro.url.pathname, locale);
const altLocale: Locale = locale === "en" ? "ga" : "en";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/ga/";

// Header transparency — computed server-side so it's correct from the very
// first paint on a hard load/reload, not just after client JS runs (see
// SOLID_HEADER_PATHS in animations.ts, which keeps this in sync for
// client-side View Transitions navigations).
const SOLID_HEADER_PATHS = [
  "/flights", "/plan", "/contact",
  "/ga/flights", "/ga/plan", "/ga/contact",
  "/privacy", "/safety", "/security", "/quality", "/environmental", "/language-policy", "/terms",
  "/ga/privacy", "/ga/safety", "/ga/security", "/ga/quality", "/ga/environmental", "/ga/language-policy", "/ga/terms",
];
const pathNoTrailingSlash = Astro.url.pathname.replace(/\/+$/, "") || "/";
const transparentHeader = !SOLID_HEADER_PATHS.includes(pathNoTrailingSlash);

const siteName = t("site.name", locale);
const siteDescription = description || t("site.description", locale);

// JSON.stringify doesn't escape "</script>" — a CMS-editable field (e.g. a
// news article's lead, embedded elsewhere via siteDescription) containing
// that sequence could break out of the script tag. Escaping every "<" is
// the standard safe fix and is a no-op for valid JSON (which never needs
// a literal "<").
const safeJsonLd = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");

// JSON-LD: Airport schema on every page, plus a WebSite block on
// the home page so Google can show CFN in its knowledge panel.
// Geo and ICAO/IATA from the airport's published Aerodrome Manual.
const airportSchema = {
  "@context": "https://schema.org",
  "@type": "Airport",
  name: siteName,
  alternateName: "Carrickfinn Airport",
  iataCode: "CFN",
  icaoCode: "EIDL",
  url: Astro.site?.href ?? "https://donegal-airport.vercel.app/",
  logo: new URL("/favicon.png", Astro.site).href,
  image: ogImageUrl,
  description: siteDescription,
  telephone: "+353749548284",
  email: "info@donegalairport.ie",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Carrickfinn, Kincasslagh",
    addressLocality: "Letterkenny",
    addressRegion: "Co. Donegal",
    postalCode: "F94 X2RH",
    addressCountry: "IE",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 55.044192,
    longitude: -8.340833,
  },
  sameAs: [
    "https://www.facebook.com/donegalairport",
    "https://www.instagram.com/donegalairport",
    "https://twitter.com/DonegalA",
    "https://www.linkedin.com/company/donegal-airport",
    "https://www.youtube.com/@donegalairport89",
    "https://www.tiktok.com/@donegalairport",
  ],
};

// Map our internal locale codes to the BCP 47 codes browsers and
// search engines expect in hreflang / og:locale.
const localeTag: Record<Locale, string> = {
  en: "en-IE",
  ga: "ga-IE",
};
---

<!doctype html>
<html lang={locale === "ga" ? "ga" : "en"} class={pageTheme} data-transparent-header={transparentHeader ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google Consent Mode v2 — must run before gtag.js (or anything else
        that could set a cookie) loads. Every category defaults to
        "denied"; ad_storage/ad_user_data/ad_personalization stay denied
        permanently (no ads/remarketing on this site — see
        CookieConsent.astro). If the visitor already granted analytics
        consent on a previous visit (remembered in localStorage), re-apply
        that immediately so GA4 tracks correctly from the very first
        pageview instead of waiting for the banner script further down. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
      try {
        var stored = JSON.parse(localStorage.getItem("cookie-consent"));
        if (stored && stored.analytics === true) {
          gtag("consent", "update", { analytics_storage: "granted" });
        }
      } catch (e) {}
    </script>
    {
      hasGA4 && (
        <>
          <script is:inline define:vars={{ GA4_MEASUREMENT_ID }} async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`} />
          <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", GA4_MEASUREMENT_ID);
          </script>
        </>
      )
    }

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    {/* Playfair Display — used for the café-menu names on /plan */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    {/* Space Mono + Switzer — used site-wide, previously loaded via @import
        inside global.css. A runtime @import for an external URL isn't
        inlined at build time, so the browser had to download and start
        parsing the whole CSS bundle before it could even discover these
        and start fetching them — a fully serial extra round-trip per font,
        flagged by Lighthouse as render-blocking. <link> tags here let the
        preload scanner find them immediately, fetching in parallel with
        everything else instead of after it. */}
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@200,300,400,500,600,700,800,900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {siteDescription && <meta name="description" content={siteDescription} />}
    <link rel="canonical" href={canonical} />

    {/* hreflang pairs so Google knows the two language versions are
        equivalents of each other. */}
    <link
      rel="alternate"
      hreflang="en-IE"
      href={new URL(locale === "en" ? Astro.url.pathname : altPath, Astro.site).href}
    />
    <link
      rel="alternate"
      hreflang="ga-IE"
      href={new URL(locale === "ga" ? Astro.url.pathname : altPath, Astro.site).href}
    />
    <link rel="alternate" hreflang="x-default" href={Astro.site?.href ?? "/"} />

    {/* PITCH-PREVIEW: block indexing while the site lives on the
        vercel.app domain so it doesn't compete in Google with the
        real airport site (donegalairport.ie). Pair with the
        `Disallow: /` in public/robots.txt. Remove this tag AND
        update robots.txt the day we move to the real domain. */}
    <meta name="robots" content="noindex, nofollow" />
    {/* Permanent (survives the pitch-preview flag above being removed) —
        for pages like internal tools that must never be indexed. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph — used by WhatsApp, Facebook, LinkedIn, iMessage */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {siteDescription && <meta property="og:description" content={siteDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={localeTag[locale]} />
    <meta property="og:locale:alternate" content={localeTag[altLocale]} />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {siteDescription && <meta name="twitter:description" content={siteDescription} />}
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Structured data for Google */}
    <script type="application/ld+json" set:html={safeJsonLd(airportSchema)} />
    {
      isHome && (
        <script
          type="application/ld+json"
          set:html={safeJsonLd({
            "@context": "https://schema.org",
            "@type": "WebSite",
            url: Astro.site?.href ?? "https://donegal-airport.vercel.app/",
            name: siteName,
            inLanguage: localeTag[locale],
          })}
        />
      )
    }

    {/* No-JS fallback: undo the [data-animate] opacity:0 from
        global.css so users without JavaScript still see content. */}
    <noscript>
      <style>[data-animate] { opacity: 1 !important; }</style>
    </noscript>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
    <script>
      import "../scripts/animations.ts";
    </script>
    <script>
      // View Transitions (ClientRouter) navigate via fetch + DOM swap, so
      // document.referrer never updates after the first real page load —
      // it stays frozen on whatever page the browser session actually
      // started from. Pages that need "where did the visitor just come
      // from" (e.g. news/[slug].astro's back link) read sessionStorage's
      // "nav-from" instead, which this tracks purely by page-load order
      // (not by which link was clicked/hovered — Astro's prefetch fires
      // before-preparation for hovered links too, not just the one
      // actually navigated to, which made that approach unreliable).
      document.addEventListener("astro:page-load", () => {
        const prev = sessionStorage.getItem("current-page");
        if (prev !== null) sessionStorage.setItem("nav-from", prev);
        sessionStorage.setItem("current-page", location.pathname);
      });
    </script>
  </body>
</html>
