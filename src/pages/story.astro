---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";

const locale = "en";
const title = `${t("site.name", locale)} · The story`;
const description =
  "From a 610-metre grass strip in 1978 and a £85 ticket on Christmas Eve 1985 to the world's most scenic approach and Ireland's first ACA Level 4 carbon-accredited airport. The story of CFN.";

/*
  Path-drawing story layout (v5).
  Desktop: SVG curved path draws itself as the user scrolls. Six chapter
  cards alternate left / right of the path. The GSAP + ScrollTrigger
  wiring lives in animations.ts → setupStoryPath().
  Mobile: single centred column, SVG hidden.
*/
const chapters = [
  {
    year: "1978",
    range: "Before the airport",
    title: "A grass strip on the dunes.",
    lead:
      "The IDA needed an air link for the new industrial estate at Annagry. In March 1978, on a sandbar between the Atlantic and Mount Errigal, a 610-metre grass runway opened.",
    body: [
      "For seven years no scheduled flight took off from it. A handful of private aircraft, the odd connection to Derry, and a runway that disappeared under blown sand every winter.",
      "By the mid-1980s the grass was replaced with a hard surface and a temporary prefab terminal went up. Donegal had an aerodrome. It just didn't have an airline yet.",
    ],
  },
  {
    year: "1985",
    range: "Christmas Eve",
    title: "A lawyer, an Islander, an eighty-five-pound ticket.",
    lead:
      "On Christmas Eve 1985 Frank Cannon — a Glasgow solicitor with a father from Ardara and a mother from Ranafast — flew the first commercial service himself. A nine-seat Britten-Norman Islander, fifty-five minutes to Glasgow, £85 one way.",
    body: [
      "The idea had been hatched over dinner with Danny \"Minnie\" O'Brien in Annagry. The airline was Malinair. By the summer of 1986 it was running ten rotations a day from six in the morning, the Islanders had been replaced by Dorniers, and Edinburgh and Manchester were on the timetable.",
      "By 1987 Malinair was bankrupt and Air Ecosse stepped in for a few weeks. The airline went under. The airport carried on.",
    ],
  },
  {
    year: "1988",
    range: "The Loganair years",
    title: "Loganair returns. Ryanair tries Luton.",
    lead:
      "In 1988 Loganair came back with a regular service to Glasgow and stayed for a decade. The runway was extended to 1,450 metres, and again in 1992–93 to 1,500 metres. In 1990 Ryanair launched a service to London Luton.",
    body: [
      "In the winter of 1994 a storm ran for weeks. The ferry to Tory Island couldn't sail. The Irish Air Corps moved their helicopters to Carrickfinn and ran supplies — bread, post, prescriptions, schoolchildren — out to the island until the sea calmed down. The pattern stuck: for decades after, the helicopter to Tory would route through CFN whenever the weather closed in on Magheroarty.",
    ],
  },
  {
    year: "1996",
    range: "The PSO years",
    title: "Dublin every day.",
    lead:
      "In August 1996 the Donegal–Dublin PSO was awarded for the first time, one of the very first PSO routes in Ireland.",
    body: [
      "Ireland Airways flew it, then Aer Arann from 1998, then Euroceltic, then Aer Arann again. By 2008 the airport was carrying 65,539 passengers — the all-time record.",
    ],
  },
  {
    year: "2001",
    range: "Helicopters out west",
    title: "The Atlantic margin runs on Donegal fuel.",
    lead:
      "For a stretch of about a decade Donegal was something else entirely: the closest paved runway with refuelling to the offshore oil and gas exploration in the Atlantic margin. Bristow Helicopters ran the shuttle.",
    body: [
      "Two basins drove the traffic. The Slyne-Erris Trough off Mayo, where the Corrib gas field had been discovered in 1996, and the deeper Rockall Trough where in 2002 Enterprise drilled the Dooish well — 125 kilometres northwest of Donegal, 1,478 metres of water under the rig. Both campaigns needed crews changed every couple of weeks and a fuel stop that wasn't four hundred miles away.",
    ],
  },
  {
    year: "2025",
    range: "Today",
    title: "Greener than Dublin.",
    lead:
      "In January 2025 Donegal became the first airport on the island of Ireland to reach Airport Carbon Accreditation Level 4 \"Transformation\" — ahead of Dublin, Cork and Shannon.",
    body: [
      "Solar on the hangar roof. MVHR through the terminal. LED everything. Four 22-kilowatt EV chargers in the car park. The road to a seventy-per-cent reduction in scope-1 and scope-2 emissions by 2030, and Net Zero by 2050.",
      "Emerald Airlines flies Dublin twice a day under the Aer Lingus Regional brand. Loganair is year-round to Glasgow. The airport carried 50,530 passengers in 2024, up twenty-one per cent.",
    ],
  },
];

const airlines = [
  { name: "Malinair", route: "Glasgow · Manchester · Edinburgh", years: "1985 – 1987" },
  { name: "Air Ecosse", route: "Glasgow", years: "1987" },
  { name: "Loganair", route: "Glasgow", years: "1988 – 1997" },
  { name: "Ryanair", route: "London Luton", years: "1990 – 1991" },
  { name: "Macair", route: "Edinburgh · Birmingham", years: "1995" },
  { name: "Gill Airways", route: "Glasgow Prestwick", years: "1996 · 1999" },
  { name: "Ireland Airways", route: "Dublin PSO", years: "1996 – 1998" },
  { name: "Bright Air", route: "Glasgow", years: "1997 – 1998" },
  { name: "Aer Arann", route: "Dublin · Cork · Glasgow Intl.", years: "1998 – 2012" },
  { name: "Euroceltic", route: "Dublin PSO", years: "2001 – 2003" },
  { name: "CityJet", route: "Rotterdam (seasonal charter)", years: "c. 2005 – 2012" },
  { name: "Loganair / Flybe", route: "Dublin", years: "2012 – 2015" },
  { name: "Stobart Air (Aer Lingus Regional)", route: "Dublin PSO", years: "2015 – 2021" },
  { name: "Amapola Flyg", route: "Dublin PSO (interim)", years: "2021 – 2022" },
  { name: "Emerald Airlines (Aer Lingus Regional)", route: "Dublin PSO · 2× daily", years: "2022 – today" },
  { name: "Loganair (relaunch)", route: "Glasgow · year-round", years: "2023 – today" },
] as const;
---

<BaseLayout title={title} description={description}>

  {/* ------------------------------------------------------------------ */}
  {/* HERO — text only, short                                             */}
  {/* ------------------------------------------------------------------ */}
  <section
    class="relative isolate flex min-h-[72vh] w-full items-end border-b border-line bg-surface-lo/40"
  >
    <div class="mx-auto w-full max-w-7xl px-6 pb-16 pt-40 sm:pb-24">
      <p
        data-animate="fade-up"
        class="font-mono text-[1.1rem] uppercase tracking-[0.22em] text-atlantic"
      >
        About · An scéal
      </p>
      <h1
        data-split
        data-split-delay="0.1"
        class="mt-8 max-w-5xl font-display text-[clamp(2.75rem,7vw,7.5rem)] font-light leading-[0.95] text-ink"
      >
        Forty years on the beach.
      </h1>
      <p
        data-animate="fade-up"
        data-animate-delay="0.35"
        class="mt-10 max-w-2xl text-base leading-relaxed text-mute sm:text-lg"
      >
        Six chapters · 1978 to 2025. The story of a runway built on a
        sandbar between the Atlantic and Errigal.
      </p>

      <div
        data-animate="fade-up"
        data-animate-delay="0.5"
        class="mt-12 flex items-center gap-3 text-mute"
        aria-hidden="true"
      >
        <span class="scroll-hint font-mono text-[0.65rem] uppercase tracking-[0.24em]">
          Scroll
        </span>
        <span class="scroll-hint text-base">↓</span>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ */}
  {/* STORY PATH — unified desktop + mobile layout                        */}
  {/*                                                                     */}
  {/* Desktop: SVG curved path draws as you scroll. Chapters alternate   */}
  {/* left / right of the path. animations.ts → setupStoryPath() wires  */}
  {/* the stroke-dashoffset animation.                                    */}
  {/*                                                                     */}
  {/* Mobile: single centred column, SVG hidden via CSS.                 */}
  {/* ------------------------------------------------------------------ */}
  <section data-story-section class="relative bg-surface">

    {/* SVG canvas — absolute, inset-0, sized to section by JS */}
    <svg
      data-story-svg
      class="pointer-events-none absolute inset-0 h-full w-full"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <defs>
        {/* Drop shadow for the aircraft */}
        <filter id="cfn-plane-shadow" x="-60%" y="-60%" width="220%" height="220%">
          <feDropShadow
            dx="2" dy="3" stdDeviation="3"
            flood-color="#11202d" flood-opacity="0.16"
          />
        </filter>
      </defs>

      {/* Faint guide track — always visible on desktop */}
      <path
        data-story-track
        fill="none"
        stroke="var(--color-sand)"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.12"
      />
      {/* Animated drawing path */}
      <path
        data-story-path
        fill="none"
        stroke="var(--color-sand)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.8"
      />

      {/*
        ATR 72-600 · Emerald Airlines · top-down view
        Nose points UP (−y). GSAP translates + rotates this group
        to sit at the leading tip of the drawing path.
        Scale: fuselage ≈ 62 SVG-px tall, wingspan ≈ 92 SVG-px.
        Drawing order: back-to-front so fuselage sits on top of wings.
      */}
      <g data-story-plane opacity="0" filter="url(#cfn-plane-shadow)">

        {/* Horizontal stabilizers — real ATR planform: swept leading edge + raked tips */}
        <path d="M-8,21 L-23,23.3 L-22.2,26.2 L-8,28 Z" fill="#D5D8D2"/>
        <path d="M8,21 L23,23.3 L22.2,26.2 L8,28 Z"   fill="#D5D8D2"/>

        {/* Teal tips on the stabilizers (Aer Lingus Regional accent) */}
        <path d="M-19,22.69 L-23,23.3 L-22.2,26.2 L-19,26.61 Z" fill="#119488"/>
        <path d="M19,22.69 L23,23.3 L22.2,26.2 L19,26.61 Z"    fill="#119488"/>

        {/* Elevator hinge line */}
        <path d="M-9,26.6 L-21.8,25.0 M9,26.6 L21.8,25.0"
              stroke="rgba(17,32,45,0.18)" stroke-width="0.4"/>

        {/* Wings — nearly rectangular, ATR 72 low-taper planform */}
        <path d="M-8,-9 L-46,-8 L-46,3 L-8,4 Z"  fill="#E3E7E0"/>
        <path d="M8,-9 L46,-8 L46,3 L8,4 Z"    fill="#E3E7E0"/>

        {/* Fuselage — drawn over wings so it occludes the root */}
        <path
          d="M0,-30 C5,-30 8,-25 8,-18 L8,20
             C8,26 5,31 0,31
             C-5,31 -8,26 -8,20 L-8,-18
             C-8,-25 -5,-30 0,-30 Z"
          fill="#F2EFE8"
          stroke="rgba(17,32,45,0.07)"
          stroke-width="0.5"
        />

        {/* Teal tail wrap — Aer Lingus Regional / Emerald livery */}
        <path d="M-8,17 C-8,24 -5,30 0,31 C5,30 8,24 8,17 L8,20
                 C8,26 5,31 0,31 C-5,31 -8,26 -8,20 Z" fill="#119488"/>

        {/* Lime shamrock on the tail */}
        <g transform="translate(0,24.5) scale(0.5)">
          <circle cx="0"    cy="-2.4" r="2.1" fill="#93C84B"/>
          <circle cx="-2.2" cy="0.6"  r="2.1" fill="#93C84B"/>
          <circle cx="2.2"  cy="0.6"  r="2.1" fill="#93C84B"/>
          <rect x="-0.5" y="0.5" width="1" height="3.2" fill="#93C84B"/>
        </g>

        {/* Engine nacelles — teal */}
        <ellipse cx="-29" cy="-3" rx="5"  ry="9"  fill="#119488"/>
        <ellipse cx="29"  cy="-3" rx="5"  ry="9"  fill="#119488"/>

        {/* Propeller discs — spinning = semi-transparent disc */}
        <ellipse cx="-29" cy="-14" rx="13" ry="2"
                 fill="rgba(10,10,10,0.36)"/>
        <ellipse cx="29"  cy="-14" rx="13" ry="2"
                 fill="rgba(10,10,10,0.36)"/>

        {/* Cockpit windows */}
        <ellipse cx="-2.8" cy="-26" rx="1.6" ry="1.1"
                 fill="rgba(40,70,120,0.35)"/>
        <ellipse cx="2.8"  cy="-26" rx="1.6" ry="1.1"
                 fill="rgba(40,70,120,0.35)"/>

      </g>
    </svg>

    {/* ---- INTRO ---- */}
    <div class="relative z-10 flex min-h-[28vh] items-center justify-center px-6 py-20">
      <div class="text-center">
        <p
          data-animate="fade-up"
          class="font-mono text-[0.95rem] uppercase tracking-[0.26em] text-atlantic"
        >
          The timeline
        </p>
        <h2
          data-split
          data-split-delay="0.05"
          class="mt-5 font-display text-[clamp(2.4rem,4.5vw,4.5rem)] font-light leading-[1]"
        >
          How a sandbar learned to fly.
        </h2>
        <p
          data-animate="fade-up"
          data-animate-delay="0.2"
          class="mx-auto mt-6 max-w-sm text-base leading-relaxed text-mute"
        >
          From a grass strip with no airline in 1978 to Ireland's
          greenest small airport in 2025.
        </p>
      </div>
    </div>

    {/* ---- CHAPTER PANELS ---- */}
    {
      chapters.map((c, i) => {
        const side = i % 2 === 0 ? "right" : "left";
        return (
          <div
            class="story-chapter relative flex min-h-[75vh] items-center py-16"
            data-story-chapter
            data-side={side}
          >
            {/*
              Waypoint marker — invisible 0×0 span used ONLY for path
              calculation. JS reads getBoundingClientRect() to find
              where to thread the SVG curve.
              Positioned at the inner edge of the content card:
                right chapters → left: 65% of section width
                left  chapters → left: 35% of section width
            */}
            <span
              class="story-waypoint"
              data-waypoint
              aria-hidden="true"
            />

            {/* Large year as architectural background — opposite side from card */}
            <span
              aria-hidden="true"
              class={`story-year-bg ${side === "right" ? "story-year-bg--l" : "story-year-bg--r"}`}
            >
              {c.year}
            </span>

            {/* Content card */}
            <div class="story-card relative z-10">
              <p class="font-mono text-[0.82rem] uppercase tracking-[0.24em] text-sand">
                {c.range}
                <span class="ml-3 text-atlantic">{c.year}</span>
              </p>

              <h2
                class="mt-5 font-display text-[clamp(2.25rem,3.8vw,4.25rem)] font-light leading-[1.02]"
              >
                {c.title}
              </h2>

              <p class="mt-6 text-[1rem] leading-[1.72] text-ink sm:text-[1.06rem]">
                {c.lead}
              </p>

              {c.body.map((para) => (
                <p class="mt-4 text-[0.95rem] leading-[1.72] text-mute">
                  {para}
                </p>
              ))}

              {/* Photo slot — drop image here once available */}
              {/* <figure class="story-photo mt-8 aspect-[4/3] overflow-hidden rounded-sm bg-surface-lo" data-photo>
                <img src="" alt="" class="h-full w-full object-cover" data-ken-burns />
              </figure> */}
            </div>
          </div>
        );
      })
    }

    {/* Gradient fade — no text, just a visual hint that the page continues */}
    <div
      class="pointer-events-none absolute bottom-0 left-0 right-0 z-20 h-36 bg-gradient-to-b from-transparent to-surface"
      aria-hidden="true"
    />

  </section>

  {/* ------------------------------------------------------------------ */}
  {/* AIRLINES TABLE                                                       */}
  {/* ------------------------------------------------------------------ */}
  <section class="border-t border-line bg-surface-lo/60">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.95rem] uppercase tracking-[0.26em] text-atlantic"
      >
        Operators
      </p>
      <h2
        data-split
        class="mt-3 max-w-3xl font-display text-[clamp(2.4rem,4.6vw,4.25rem)] font-light leading-[1.04]"
      >
        Every airline that has flown to Donegal.
      </h2>

      <dl data-animate="fade-up" class="mt-14 border-t border-line/60">
        {
          airlines.map((a) => (
            <div class="flex flex-wrap items-baseline gap-x-8 gap-y-1 border-b border-line/40 py-5">
              <dt class="basis-full font-display text-xl font-light leading-tight text-ink sm:basis-[36%] sm:text-2xl">
                {a.name}
              </dt>
              <dd class="flex-1 text-[0.95rem] leading-snug text-mute">
                {a.route}
              </dd>
              <dd class="shrink-0 text-sm tabular-nums tracking-wide text-atlantic">
                {a.years}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

</BaseLayout>
