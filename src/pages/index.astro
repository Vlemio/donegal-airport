<script is:inline define:vars={{ boardFlights: flightsToday }}>
(function () {
  // Registered on astro:page-load (not a bare top-level call) — otherwise
  // this only ever runs on the very first hard load of the home page, and
  // a client-side nav away and back shows the static "No more
  // departures/arrivals today" SSR fallback forever, never polling for
  // real data again.
  document.addEventListener('astro:page-load', init);

  function init() {
  if (!document.getElementById('hero-deps') && !document.getElementById('hero-arrs')) return;
  // Shared window-level key — see the clock script's comment for why a
  // closure-local timer var can't clear the other locale page's timer.
  if (window.__cfnPollTimer) clearInterval(window.__cfnPollTimer);

  // FIDS sends human-readable status strings (e.g. "On Approach"); this key
  // matches the .b-status tone classes below.
  function statusKey(s) { return String(s || '').toLowerCase().replace(/[^a-z]/g, ''); }

  // Same palette as the live information display (/flights): grey =
  // check-in, green = on time/landed/boarding, blue = departed, amber =
  // delayed/approach, red = cancelled/diverted/gate closed. One deliberate
  // difference from the info display here: "Scheduled" is green (not
  // grey) on this hero card.
  function toneFor(s) {
    var key = statusKey(s);
    if (key === 'checkin') return 'grey';
    if (key === 'departed') return 'info';
    if (key === 'onapproach' || key === 'finalcall' || key === 'delayed') return 'warn';
    if (key === 'gateclosed' || key === 'cancelled' || key === 'diverted') return 'bad';
    return 'ok';
  }

  // Seed from SSR so the hero panel is instant on first paint.
  // Subsequent updates come from polling /api/flights-today.json.
  var FLIGHTS = boardFlights;

  // ── Hero panel sync ──────────────────────────────────────────────
  // Same rule as render() above: createElement/textContent only, no
  // innerHTML, since every field is FIDS-feed data.
  function updateHero() {
    // Departures list — upcoming only (not departed), capped at 4
    var ul = document.getElementById('hero-deps');
    if (ul) {
      var deps = FLIGHTS.filter(function (f) { return f.type === 'departure' && f.status !== 'Departed'; }).slice(0, 4);
      ul.innerHTML = '';
      if (!deps.length) {
        var empty = document.createElement('li');
        empty.className = 'py-2 font-mono text-[11px] uppercase tracking-[0.1em]';
        empty.style.color = 'var(--hi-soft)';
        empty.textContent = 'No more departures today';
        ul.appendChild(empty);
      }
      deps.forEach(function (f) {
        var key = statusKey(f.status);
        var lbl = key === 'delayed' && f.estTime ? '→ ' + f.estTime : f.status;
        var tone = toneFor(f.status);
        var li = document.createElement('li');
        li.className = 'ops-board-row';
        var timeSpan = document.createElement('span'); timeSpan.className = 'b-time'; timeSpan.textContent = f.time;
        var destSpan = document.createElement('span'); destSpan.className = 'b-dest'; destSpan.textContent = f.city;
        var statusSpan = document.createElement('span'); statusSpan.className = 'b-status ' + tone; statusSpan.textContent = lbl;
        var flightSpan = document.createElement('span'); flightSpan.className = 'b-flight'; flightSpan.textContent = f.flightNo + ' · ' + (f.airline || '');
        li.appendChild(timeSpan); li.appendChild(destSpan); li.appendChild(statusSpan); li.appendChild(flightSpan);
        ul.appendChild(li);
      });
    }

    // Arrivals list — upcoming only (not landed), capped at 4. Same row
    // layout as departures above.
    var arrUl = document.getElementById('hero-arrs');
    if (arrUl) {
      var arrs = FLIGHTS.filter(function (f) { return f.type === 'arrival' && f.status !== 'Landed'; }).slice(0, 4);
      arrUl.innerHTML = '';
      if (!arrs.length) {
        var emptyArr = document.createElement('li');
        emptyArr.className = 'py-2 font-mono text-[11px] uppercase tracking-[0.1em]';
        emptyArr.style.color = 'var(--hi-soft)';
        emptyArr.textContent = 'No more arrivals today';
        arrUl.appendChild(emptyArr);
      }
      arrs.forEach(function (f) {
        var key = statusKey(f.status);
        var lbl = key === 'delayed' && f.estTime ? '→ ' + f.estTime : f.status;
        var tone = toneFor(f.status);
        var li = document.createElement('li');
        li.className = 'ops-board-row';
        var timeSpan = document.createElement('span'); timeSpan.className = 'b-time'; timeSpan.textContent = f.time;
        var destSpan = document.createElement('span'); destSpan.className = 'b-dest'; destSpan.textContent = f.city;
        var statusSpan = document.createElement('span'); statusSpan.className = 'b-status ' + tone; statusSpan.textContent = lbl;
        var flightSpan = document.createElement('span'); flightSpan.className = 'b-flight'; flightSpan.textContent = f.flightNo + ' · ' + (f.airline || '');
        li.appendChild(timeSpan); li.appendChild(destSpan); li.appendChild(statusSpan); li.appendChild(flightSpan);
        arrUl.appendChild(li);
      });
    }
  }

  // Poll /api/flights-today.json every 60 s.
  // When the FIDS pushes fresh data there, the hero panel updates silently.
  // Only ever apply genuinely live data (data.live === true) — the endpoint
  // falls back to sample placeholder flights when the FIDS hasn't synced,
  // and that must never be shown here as if it were real.
  function fetchFlights() {
    fetch('/api/flights-today.json?_=' + Date.now())
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.live === true && Array.isArray(data.flights)) {
          FLIGHTS = data.flights;
          updateHero();
        }
      })
      .catch(function () {});
  }
  window.__cfnPollTimer = setInterval(fetchFlights, 60000);

  updateHero();
  fetchFlights();
  }
})();
</script>

{/* Links a data-split headline to a paragraph below it: instead of the
    paragraph waiting for its OWN scroll position to cross the viewport
    (which needs extra scrolling since it sits lower on the page), it
    watches the headline and reveals itself the moment the headline's
    char-by-char animation finishes — no further scrolling required. */}
<script is:inline>
(function () {
  // bodySel may match one element (a paragraph) or several (e.g. a list of
  // award rows) — each gets hidden immediately and revealed once the
  // headline's char-by-char animation finishes, plus its own optional
  // data-reveal-delay (seconds) for a staggered look across the group.
  function linkedReveal(headSel, bodySel) {
    var head = document.querySelector('[data-split-link="' + headSel + '"]');
    var bodies = document.querySelectorAll('[data-reveal-after="' + bodySel + '"]');
    if (!head || !bodies.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    bodies.forEach(function (body) {
      // Hide instantly (no transition yet) — otherwise the browser treats
      // this initial hide itself as an animated change (fading FROM the
      // default visible state), which is a visible flash we don't want.
      body.style.transition = 'none';
      body.style.opacity = '0';
      body.style.transform = 'translateY(24px)';
      void body.offsetHeight; // force a reflow so the above is committed as a discrete state
      body.style.transition = 'opacity .8s ease, transform .8s cubic-bezier(.22,.61,.36,1)';
    });

    // Matches the stagger/duration setupSplitText() uses in animations.ts.
    // Each char eases with power3.out, which visually settles well before
    // its nominal duration ends — counting the full duration for the last
    // char reads as a noticeable extra pause, so only count a fraction of it.
    var STAGGER = 0.018, DURATION = 0.9, DURATION_VISUAL_FRACTION = 0.45;
    var chars = (head.textContent || '').replace(/\s+/g, '').length;
    var splitDelay = parseFloat(head.dataset.splitDelay || '0');
    var totalMs = (splitDelay + STAGGER * Math.max(0, chars - 1) + DURATION * DURATION_VISUAL_FRACTION) * 1000;

    var fired = false;
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (fired || !entry.isIntersecting) return;
        fired = true;
        bodies.forEach(function (body) {
          var extraMs = parseFloat(body.dataset.revealDelay || '0') * 1000;
          setTimeout(function () {
            body.style.opacity = '1';
            body.style.transform = 'none';
          }, totalMs + extraMs);
        });
        obs.disconnect();
      });
    }, { rootMargin: '0px 0px -15% 0px', threshold: 0.01 });
    obs.observe(head);
  }

  document.addEventListener('astro:page-load', function () {
    linkedReveal('hero-lead', 'hero-lead');
    linkedReveal('routes-head', 'routes-head');
    linkedReveal('awards-head', 'awards-head');
  });
})();
</script>

</BaseLayout>
