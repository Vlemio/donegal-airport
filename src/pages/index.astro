  <script is:inline>
    // Both registered on astro:page-load (not bare top-level calls) —
    // otherwise they only ever run on the very first hard load: the reveal
    // observer never re-attaches (cards can get stuck invisible) and the
    // carousel arrows never get their click handlers on a page reached by
    // a client-side nav rather than a full reload.
    document.addEventListener('astro:page-load', function () {
      document.documentElement.classList.add('js-ready');
      var deck = document.querySelector('.news-deck');
      if (!deck) return;
      var cards = Array.prototype.slice.call(deck.querySelectorAll('.nc.reveal'));
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            cards.forEach(function (card, i) {
              setTimeout(function () { card.classList.add('in'); }, i * 90);
            });
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      io.observe(deck);
    });

    // News deck carousel arrows
    document.addEventListener('astro:page-load', function () {
      var d = document.querySelector('.news-deck');
      var prev = document.getElementById('nc-prev');
      var next = document.getElementById('nc-next');
      if (!d || !prev || !next) return;
      function cw() { var c = d.querySelector('.nc'); return c ? c.getBoundingClientRect().width + 29 : 300; }
      function upd() {
        prev.disabled = d.scrollLeft <= 4;
        next.disabled = d.scrollLeft + d.clientWidth >= d.scrollWidth - 4;
      }
      prev.addEventListener('click', function () { d.scrollBy({ left: -cw(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { d.scrollBy({ left: cw(), behavior: 'smooth' }); });
      d.addEventListener('scroll', upd, { passive: true });
      upd();
    });
  </script>

