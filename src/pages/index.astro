---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";
import trim from "../data/video-trim.json";

const locale = "en";
const title = `${t("site.name", locale)} · ${t("site.tagline", locale)}`;
const description = t("site.description", locale);

// Live-flight placeholder (option A from discovery: "fake-live for
// pitch, swap for real data post-firma"). Status pill colours come
// from --color-status-* tokens.
const flightsToday = [
  { time: "08:25", flight: "EI 3680", to: "Dublin", dir: "DEP", status: "On time", tone: "ontime" },
  { time: "09:55", flight: "EI 3681", to: "from Dublin", dir: "ARR", status: "On time", tone: "ontime" },
  { time: "17:30", flight: "EI 3684", to: "Dublin", dir: "DEP", status: "On time", tone: "ontime" },
  { time: "19:00", flight: "EI 3685", to: "from Dublin", dir: "ARR", status: "On time", tone: "ontime" },
] as const;

// Hero ops-panel departures (next 3 from now — wire to FIDS post-firma)
const heroDepartures = [
  { time: "10:25", dest: "Dublin",  flight: "EI 3331 · Aer Lingus Regional", status: "On time", tone: "ok"   },
  { time: "14:50", dest: "Glasgow", flight: "LM 562 · Loganair",             status: "Sat only", tone: "wknd" },
  { time: "18:40", dest: "Dublin",  flight: "EI 3337 · Aer Lingus Regional", status: "On time", tone: "ok"   },
] as const;

// Hero weather (static placeholder — wire to Met Éireann or METAR post-firma)
const heroWeather = { tempC: 12, condition: "Scattered cloud", windDir: "SW", windKt: 14, visKm: 10 };

// Destinations — horizontal-scroll panels. Each panel is one viewport
// wide on desktop; on mobile they stack vertically.
const destinations = [
  {
    code: "DUB",
    city: "Dublin",
    country: "Ireland",
    duration: "55 min",
    schedule: "Daily · 2× return",
    carrier: "Aer Lingus Regional",
    hero: "/photos/dest-dub.webp",
    photoPos: "center center",
    caption: "An overnight bag and you're halfway to the city by lunch.",
  },
  {
    code: "GLA",
    city: "Glasgow",
    country: "Scotland",
    duration: "1 h 5 min",
    schedule: "Friday & Sunday",
    carrier: "Loganair",
    hero: "/photos/dest-gla.webp",
    photoPos: "center 20%",
    caption: "Weekend in the Highlands. Home before bedtime.",
  },
];

// Awards — editorial blocks, not cards. Big year, big claim, no
// bounded rectangles. Sourced from CFN press history (verify dates).
const awards = [
  {
    year: "2024",
    title: "First airport on the island of Ireland",
    detail: "to reach Airport Carbon Accreditation Level 4 'Transformation'.",
    source: "ACA · Airports Council International",
  },
  {
    year: "2018",
    title: "World's most stunning runway",
    detail: "Voted #1 by PrivateFly's global panel of pilots and travellers.",
    source: "PrivateFly",
  },
  {
    year: "2016",
    title: "Top-10 scenic landings",
    detail: "PrivateFly worldwide shortlist — Carrickfinn beach approach with Mt Errigal in frame.",
    source: "PrivateFly",
  },
];

// News — DD.MM.YYYY format throughout, Vágar style. Most-recent
// first. Move to a typed JSON in src/data/ when we get past 3-4.
const news = [
  {
    date: "08.05.2026",
    kind: "Operations",
    title: "Dublin route restored to twice-daily service.",
  },
  {
    date: "21.04.2026",
    kind: "Sustainability",
    title: "ACA Level 4 'Transformation' confirmed — a first for Ireland.",
  },
  {
    date: "03.03.2026",
    kind: "Community",
    title: "Scoil Gheimhridh winter school returns for a 17th year.",
  },
];
---

<BaseLayout title={title} description={description}>
  {/* Mark this page so the header starts transparent over the hero video
      and fades in with its glass background once the user scrolls past it. */}
  <script>
    document.documentElement.setAttribute('data-cinematic-hero', '');
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.removeAttribute('data-cinematic-hero');
    });
  </script>

  {/* ---------- HERO — "Live Ops" (Distribution A) ----------
      Two layers:
        1. sticky  — scroll-scrub video background (clouds → airport)
        2. absolute h-screen — hero content (scrolls away naturally)
      The ops panel on the right shows live time, weather, next deps.
      Wire heroDepartures + heroWeather to real feeds post-firma.    */}
  <section
    data-scrub-trigger
    data-hero-scroll
    class="relative isolate h-[300vh] w-full"
  >

    {/* ── Layer 1: sticky background ─────────────────────────────── */}
    <div class="sticky top-0 h-screen w-full overflow-hidden" aria-hidden="true">
      <img
        data-ken-burns
        src="/photos/hero-poster.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[center_55%]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      {/* Scrub "video" is a frame sequence painted to a <canvas>, not an
          <video>. Seeking an <video> via currentTime stutters on scroll
          deceleration (the decoder isn't built for random access); painting
          a pre-decoded WebP frame is instant and never stutters. Frames live
          in /public/video/frames/. data-video-start/-end (seconds, from the
          trim tool) map to frame indices via data-fps. Mobile keeps poster. */}
      <canvas
        data-scrub-canvas
        data-frames="121"
        data-fps="24"
        data-frame-path="/video/frames/frame-"
        data-scrub-start="top top"
        data-scrub-end="bottom bottom"
        data-video-start={String(trim.start)}
        data-video-end={String(trim.end)}
        class="absolute inset-0 hidden h-full w-full md:block"
      ></canvas>
      {/* Top scrim — protects nav + headline */}
      <div class="absolute inset-x-0 top-0 h-[220px] bg-gradient-to-b from-[rgba(18,22,29,0.60)] to-transparent" />
      {/* Left scrim — protects text column (matches design: 62% width) */}
      <div class="absolute inset-y-0 left-0 w-[65%] bg-gradient-to-r from-[rgba(18,22,29,0.52)] to-transparent" />
      {/* Bottom fade — grounds the image */}
      <div class="absolute inset-x-0 bottom-0 h-[160px] bg-gradient-to-t from-[rgba(18,22,29,0.45)] to-transparent" />
    </div>

    {/* ── Layer 2: hero content (scrolls with page) ──────────────── */}
    <div
      class="cfn-hero-content absolute left-0 top-0 z-10 flex h-screen w-full flex-col"
      style="padding: calc(var(--header-h) + 3rem) 3.5rem 2.5rem"
    >
      {/* Main row: lead + ops panel — vertically centred */}
      <div class="flex flex-1 items-center justify-between gap-[60px]">

        {/* ── Hero lead (left column) ── */}
        <div class="flex min-w-0 flex-1 flex-col gap-7">
          <p
            data-animate="fade-up"
            data-edit="hero-eyebrow"
            class="font-mono text-[13px] uppercase tracking-[0.26em]"
            style="color: var(--hi-soft)"
          >
            Donegal Airport · Co. Donegal · CFN
          </p>

          <h1
            data-split
            data-split-delay="0.15"
            data-edit="hero-h1"
            class="hero-display md:whitespace-nowrap"
          >
            Aerfort<br />Dhún na nGall
          </h1>

          <p
            data-animate="fade-up"
            data-animate-delay="0.35"
            data-edit="hero-lede"
            class="max-w-[440px] text-[21px] leading-[1.45]"
            style="color: var(--hi-soft)"
          >
            Dublin daily. Glasgow at weekends — and select summer weekdays.
            The Atlantic on both sides of the runway.
          </p>

          <div
            data-animate="fade-up"
            data-animate-delay="0.5"
            class="flex items-center gap-[34px]"
          >
            <a href="/flights" class="hero-cta hero-cta--primary" data-edit="cta-primary">
              Today's flights <span class="arrow">→</span>
            </a>
            <a href="/plan#parking" class="hero-cta" data-edit="cta-secondary">
              Parking &amp; getting here <span class="arrow">→</span>
            </a>
          </div>
        </div>

        {/* ── Live Ops Panel (right column, desktop only) ── */}
        <aside class="ops-panel hidden lg:flex lg:flex-col">

          {/* Header row: title + live clock (local + UTC) */}
          <div class="flex items-start justify-between">
            <span
              class="font-mono text-[12px] uppercase tracking-[0.18em]"
              style="color: var(--hi-amber)"
            >
              Inniu · Today
            </span>
            <div class="flex flex-col items-end gap-[3px]">
              <span
                id="ops-clock"
                class="font-mono text-[11px] tracking-[0.08em]"
                style="color: var(--hi-faint)"
              >
                — — : — —
              </span>
              <span
                id="ops-clock-utc"
                class="font-mono text-[10px] tracking-[0.06em]"
                style="color: var(--hi-faint); opacity: 0.7"
              >
                — — : — — <span style="opacity:0.6">UTC</span>
              </span>
            </div>
          </div>

          {/* Weather row — updated every 10 min from Open-Meteo (CFN coords) */}
          <div
            class="mt-[14px] pb-[18px]"
            style="border-bottom: 1px solid var(--hi-line)"
          >
            {/* Line 1 — temperature + condition (big) */}
            <div class="flex items-baseline gap-[10px]">
              <span id="wx-temp" class="ops-temp">{heroWeather.tempC}°C</span>
              <span
                id="wx-cond"
                class="font-mono text-[17px] leading-none"
                style="color: var(--hi)"
              >{heroWeather.condition}</span>
            </div>
            {/* Line 2 — wind + visibility (smaller detail) */}
            <div
              class="mt-[7px] flex items-baseline gap-[8px] font-mono text-[13px] tracking-[0.04em]"
              style="color: var(--hi-soft)"
            >
              <span id="wx-wind">{heroWeather.windDir} {heroWeather.windKt} kt</span>
              <span style="color: var(--hi-faint)">·</span>
              <span id="wx-vis" class="text-[13px]">Vis {heroWeather.visKm} km</span>
            </div>
          </div>

          {/* Section label: "Next departures" + Live chip */}
          <div
            class="mt-[18px] flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.16em]"
            style="color: var(--hi-soft)"
          >
            <span>Next departures · Imeachtaí</span>
            <span
              class="flex items-center gap-[7px] text-[11px] uppercase tracking-[0.12em]"
              style="color: var(--hi-green)"
            >
              <span class="live-dot ops-badge"></span>Live
            </span>
          </div>

          {/* Departures board */}
          <ul class="mt-[6px]">
            {heroDepartures.map((dep) => (
              <li class="ops-board-row">
                <span class="b-time">{dep.time}</span>
                <span class="b-dest">{dep.dest}</span>
                <span class={`b-status ${dep.tone}`}>{dep.status}</span>
                <span class="b-flight">{dep.flight}</span>
              </li>
            ))}
          </ul>

          {/* Footer row: next arrival + full board link */}
          <div
            class="mt-[16px] flex items-center justify-between pt-[16px]"
            style="border-top: 1px solid var(--hi-line)"
          >
            <span
              class="font-mono text-[10.5px] uppercase tracking-[0.06em]"
              style="color: var(--hi-faint)"
            >
              Next arrival · 09:55 Dublin ·{" "}
              <span style="color: var(--hi-soft)">Landed</span>
            </span>
            <a href="/flights" class="ops-cta-link">
              Full board <span class="arrow">→</span>
            </a>
          </div>
        </aside>
      </div>

      {/* Scroll hint — bottom left */}
      <div
        class="flex items-center gap-[10px] font-mono text-[12px] uppercase tracking-[0.22em]"
        style="color: var(--hi-faint)"
        aria-hidden="true"
      >
        Scroll to reveal <span class="hero-bob">↓</span>
      </div>
    </div>

    {/* Live clock script — ticks every minute, shows local + UTC */}
    <script>
      (function () {
        const el    = document.getElementById('ops-clock');
        const utcEl = document.getElementById('ops-clock-utc');
        if (!el) return;
        const days   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        function tick() {
          const d  = new Date();
          const hh = String(d.getHours()).padStart(2,'0');
          const mm = String(d.getMinutes()).padStart(2,'0');
          el.textContent =
            days[d.getDay()] + ' ' + d.getDate() + ' ' +
            months[d.getMonth()] + ' · ' + hh + ':' + mm;
          if (utcEl) {
            const uh = String(d.getUTCHours()).padStart(2,'0');
            const um = String(d.getUTCMinutes()).padStart(2,'0');
            utcEl.innerHTML = uh + ':' + um + ' <span style="opacity:0.6">UTC</span>';
          }
        }
        tick();
        setInterval(tick, 60_000);
      })();
    </script>

    {/* Live weather — Open-Meteo, same source as Bunbeg Coast Guard dashboard.
        Coordinates: Carrickfinn Airport (CFN/EIDL) 55.0441°N, 8.3411°W.
        Refreshes every 10 min. Falls back silently to static values on error. */}
    <script>
      (function () {
        // WMO weather code → short description (matches coast guard mapping)
        const WMO = {
          0:'Clear sky', 1:'Mainly clear', 2:'Partly cloudy', 3:'Overcast',
          45:'Fog', 48:'Icy fog',
          51:'Light drizzle', 53:'Drizzle', 55:'Heavy drizzle',
          61:'Light rain', 63:'Rain', 65:'Heavy rain',
          71:'Light snow', 73:'Snow', 75:'Heavy snow',
          77:'Snow grains',
          80:'Rain showers', 81:'Heavy showers', 82:'Violent showers',
          85:'Snow showers', 86:'Heavy snow showers',
          95:'Thunderstorm', 96:'Storm & hail', 99:'Storm & heavy hail',
        };
        // 8-point compass rose — readable for general public (vs 16-point WSW/NNE)
        const DIRS = ['N','NE','E','SE','S','SW','W','NW'];
        const compassDir = (deg) => DIRS[Math.round(deg / 45) % 8];

        // Open-Meteo endpoint — free, no auth, CORS open
        const URL =
          'https://api.open-meteo.com/v1/forecast' +
          '?latitude=55.0441&longitude=-8.3411' +
          '&current=temperature_2m,weather_code,' +
          'wind_speed_10m,wind_direction_10m,visibility' +
          '&timezone=Europe%2FDublin';

        function apply(data) {
          const c = data.current;
          const tempEl = document.getElementById('wx-temp');
          const condEl = document.getElementById('wx-cond');
          const windEl = document.getElementById('wx-wind');
          const visEl  = document.getElementById('wx-vis');
          if (!tempEl) return;

          tempEl.textContent = Math.round(c.temperature_2m) + '°C';
          condEl.textContent = WMO[c.weather_code] ?? 'Variable';

          // km/h → knots (÷ 1.852)
          const kt  = Math.round(c.wind_speed_10m / 1.852);
          windEl.textContent = compassDir(c.wind_direction_10m) + ' ' + kt + ' kt';

          // metres → km, cap display at "10 km"
          const visMetre = c.visibility ?? 10000;
          visEl.textContent = 'Vis ' +
            (visMetre >= 10000 ? '10 km' : (visMetre / 1000).toFixed(1) + ' km');
        }

        function fetchWx() {
          fetch(URL)
            .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(apply)
            .catch(() => { /* keep static fallback silently */ });
        }

        fetchWx();
        setInterval(fetchWx, 10 * 60 * 1000); // refresh every 10 min
      })();
    </script>
  </section>

  {/* ---------- EDITORIAL INTRO ----------
      The "Carrickfinn is a place" paragraph. Heavy display weight,
      photo to the right on desktop, stacked on mobile. */}
  <section class="border-t border-line">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-28 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p
          data-animate="fade-up"
          class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic"
        >
          Carraig Fhinn · Co. Donegal
        </p>
        <p
          data-split
          class="mt-8 max-w-3xl font-display text-[clamp(2rem,4vw,3.6rem)] font-normal leading-[1.02] text-ink"
        >
          We are the smallest international airport in the country, and the
          one with the best view.
        </p>
        <div
          data-animate="fade-up"
          data-animate-delay="0.25"
          class="mt-8 max-w-xl text-base leading-relaxed text-mute"
        >
          <p>
            Carrickfinn sits on a sandbar between the Atlantic and Mount
            Errigal. The runway runs straight along the beach. Pilots queue
            for a slot here just to log the approach. Passengers walk to
            arrivals in under a minute.
          </p>
          <p class="mt-5">
            <a
              href="/story"
              class="border-b border-ink/40 pb-0.5 transition-colors hover:border-sand hover:text-sand"
            >
              The full story — Malinair to today →
            </a>
          </p>
        </div>
      </div>

      <figure
        data-photo
        class="relative lg:col-span-5"
      >
        <div
          data-ken-burns
          data-ken-burns-duration="22"
          class="aspect-[3/4] w-full rounded-none bg-gradient-to-br from-sand via-atlantic-bright to-ink"
          aria-hidden="true"
        >
        </div>
        <figcaption
          class="mt-4 font-mono text-[0.66rem] uppercase tracking-[0.22em] text-mute"
        >
          Photograph · Carrickfinn beach approach
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ---------- TODAY'S FLIGHTS — minimal mono table ---------- */}
  <section class="border-t border-line bg-surface-lo/60">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p
            data-animate="fade-up"
            class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic"
          >
            Today
          </p>
          <h2
            data-split
            class="mt-3 font-display text-[clamp(2rem,4vw,3.4rem)] font-normal leading-[1.04]"
          >
            Live arrivals and departures.
          </h2>
        </div>
        <p class="hidden font-mono text-[0.66rem] uppercase tracking-[0.22em] text-mute sm:block">
          Last updated · placeholder
        </p>
      </div>

      <div data-animate="fade-up" class="mt-10">
        <ul class="divide-y divide-line font-mono text-sm">
          <li
            class="grid grid-cols-[5rem_5.5rem_1fr_4rem_auto] items-center gap-6 py-2 text-[0.66rem] uppercase tracking-[0.18em] text-mute"
          >
            <span>Time</span><span>Flight</span><span>Route</span>
            <span>Dir</span><span class="justify-self-end">Status</span>
          </li>
          {flightsToday.map((f) => (
            <li
              class="grid grid-cols-[5rem_5.5rem_1fr_4rem_auto] items-center gap-6 py-4 text-ink"
            >
              <span class="tabular-nums font-medium">{f.time}</span>
              <span class="tabular-nums">{f.flight}</span>
              <span class="truncate text-mute">{f.to}</span>
              <span class="text-[0.66rem] uppercase tracking-[0.18em] text-mute">
                {f.dir}
              </span>
              <span
                class="justify-self-end text-[0.66rem] uppercase tracking-[0.18em]"
                style={`color: var(--color-status-${f.tone})`}
              >
                {f.status}
              </span>
            </li>
          ))}
        </ul>

        <a
          href="/flights"
          class="mt-10 inline-block border-b border-ink/60 pb-1 font-mono text-xs uppercase tracking-[0.22em] text-ink transition-colors hover:border-sand hover:text-sand"
        >
          Full timetable & live status →
        </a>
      </div>
    </div>
  </section>

  {/* ---------- DESTINATIONS — sticky horizontal scroll ----------
      On desktop, the section pins for ~2 viewports of scroll while
      the inner track translates left through the destination panels.
      On smaller screens, the panels stack vertically and the wrapper
      attributes are ignored by animations.ts. */}
  <section
    data-horizontal
    class="h-wrapper relative hidden lg:block"
    style={`height: ${100 + destinations.length * 100}vh;`}
  >
    <div class="h-pin">
      <div class="h-track">
        <div
          class="flex h-[80vh] w-[28rem] shrink-0 flex-col justify-between px-2 py-10"
        >
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic">
            Routes
          </p>
          <h2
            data-split
            class="font-display text-[clamp(2rem,4vw,4rem)] font-normal leading-[0.98]"
          >
            Two flights, two cities.<br />Both arrive in time for dinner.
          </h2>
          <p class="max-w-xs text-sm leading-relaxed text-mute">
            CFN's whole route map fits in one breath. That's the point.
          </p>
        </div>

        {destinations.map((d) => (
          <article
            data-photo
            class="relative flex h-[80vh] w-[44rem] shrink-0 flex-col justify-end overflow-hidden"
          >
            <img
              src={d.hero}
              alt={d.city}
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position: ${d.photoPos}`}
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"
              aria-hidden="true"
            >
            </div>
            <div class="cfn-hero-content relative z-10 p-10">
              <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-sand">
                {d.code} · {d.country}
              </p>
              <h3 class="mt-3 font-display text-[clamp(2.5rem,5vw,5rem)] font-normal leading-[0.95] text-ink">
                {d.city}
              </h3>
              <p class="mt-4 max-w-md text-base text-mute">{d.caption}</p>
              <dl class="mt-8 grid grid-cols-3 gap-6 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-mute">
                <div>
                  <dt class="text-sand">Duration</dt>
                  <dd class="mt-1 text-ink">{d.duration}</dd>
                </div>
                <div>
                  <dt class="text-sand">Schedule</dt>
                  <dd class="mt-1 text-ink">{d.schedule}</dd>
                </div>
                <div>
                  <dt class="text-sand">Carrier</dt>
                  <dd class="mt-1 text-ink">{d.carrier}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Mobile fallback for destinations — stacked, full-width photos */}
  <section class="border-t border-line lg:hidden">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic"
      >
        Routes
      </p>
      <h2
        data-animate="fade-up"
        data-animate-delay="0.1"
        class="mt-3 font-display text-4xl leading-[1.02]"
      >
        Two flights, two cities.
      </h2>
      <div class="mt-10 space-y-12">
        {destinations.map((d, i) => (
          <article
            data-animate="fade-up"
            data-animate-delay={`${0.05 + i * 0.08}`}
            class="relative overflow-hidden"
          >
            <div class="relative aspect-[4/5] w-full overflow-hidden">
              <img
                src={d.hero}
                alt={d.city}
                class="absolute inset-0 h-full w-full object-cover"
                style={`object-position: ${d.photoPos}`}
                loading="lazy"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink/85 to-transparent"
                aria-hidden="true"
              >
              </div>
              <div class="cfn-hero-content absolute inset-x-0 bottom-0 p-6">
                <p class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-sand">
                  {d.code} · {d.country}
                </p>
                <h3 class="mt-2 font-display text-4xl leading-[0.95] text-ink">
                  {d.city}
                </h3>
                <p class="mt-3 text-sm text-mute">{d.caption}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- AWARDS — editorial, no cards ---------- */}
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-28">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic"
      >
        Recognition
      </p>
      <h2
        data-split
        class="mt-3 max-w-4xl font-display text-[clamp(2.25rem,5vw,5rem)] font-normal leading-[0.98]"
      >
        A small airport with a long shelf of awards.
      </h2>

      <ul class="mt-16 divide-y divide-line">
        {awards.map((award, i) => (
          <li
            data-animate="fade-up"
            data-animate-delay={`${0.05 + i * 0.06}`}
            class="grid items-baseline gap-6 py-10 md:grid-cols-[7rem_1fr_auto] md:gap-12"
          >
            <p class="font-display text-5xl text-sand md:text-6xl">{award.year}</p>
            <div>
              <h3 class="font-display text-2xl leading-tight text-ink md:text-3xl">
                {award.title}
              </h3>
              <p class="mt-2 text-base leading-relaxed text-mute">
                {award.detail}
              </p>
            </div>
            <p
              class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-mute md:text-right"
            >
              {award.source}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---------- NEWS — DD.MM.YYYY editorial list ---------- */}
  <section class="border-t border-line bg-surface-lo/60">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p
            data-animate="fade-up"
            class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic"
          >
            Recent
          </p>
          <h2
            data-animate="fade-up"
            data-animate-delay="0.1"
            class="mt-3 font-display text-[clamp(2rem,4vw,3.4rem)] font-normal leading-[1.04]"
          >
            From the airport.
          </h2>
        </div>
        <a
          href="/story#news"
          class="hidden border-b border-ink/60 pb-1 font-mono text-xs uppercase tracking-[0.22em] text-ink transition-colors hover:border-sand hover:text-sand sm:inline-block"
        >
          All news →
        </a>
      </div>

      <ul class="mt-10 divide-y divide-line">
        {news.map((item, i) => (
          <li
            data-animate="fade-up"
            data-animate-delay={`${0.05 + i * 0.05}`}
          >
            <a
              href="/story#news"
              class="group grid items-baseline gap-4 py-8 transition-colors md:grid-cols-[7rem_8rem_1fr_2rem]"
            >
              <p class="font-mono text-[0.78rem] tabular-nums text-mute">
                {item.date}
              </p>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-sand">
                {item.kind}
              </p>
              <p class="font-display text-xl leading-snug text-ink md:text-2xl">
                {item.title}
              </p>
              <span
                class="hidden font-mono text-xs text-mute transition-transform group-hover:translate-x-1 md:block md:text-right"
              >
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---------- INQUIRY CTA — clean editorial closer ---------- */}
  <section class="border-t border-line">
    <div class="mx-auto max-w-5xl px-6 py-32 text-center">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic"
      >
        Plan your visit
      </p>
      <h2
        data-split
        class="mt-4 font-display text-[clamp(2.25rem,5.5vw,5.5rem)] font-normal leading-[0.98]"
      >
        Fly in. Drive ten minutes.<br />You're on the Wild Atlantic Way.
      </h2>
      <div
        data-animate="fade-up"
        data-animate-delay="0.35"
        class="mt-12 flex flex-wrap justify-center gap-6"
      >
        <a
          href="/discover"
          class="border-b border-ink/60 pb-1 font-mono text-xs uppercase tracking-[0.22em] text-ink transition-colors hover:border-sand hover:text-sand"
        >
          Discover Donegal →
        </a>
        <a
          href="/contact"
          class="border-b border-transparent pb-1 font-mono text-xs uppercase tracking-[0.22em] text-mute transition-colors hover:border-sand hover:text-sand"
        >
          Talk to us →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
