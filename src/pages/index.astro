  .board-foot { margin-top:2.6rem; display:flex; justify-content:space-between; align-items:center; gap:1.5rem; flex-wrap:wrap; }
  .board-legend { display:flex; gap:1.3rem; flex-wrap:wrap; font-family:var(--font-mono); font-size:0.62rem; letter-spacing:0.1em; text-transform:uppercase; color:rgba(233,241,248,0.55); }
  .board-legend .lg { display:flex; align-items:center; gap:0.45rem; }
  .board-legend .sw { width:9px; height:9px; border-radius:50%; flex:none; }
  .board-link { font-family:var(--font-mono); font-size:0.74rem; letter-spacing:0.16em; text-transform:uppercase; text-decoration:none; display:inline-flex; align-items:center; gap:0.6rem; padding-bottom:0.3rem; border-bottom:1px solid currentColor; transition:gap .25s; color:#eef4fb; }
  .board-link:hover { gap:1rem; }
  .board-arrow { transition:transform .25s; display:inline-block; }
  .board-link:hover .board-arrow { transform:translateX(4px); }
  @media (max-width:720px) {
    .board-cols,.fb-row { grid-template-columns:4.4rem 1fr 8rem; }
    .board-cols .c-flight,.board-cols .c-dir,.fb-flight,.fb-dir { display:none; }
  }
  @media (prefers-reduced-motion:reduce) {
    .fb-row { opacity:1 !important; transform:none !important; transition:none !important; }
    .live-dot-green,.fb-status.is-live .st-dot { animation:none !important; }
  }
</style>

<script is:inline define:vars={{ boardFlights: flightsToday }}>
(function () {
  var STATUS = {
    scheduled:{ label:'Scheduled', live:false },
    ontime:   { label:'On time',   live:false },
    boarding: { label:'Boarding',  live:true  },
    enroute:  { label:'En route',  live:true  },
    landed:   { label:'Landed',    live:false },
    departed: { label:'Departed',  live:false },
    delayed:  { label:'Delayed',   live:true  }
  };

  // Seed from SSR so the board is instant on first paint.
  // Subsequent updates come from polling /api/flights-today.json.
  var FLIGHTS = boardFlights;
  var activeFilter = 'ALL';

  var GLYPHS = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  function scramble(el, final, delay) {
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) { el.textContent = final; return; }
    var locked = 0, frames = 0;
    el.textContent = final.replace(/[^\s]/g, ' ');
    setTimeout(function () {
      var iv = setInterval(function () {
        frames++;
        if (frames % 2 === 0) locked = Math.min(final.length, locked + 1);
        var out = '';
        for (var i = 0; i < final.length; i++) {
          var c = final[i];
          out += (i < locked || c === ' ' || c === ':') ? c : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        }
        el.textContent = out;
        if (locked >= final.length) { clearInterval(iv); el.textContent = final; }
      }, 45);
    }, delay);
  }

  function render(filter, animate) {
    activeFilter = filter;
    var wrap = document.getElementById('board-rows');
    if (!wrap) return;
    wrap.innerHTML = '';
    FLIGHTS.filter(function (f) { return filter === 'ALL' || f.dir === filter; })
      .forEach(function (f, i) {
        var s = STATUS[f.st] || { label: f.st, live: false };
        var arrow = f.dir === 'DEP' ? '↗' : '↘';
        var stHtml = (f.st === 'delayed' && f.delayTo)
          ? '<span class="st-strike">' + f.t + '</span> ' + f.delayTo
          : s.label;
        var row = document.createElement('div');
        row.className = 'fb-row';
        row.innerHTML =
          '<div class="fb-time"><span class="flap-chip">' + f.t + '</span></div>' +
          '<div class="fb-flight"><span class="flap-chip">' + f.f + '</span></div>' +
          '<div class="fb-route"><span class="fb-city">' + f.city + '</span></div>' +
          '<div class="fb-dir ' + (f.dir === 'DEP' ? 'dep' : 'arr') + '"><span>' + arrow + '</span>' + f.dir + '</div>' +
          '<div class="fb-status' + (s.live ? ' is-live' : '') + '" data-st="' + f.st + '"><span class="st-dot"></span>' + stHtml + '</div>';
        wrap.appendChild(row);
        if (animate !== false) {
          setTimeout(function () { row.classList.add('in'); }, 60 + i * 70);
          scramble(row.querySelector('.fb-time .flap-chip'), f.t, 120 + i * 70);
          scramble(row.querySelector('.fb-flight .flap-chip'), f.f, 200 + i * 70);
        } else {
          row.classList.add('in');
        }
      });
  }

  // ── Hero panel sync ──────────────────────────────────────────────
  var CARRIER = { EI: 'Aer Lingus Regional', LM: 'Loganair' };

  function updateHero() {
    // Departures list — upcoming only (not departed)
    var ul = document.getElementById('hero-deps');
    if (ul) {
      var deps = FLIGHTS.filter(function (f) { return f.dir === 'DEP' && f.st !== 'departed'; }).slice(0, 3);
      ul.innerHTML = deps.map(function (f) {
        var carrier = CARRIER[f.f.split(' ')[0]] || '';
        var lbl = f.st === 'delayed' && f.delayTo ? '→ ' + f.delayTo
                : f.st === 'ontime'   ? 'On time'
                : f.st === 'boarding' ? 'Boarding'
                : 'Scheduled';
        var tone = f.st === 'delayed' ? 'warn' : 'ok';
        return '<li class="ops-board-row">' +
          '<span class="b-time">' + f.t + '</span>' +
          '<span class="b-dest">' + f.city + '</span>' +
          '<span class="b-status ' + tone + '">' + lbl + '</span>' +
          '<span class="b-flight">' + f.f + ' · ' + carrier + '</span>' +
          '</li>';
      }).join('');
    }

    // Next arrival footer
    var arrEl = document.getElementById('hero-next-arr');
    if (arrEl) {
      var arr = FLIGHTS.find(function (f) { return f.dir === 'ARR' && f.st !== 'landed'; });
      if (arr) {
        var stLbl = arr.st === 'landed' ? 'Landed' : arr.st === 'enroute' ? 'En route' : 'Scheduled';
        arrEl.innerHTML = 'Next arrival · ' + arr.t + ' ' + arr.city +
          ' · <span style="color:var(--hi-soft)">' + stLbl + '</span>';
      } else {
        arrEl.textContent = 'No more arrivals today';
      }
    }
  }

  // Poll /api/flights-today.json every 60 s.
  // When the FIDS tab writes fresh data there, board + hero both update silently.
  function fetchFlights() {
    fetch('/api/flights-today.json?_=' + Date.now())
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && Array.isArray(data.flights)) {
          FLIGHTS = data.flights;
          render(activeFilter, false);
          updateHero();
        }
      })
      .catch(function () {});
  }
  setInterval(fetchFlights, 60000);

  function tick() {
    var el = document.getElementById('board-clock');
    if (!el) return;
    el.textContent = new Date().toLocaleTimeString('en-IE', {
      timeZone: 'Europe/Dublin', hour12: false,
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  tick(); setInterval(tick, 1000);

  var tabsEl = document.getElementById('board-tabs');
  if (tabsEl) {
    var btns = Array.prototype.slice.call(tabsEl.querySelectorAll('button'));
    var pill = tabsEl.querySelector('.board-tab-pill');
    function movePill(btn) {
      if (!pill || !btn) return;
      pill.style.width = btn.offsetWidth + 'px';
      pill.style.transform = 'translateX(' + (btn.offsetLeft - 4) + 'px)';
    }
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.setAttribute('aria-selected', b === btn ? 'true' : 'false'); });
        movePill(btn);
        render(btn.getAttribute('data-f'), true);
      });
    });
    movePill(btns[0]);
    window.addEventListener('resize', function () {
      var a = tabsEl.querySelector('[aria-selected="true"]'); if (a) movePill(a);
    });
    if (document.fonts) document.fonts.ready.then(function () {
      var a = tabsEl.querySelector('[aria-selected="true"]'); if (a) movePill(a);
    });
  }

  render('ALL', true);
  updateHero();
})();
</script>

</BaseLayout>
