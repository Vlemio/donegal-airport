---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";
import trim from "../data/video-trim.json";
import { getCollection } from "astro:content";
import flightsFeed from "../../public/api/flights-today.json";
export const prerender = true;

const locale = "en";
const title = `${t("site.name", locale)} · ${t("site.tagline", locale)}`;
const description = t("site.description", locale);

// Flight data — single source of truth is /public/api/flights-today.json.
// The FIDS tab (separate project) will write to that file with live ADS-B data.
// The board JS polls it every 60 s so it auto-refreshes without a page reload.
const flightsToday = (flightsFeed as any).flights as {
  t: string; f: string; city: string; dir: string; st: string; delayTo?: string;
}[];

// Hero ops-panel — derived from flightsToday so both are always in sync
const carrierMap: Record<string, string> = { EI: "Aer Lingus Regional", LM: "Loganair" };
const heroDepartures = flightsToday
  .filter((f) => f.dir === "DEP" && f.st !== "departed")
  .slice(0, 3)
  .map((f) => ({
    time: f.t,
    dest: f.city,
    flight: `${f.f} · ${carrierMap[f.f.split(" ")[0]] ?? ""}`,
    status:
      f.st === "delayed" && (f as any).delayTo ? `→ ${(f as any).delayTo}` :
      f.st === "ontime" ? "On time" :
      f.st === "boarding" ? "Boarding" : "Scheduled",
    tone: f.st === "delayed" ? "warn" : "ok",
  }));
const nextArrival = flightsToday.find((f) => f.dir === "ARR" && f.st !== "landed") ?? null;

// Hero weather (static placeholder — wire to Met Éireann or METAR post-firma)
const heroWeather = { tempC: 12, condition: "Scattered cloud", windDir: "SW", windKt: 14, visKm: 10 };

// Destinations — horizontal-scroll panels. Each panel is one viewport
// wide on desktop; on mobile they stack vertically.
const destinations = [
  {
    code: "DUB",
    city: "Dublin",
    country: "Ireland",
    duration: "55 min",
    schedule: "Daily · 2× return",
    carrier: "Aer Lingus Regional",
    hero: "/photos/dest-dub.webp",
    photoPos: "center center",
    caption: "An overnight bag and you're halfway to the city by lunch.",
  },
  {
    code: "GLA",
    city: "Glasgow",
    country: "Scotland",
    duration: "1 h 5 min",
    schedule: "Year-round",
    carrier: "Loganair",
    hero: "/photos/dest-gla.webp",
    photoPos: "center 20%",
    caption: "Weekend in the Highlands. Home before bedtime.",
  },
];

// Awards — editorial blocks, not cards. Big year, big claim, no
// bounded rectangles. Sourced from CFN press history (verify dates).
const awards = [
  {
    year: "2024",
    title: "First airport on the island of Ireland",
    detail: "to reach Airport Carbon Accreditation Level 4 'Transformation'.",
    source: "ACA · Airports Council International",
  },
  {
    year: "2018",
    title: "World's most stunning runway",
    detail: "Voted #1 by PrivateFly's global panel of pilots and travellers.",
    source: "PrivateFly",
  },
  {
    year: "2016",
    title: "Top-10 scenic landings",
    detail: "PrivateFly worldwide shortlist — Carrickfinn beach approach with Mt Errigal in frame.",
    source: "PrivateFly",
  },
];

// News — read from src/content/news/ (managed via Keystatic CMS).
// Marketing adds items at /keystatic — no code needed.
const newsEntries = await getCollection("news");
const _newsSorted = newsEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const _mapNews = (n: (typeof _newsSorted)[0]) => ({
  slug: n.id,
  date: n.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }),
  kind: n.data.kind,
  title: n.data.title,
  image: n.data.image
    ? n.data.image.startsWith("/") ? n.data.image : `/photos/${n.data.image}`
    : "/photos/intro-airport.webp",
});
const news = _newsSorted.slice(0, 3).map(_mapNews);
const allNews = _newsSorted.map(_mapNews);
---

<BaseLayout title={title} description={description}>
  {/* Mark this page so the header starts transparent over the hero video
      and fades in with its glass background once the user scrolls past it. */}
  <script>
    document.documentElement.setAttribute('data-cinematic-hero', '');
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.removeAttribute('data-cinematic-hero');
    });
  </script>

  {/* ---------- HERO — "Live Ops" (Distribution A) ----------
      Two layers:
        1. sticky  — scroll-scrub video background (clouds → airport)
        2. absolute h-screen — hero content (scrolls away naturally)
      The ops panel on the right shows live time, weather, next deps.
      Wire heroDepartures + heroWeather to real feeds post-firma.    */}
  <section
    data-scrub-trigger
    data-hero-scroll
    class="relative isolate h-[300vh] w-full"
  >

    {/* ── Layer 1: sticky background ─────────────────────────────── */}
    <div class="sticky top-0 h-screen w-full overflow-hidden" aria-hidden="true">
      <img
        data-ken-burns
        src="/video/frames/frame-0001.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[center_55%]"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      {/* Scrub "video" is a frame sequence painted to a <canvas>, not an
          <video>. Seeking an <video> via currentTime stutters on scroll
          deceleration (the decoder isn't built for random access); painting
          a pre-decoded WebP frame is instant and never stutters. Frames live
          in /public/video/frames/. data-video-start/-end (seconds, from the
          trim tool) map to frame indices via data-fps. Mobile keeps poster. */}
      <canvas
        data-scrub-canvas
        data-frames="121"
        data-fps="24"
        data-frame-path="/video/frames/frame-"
        data-scrub-start="top top"
        data-scrub-end="bottom bottom"
        data-video-start={String(trim.start)}
        data-video-end={String(trim.end)}
        class="absolute inset-0 hidden h-full w-full md:block"
      ></canvas>
      {/* Top scrim — protects nav + headline */}
      <div class="absolute inset-x-0 top-0 h-[220px] bg-gradient-to-b from-[rgba(18,22,29,0.60)] to-transparent" />
      {/* Left scrim — protects text column (matches design: 62% width) */}
      <div class="absolute inset-y-0 left-0 w-[65%] bg-gradient-to-r from-[rgba(18,22,29,0.52)] to-transparent" />
      {/* Bottom fade — grounds the image */}
      <div class="absolute inset-x-0 bottom-0 h-[160px] bg-gradient-to-t from-[rgba(18,22,29,0.45)] to-transparent" />
    </div>

    {/* ── Layer 2: hero content (scrolls with page) ──────────────── */}
    <div
      class="cfn-hero-content absolute left-0 top-0 z-10 flex h-screen w-full flex-col"
      style="padding: calc(var(--header-h) + 3rem) 3.5rem 2.5rem"
    >
      {/* Main row: lead + ops panel — vertically centred */}
      <div class="flex flex-1 items-center justify-between gap-[60px]">

        {/* ── Hero lead (left column) ── */}
        <div class="flex min-w-0 flex-1 flex-col gap-7">
          <p
            data-animate="fade-up"
            data-edit="hero-eyebrow"
            class="font-mono text-[15px] uppercase tracking-[0.26em]"
            style="color: var(--hi-soft)"
          >
            Donegal Airport · Co. Donegal · CFN
          </p>

          <h1
            data-split
            data-split-delay="0.15"
            data-edit="hero-h1"
            class="hero-display md:whitespace-nowrap"
          >
            Aerfort<br />Dhún na nGall
          </h1>

          <p
            data-animate="fade-up"
            data-animate-delay="0.35"
            data-edit="hero-lede"
            class="max-w-[480px] text-[24px] leading-[1.45]"
            style="color: var(--hi-soft)"
          >
            Dublin daily. Glasgow at weekends — and select summer weekdays.
            Donegal's airport sits where the Atlantic begins.
          </p>

          <div
            data-animate="fade-up"
            data-animate-delay="0.5"
            class="flex items-center gap-[34px]"
          >
            <a href="/flights" class="hero-cta hero-cta--primary" data-edit="cta-primary">
              Today's flights <span class="arrow">→</span>
            </a>
            <a href="/plan#parking" class="hero-cta" data-edit="cta-secondary">
              Parking &amp; getting here <span class="arrow">→</span>
            </a>
          </div>
        </div>

        {/* ── Live Ops Panel (right column, desktop only) ── */}
        <aside class="ops-panel hidden lg:flex lg:flex-col">

          {/* Header row: title + live clock (local + UTC) */}
          <div class="flex items-start justify-between">
            <span
              class="font-mono text-[14px] uppercase tracking-[0.18em]"
              style="color: var(--hi-amber)"
            >
              Inniu · Today
            </span>
            <div class="flex flex-col items-end gap-[3px]">
              <span
                id="ops-clock"
                class="font-mono text-[13.5px] tracking-[0.08em]"
                style="color: var(--hi-faint)"
              >
                — — : — —
              </span>
              <span
                id="ops-clock-utc"
                class="font-mono text-[11.5px] tracking-[0.06em]"
                style="color: rgba(238,244,251,0.82)"
              >
                — — : — — <span style="opacity:0.75">UTC</span>
              </span>
            </div>
          </div>

          {/* Weather row — updated every 10 min from Open-Meteo (CFN coords) */}
          <div
            class="mt-[14px] pb-[18px]"
            style="border-bottom: 1px solid var(--hi-line)"
          >
            {/* Line 1 — temperature + condition (big) */}
            <div class="flex items-baseline gap-[10px]">
              <span id="wx-temp" class="ops-temp">{heroWeather.tempC}°C</span>
              <span
                id="wx-cond"
                class="font-mono text-[17px] leading-none"
                style="color: var(--hi)"
              >{heroWeather.condition}</span>
            </div>
            {/* Line 2 — wind + visibility (smaller detail) */}
            <div
              class="mt-[7px] flex items-baseline gap-[8px] font-mono text-[13px] tracking-[0.04em]"
              style="color: var(--hi-soft)"
            >
              <span id="wx-wind">{heroWeather.windDir} {heroWeather.windKt} kt</span>
              <span style="color: var(--hi-faint)">·</span>
              <span id="wx-vis" class="text-[13px]">Vis {heroWeather.visKm} km</span>
            </div>
          </div>

          {/* Section label: "Next departures" + Live chip */}
          <div
            class="mt-[18px] flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.16em]"
            style="color: var(--hi-soft)"
          >
            <span>Next departures · Imeachtaí</span>
            <span
              class="flex items-center gap-[7px] text-[11px] uppercase tracking-[0.12em]"
              style="color: var(--hi-green)"
            >
              <span class="live-dot ops-badge"></span>Live
            </span>
          </div>

          {/* Departures board — id="hero-deps" lets the board JS keep this in sync */}
          <ul class="mt-[6px]" id="hero-deps">
            {heroDepartures.map((dep) => (
              <li class="ops-board-row">
                <span class="b-time">{dep.time}</span>
                <span class="b-dest">{dep.dest}</span>
                <span class={`b-status ${dep.tone}`}>{dep.status}</span>
                <span class="b-flight">{dep.flight}</span>
              </li>
            ))}
          </ul>

          {/* Footer row: next arrival — id="hero-next-arr" kept in sync by board JS */}
          <div
            class="mt-[16px] flex items-center justify-between pt-[16px]"
            style="border-top: 1px solid var(--hi-line)"
          >
            <span
              id="hero-next-arr"
              class="font-mono text-[10.5px] uppercase tracking-[0.06em]"
              style="color: var(--hi-faint)"
            >
              {nextArrival ? (
                <>Next arrival · {nextArrival.t}{" "}{nextArrival.city} · <span style="color: var(--hi-soft)">{nextArrival.st === "landed" ? "Landed" : nextArrival.st === "enroute" ? "En route" : "Scheduled"}</span></>
              ) : (
                <>No more arrivals today</>
              )}
            </span>
            <a href="/flights" class="ops-cta-link">
              Full board <span class="arrow">→</span>
            </a>
          </div>
        </aside>
      </div>

      {/* Scroll hint — bottom left */}
      <div
        class="flex items-center gap-[10px] font-mono text-[12px] uppercase tracking-[0.22em]"
        style="color: var(--hi-faint)"
        aria-hidden="true"
      >
        Scroll to reveal <span class="hero-bob">↓</span>
      </div>
    </div>

    {/* Live clock script — ticks every minute, shows local + UTC */}
    <script is:inline>
      (function () {
        const el    = document.getElementById('ops-clock');
        const utcEl = document.getElementById('ops-clock-utc');
        if (!el) return;
        const days   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        function tick() {
          const d = new Date();
          const parts = new Intl.DateTimeFormat('en-IE', {
            timeZone: 'Europe/Dublin',
            weekday: 'short', day: 'numeric', month: 'short',
            hour: '2-digit', minute: '2-digit', hour12: false
          }).formatToParts(d).reduce(function(acc, p) { acc[p.type] = p.value; return acc; }, {});
          el.textContent = parts.weekday + ' ' + parts.day + ' ' + parts.month + ' · ' + parts.hour + ':' + parts.minute;
          if (utcEl) {
            const uh = String(d.getUTCHours()).padStart(2,'0');
            const um = String(d.getUTCMinutes()).padStart(2,'0');
            utcEl.innerHTML = uh + ':' + um + ' <span style="opacity:0.6">UTC</span>';
          }
        }
        tick();
        setInterval(tick, 60_000);
      })();
    </script>

    {/* Live weather — Open-Meteo, same source as Bunbeg Coast Guard dashboard.
        Coordinates: Carrickfinn Airport (CFN/EIDL) 55.0441°N, 8.3411°W.
        Refreshes every 10 min. Falls back silently to static values on error. */}
    <script is:inline>
      (function () {
        // WMO weather code → short description (matches coast guard mapping)
        const WMO = {
          0:'Clear sky', 1:'Mainly clear', 2:'Partly cloudy', 3:'Overcast',
          45:'Fog', 48:'Icy fog',
          51:'Light drizzle', 53:'Drizzle', 55:'Heavy drizzle',
          61:'Light rain', 63:'Rain', 65:'Heavy rain',
          71:'Light snow', 73:'Snow', 75:'Heavy snow',
          77:'Snow grains',
          80:'Rain showers', 81:'Heavy showers', 82:'Violent showers',
          85:'Snow showers', 86:'Heavy snow showers',
          95:'Thunderstorm', 96:'Storm & hail', 99:'Storm & heavy hail',
        };
        // 8-point compass rose — readable for general public (vs 16-point WSW/NNE)
        const DIRS = ['N','NE','E','SE','S','SW','W','NW'];
        const compassDir = (deg) => DIRS[Math.round(deg / 45) % 8];

        // Open-Meteo endpoint — free, no auth, CORS open
        const URL =
          'https://api.open-meteo.com/v1/forecast' +
          '?latitude=55.0441&longitude=-8.3411' +
          '&current=temperature_2m,weather_code,' +
          'wind_speed_10m,wind_direction_10m,visibility' +
          '&timezone=Europe%2FDublin';

        function apply(data) {
          const c = data.current;
          const tempEl = document.getElementById('wx-temp');
          const condEl = document.getElementById('wx-cond');
          const windEl = document.getElementById('wx-wind');
          const visEl  = document.getElementById('wx-vis');
          if (!tempEl) return;

          tempEl.textContent = Math.round(c.temperature_2m) + '°C';
          condEl.textContent = WMO[c.weather_code] ?? 'Variable';

          // km/h → knots (÷ 1.852)
          const kt  = Math.round(c.wind_speed_10m / 1.852);
          windEl.textContent = compassDir(c.wind_direction_10m) + ' ' + kt + ' kt';

          // metres → km, cap display at "10 km"
          const visMetre = c.visibility ?? 10000;
          visEl.textContent = 'Vis ' +
            (visMetre >= 10000 ? '10 km' : (visMetre / 1000).toFixed(1) + ' km');
        }

        function fetchWx() {
          fetch(URL)
            .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(apply)
            .catch(() => { /* keep static fallback silently */ });
        }

        fetchWx();
        setInterval(fetchWx, 10 * 60 * 1000); // refresh every 10 min
      })();
    </script>
  </section>

  {/* ---------- EDITORIAL INTRO ----------
      Full-bleed drone photo of the airport, with the Carrickfinn intro
      text overlaid in light type over a left-weighted scrim. Uses the
      cfn-hero-content tokens so text stays legible over the image. */}
  <section class="relative isolate overflow-hidden">
    {/* Background photo + slow Ken Burns */}
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <img
        data-ken-burns
        data-ken-burns-duration="26"
        src="/photos/intro-sunrise.webp"
        alt=""
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      {/* Light left scrim — just enough to keep text legible without
          washing the photo's colour out. The right half stays clear. */}
      {/* Soft top seam blends this section into the hero above */}
      <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-[rgba(18,22,29,0.35)] to-transparent"></div>
    </div>

    <div class="cfn-hero-content mx-auto max-w-7xl px-6 py-32 lg:py-48">
      <div class="max-w-3xl">
        <p
          data-animate="fade-up"
          class="font-mono text-[1.05rem] uppercase tracking-[0.2em]"
          style="color: var(--hi-amber)"
        >
          Carraig Fhinn · Co. Donegal
        </p>
        <p
          data-split
          class="mt-8 max-w-3xl font-display text-[clamp(2.1rem,4.2vw,3.8rem)] font-normal leading-[1.02]"
          style="color: var(--hi)"
        >
          We are the smallest international airport in the country, and the
          one with the best view.
        </p>
        <div
          data-animate="fade-up"
          data-animate-delay="0.25"
          class="mt-8 max-w-xl text-[1.05rem] leading-relaxed"
          style="color: var(--hi-soft)"
        >
          <p>
            Carrickfinn sits on a sandbar between the Atlantic and Mount
            Errigal. The runway runs straight along the beach, with the sea
            on both sides. It's been called one of the most scenic approaches
            in the world — and it's still the fastest way in or out of the county.
          </p>
          <p class="mt-5">
            <a
              href="/story"
              class="border-b pb-0.5 transition-colors hover:text-sand"
              style="border-color: var(--hi-line); color: var(--hi)"
            >
              The full story — Malinair to today →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── THE BOARD · Live Departures & Arrivals (Option A) ─── */}
  <section class="board-sec border-t border-line" data-texture="crt">
    <div class="backdrop-tex" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1180px] px-6 py-20 lg:py-[5rem] lg:pb-[5.5rem]" style="position:relative;z-index:2">
      <div class="board-head">
        <div>
          <p class="board-eyebrow">
            <span class="live-dot-green" aria-hidden="true"></span>
            CFN/EIDL
          </p>
          <h2 class="board-title">Departures and arrivals.</h2>
        </div>
        <div class="text-right">
          <div id="board-clock" class="board-clock-time">--:--:--</div>
          <div class="board-clock-sub">Donegal &middot; Local time</div>
        </div>
      </div>
      <div class="mb-5">
        <div id="board-tabs" class="board-tabs">
          <span class="board-tab-pill" aria-hidden="true"></span>
          <button data-f="ALL" aria-selected="true">All</button>
          <button data-f="DEP" aria-selected="false">Departures</button>
          <button data-f="ARR" aria-selected="false">Arrivals</button>
        </div>
      </div>
      <div class="board-cols">
        <span>Time</span>
        <span class="c-flight">Flight</span>
        <span>Route</span>
        <span class="c-dir">Type</span>
        <span>Status</span>
      </div>
      <div id="board-rows" class="board-rows"></div>
      <div class="board-foot">
        <div class="board-legend">
          <span class="lg"><span class="sw" style="background:#4fb87a"></span>Scheduled / on time</span>
          <span class="lg"><span class="sw" style="background:#3f7fb8"></span>En route / Boarding</span>
          <span class="lg"><span class="sw" style="background:#c2683a"></span>Delayed</span>
        </div>
        <a href="/flights" class="board-link">Full timetable &amp; live status <span class="board-arrow">→</span></a>
      </div>
    </div>
  </section>

  {/* ---------- DESTINATIONS — sticky horizontal scroll ----------
      On desktop, the section pins for ~2 viewports of scroll while
      the inner track translates left through the destination panels.
      On smaller screens, the panels stack vertically and the wrapper
      attributes are ignored by animations.ts. */}
  <section
    data-horizontal
    class="h-wrapper relative hidden lg:block"
    style={`height: ${100 + destinations.length * 100}vh;`}
  >
    <div class="h-pin">
      <div class="h-track">
        <div
          class="flex h-[80vh] w-[32rem] shrink-0 flex-col justify-between px-2 py-12"
        >
          <p class="font-mono text-[1.5rem] font-semibold uppercase tracking-[0.22em] text-atlantic">
            Routes
          </p>
          <div>
            <h2
              data-split
              class="font-display text-[clamp(3.2rem,6vw,7rem)] font-normal leading-[0.94]"
            >
              Two flights,<br />two cities.
            </h2>
            <p class="mt-4 max-w-sm text-lg leading-relaxed text-ink/70">
              Dublin twice a day, every day. Loganair connects to Glasgow on selected days. A short route map — and every seat is a window seat.
            </p>
          </div>
        </div>

        {destinations.map((d) => (
          <article
            data-photo
            class="relative flex h-[80vh] w-[44rem] shrink-0 flex-col justify-end overflow-hidden"
          >
            <img
              src={d.hero}
              alt={d.city}
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position: ${d.photoPos}`}
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"
              aria-hidden="true"
            >
            </div>
            <div class="cfn-hero-content relative z-10 p-10">
              <p class="font-mono text-[0.85rem] font-bold uppercase tracking-[0.3em] text-sand">
                {d.country}
              </p>
              <h3 class="mt-3 font-display text-[clamp(2.5rem,5vw,5rem)] font-normal leading-[0.95] text-ink">
                {d.city}
              </h3>
              <dl class="mt-8 grid grid-cols-3 gap-6 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-mute">
                <div>
                  <dt class="text-sand">Duration</dt>
                  <dd class="mt-1 text-ink">{d.duration}</dd>
                </div>
                <div>
                  <dt class="text-sand">Schedule</dt>
                  <dd class="mt-1 text-ink">{d.schedule}</dd>
                </div>
                <div>
                  <dt class="text-sand">Carrier</dt>
                  <dd class="mt-1 text-ink">{d.carrier}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Mobile fallback for destinations — stacked, full-width photos */}
  <section class="border-t border-line lg:hidden">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p
        data-animate="fade-up"
