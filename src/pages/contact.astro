---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readHours } from "../lib/siteContent";

const title = "Contact · Donegal Airport";
const description = "Reach Donegal Airport (CFN). Phone, email, address, opening hours, lost & found and press contact.";

// Editable in /keystatic ("Terminal & café hours" singleton).
const hours = await readHours();

// TODO: swap for the airport's own Web3Forms access key once they've
// confirmed which mailbox submissions should land in (currently on hold).
const WEB3FORMS_KEY = "REPLACE_WITH_REAL_ACCESS_KEY";
---

<BaseLayout title={title} description={description}>
  {/* ─── HERO ── full-bleed photo, same pattern as every other page ────────── */}
  <section class="relative isolate flex min-h-[80vh] w-full items-center overflow-hidden border-b border-line">
    <picture>
      {/* Landscape hero crops awkwardly on a portrait phone viewport —
          swap to a dedicated vertical photo below sm:, same as the other
          hero-photo pages. */}
      <source media="(max-width: 639px)" srcset="/photos/contact/contact-hero-mobile.webp" type="image/webp" />
      <img
        src="/photos/contact/contact-hero.jpg"
        alt="Donegal Airport ground, fire and terminal staff on the runway"
        class="absolute inset-0 h-full w-full object-cover object-[center_40%]"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="cfn-hero-content relative z-10 mx-auto w-full max-w-7xl px-6 py-28">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.9rem] font-bold uppercase tracking-[0.28em] text-white [text-shadow:0_0_6px_rgba(0,0,0,.9),0_2px_4px_rgba(0,0,0,.9),0_4px_20px_rgba(0,0,0,.6)]"
      >
        Contact
      </p>
      <h1
        data-split
        data-split-delay="0.1"
        class="mt-8 max-w-4xl font-display text-[clamp(2.75rem,7vw,7.5rem)] font-light leading-[0.95] text-ink [text-shadow:0_2px_24px_rgba(0,0,0,.55),0_1px_6px_rgba(0,0,0,.4)]"
      >
        Talk to us.
      </h1>
      <p
        data-animate="fade-up"
        data-animate-delay="0.35"
        class="mt-10 max-w-2xl text-base font-semibold leading-relaxed text-white sm:text-lg [text-shadow:0_1px_10px_rgba(0,0,0,.5)]"
      >
        General enquiries, lost &amp; found, press, ATC.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div
      data-animate="fade-up"
      class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2"
    >
      <div class="group bg-surface px-6 py-10 transition-colors duration-300 hover:bg-[var(--color-atlantic)] sm:px-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-atlantic transition-colors duration-300 group-hover:text-white" aria-hidden="true">
          <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
        </svg>
        <p class="mt-5 font-mono text-[0.8rem] uppercase tracking-[0.22em] text-sand transition-colors duration-300 group-hover:text-white/90">
          General
        </p>
        <p class="mt-3 max-w-xs text-sm text-mute transition-colors duration-300 group-hover:text-white/75">
          Carrickfinn, Kincasslagh, Letterkenny, Co. Donegal · F94 X2RH
        </p>
        <p class="mt-5 font-display text-2xl">
          <a href="tel:+353749548284" class="text-ink transition-colors duration-300 group-hover:text-white">
            +353 (0)74 9548284
          </a>
        </p>
        <p class="mt-1 text-sm">
          <a href="mailto:info@donegalairport.ie" class="text-ink/70 transition-colors duration-300 group-hover:text-white/90">
            info@donegalairport.ie
          </a>
        </p>
      </div>
      <div class="group bg-surface px-6 py-10 transition-colors duration-300 hover:bg-[var(--color-sand)] sm:px-8">
        {/* Control-tower glyph — reused from the ATC Simulator hub's "Tower
           Control" card icon (same stroke style: mast, cab, legs, base). */}
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7 text-atlantic transition-colors duration-300 group-hover:text-white" aria-hidden="true">
          <path d="M32 6v8M28 14h8" />
          <path d="M24 14h16l-3 14H27z" />
          <path d="M30 28v22M34 28v22" />
          <path d="M22 50h20" />
          <path d="M26 50v6M38 50v6" />
        </svg>
        <p class="mt-5 font-mono text-[0.8rem] uppercase tracking-[0.22em] text-sand transition-colors duration-300 group-hover:text-white/90">
          Air Traffic Control
        </p>
        <p class="mt-3 max-w-xs text-sm text-mute transition-colors duration-300 group-hover:text-white/75">
          For PPR, drone operations and aerodrome enquiries.
        </p>
        <p class="mt-5 font-display text-2xl">
          <a href="tel:+353749548604" class="text-ink transition-colors duration-300 group-hover:text-white">
            +353 (0)74 9548604
          </a>
        </p>
        <p class="mt-1 text-sm">
          <a href="mailto:atc@donegalairport.ie" class="text-ink/70 transition-colors duration-300 group-hover:text-white/90">
            atc@donegalairport.ie
          </a>
        </p>
      </div>
    </div>

    <p data-animate="fade-up" class="mt-6 max-w-2xl text-sm leading-relaxed text-mute">
      Special assistance (PRM), a general question, something lost at the
      airport, or a press enquiry? Use the general contact above — we'll
      make sure it reaches the right person.
    </p>

    <div data-animate="fade-up" class="mt-14 grid gap-8 lg:grid-cols-2">
      {/* Contact form */}
      <div class="rounded-2xl border border-line bg-[color-mix(in_srgb,#ffffff_55%,var(--color-surface))] p-6 shadow-[0_1px_2px_rgba(24,29,22,0.05)] sm:p-8">
        <p class="font-mono text-[0.8rem] uppercase tracking-[0.22em] text-sand">
          Send a message
        </p>
        <h2 class="mt-3 font-display text-2xl leading-snug text-ink">
          We'll get back to you as soon as possible.
        </h2>

        <form
          id="contact-form"
          class="mt-7 space-y-5"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="New enquiry — Donegal Airport website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-mute">Name</span>
              <input
                type="text" name="name" required
                class="mt-2 w-full border-b border-line bg-transparent pb-2 text-base text-ink outline-none transition-colors focus:border-atlantic"
              />
            </label>
            <label class="block">
              <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-mute">Email</span>
              <input
                type="email" name="email" required
                class="mt-2 w-full border-b border-line bg-transparent pb-2 text-base text-ink outline-none transition-colors focus:border-atlantic"
              />
            </label>
          </div>

          <label class="block">
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-mute">Reason</span>
            <select
              name="reason"
              class="mt-2 w-full border-b border-line bg-transparent pb-2 text-base text-ink outline-none transition-colors focus:border-atlantic"
            >
              <option>General enquiry</option>
              <option>PPR &amp; ATC</option>
              <option>PRM &amp; special assistance</option>
              <option>Lost &amp; found</option>
              <option>Press &amp; media</option>
            </select>
          </label>

          <label class="block">
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-mute">Message</span>
            <textarea
              name="message" required rows="4"
              class="mt-2 w-full resize-none border-b border-line bg-transparent pb-2 text-base text-ink outline-none transition-colors focus:border-atlantic"
            ></textarea>
          </label>

          <button
            type="submit"
            class="inline-flex items-center gap-2 border-b border-ink pb-1 font-mono text-xs uppercase tracking-[0.22em] text-ink transition-colors hover:border-sand hover:text-sand"
          >
            Send message →
          </button>

          <p data-form-status class="hidden text-sm"></p>
        </form>
      </div>

      {/* Mini map */}
      <div class="rounded-2xl border border-line bg-[color-mix(in_srgb,#ffffff_55%,var(--color-surface))] p-6 shadow-[0_1px_2px_rgba(24,29,22,0.05)] sm:p-8">
        <p class="font-mono text-[0.8rem] uppercase tracking-[0.22em] text-sand">
          Find us
        </p>
        <h2 class="mt-3 font-display text-2xl leading-snug text-ink">
          Carrickfinn, on the Rosses coast.
        </h2>
        <div id="contact-map" class="mt-6 h-[280px] w-full overflow-hidden rounded-xl border border-line bg-[#e8e6de]"></div>
        <a
          href="https://www.google.com/maps/dir/?api=1&destination=55.0442,-8.3410"
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-atlantic transition-colors hover:text-ink"
        >
          Get directions ↗
        </a>
      </div>
    </div>

    <div data-animate="fade-up" class="mt-14 border-t border-line pt-10">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-mute">
        Opening hours
      </p>
      <p class="mt-4 max-w-2xl font-display text-2xl leading-snug text-ink">
        Terminal open daily, {hours.terminal}.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import type L_ from "leaflet";

  let map: L_.Map | null = null;
  let mapObserver: IntersectionObserver | null = null;

  document.addEventListener("astro:before-swap", () => {
    mapObserver?.disconnect();
    mapObserver = null;
    map?.remove();
    map = null;
  });

  document.addEventListener("astro:page-load", () => {
    initContactForm();
    watchContactMap();
  });

  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (!form) return;
    const status = form.querySelector<HTMLElement>("[data-form-status]");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!status) return;
      // Checked fresh at submit time, not baked into which file's script
      // happens to be executing — Astro's View Transitions only run an
      // inline <script>'s top-level code the first time its content is
      // seen, so this and the /ga twin's script can each end up with a
      // submit listener still attached to this same #contact-form element
      // after a morph. Re-checking document.documentElement.lang here means
      // the status text always matches whatever page is actually on screen.
      const GA = document.documentElement.lang === "ga";
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitBtn?.setAttribute("disabled", "true");
      status.className = "text-sm text-mute";
      status.textContent = GA ? "Á sheoladh…" : "Sending…";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json();
        if (data.success) {
          status.className = "text-sm text-atlantic";
          status.textContent = GA
            ? "Go raibh maith agat — tá do theachtaireacht ar an mbealach. Freagróimid laistigh de lá oibre amháin."
            : "Thanks — your message is on its way. We'll reply within one working day.";
          form.reset();
        } else {
          throw new Error(data.message || "Unknown error");
        }
      } catch {
        status.className = "text-sm text-[#b23b3b]";
        status.textContent = GA
          ? "Tharla earráid — seol ríomhphost chugainn go díreach ag info@donegalairport.ie le do thoil."
          : "Something went wrong — please email us directly at info@donegalairport.ie.";
      } finally {
        submitBtn?.removeAttribute("disabled");
      }
    });
  }

  // The map sits well below the fold, so Leaflet's JS + CSS (~50 KiB + 7
  // KiB, previously loaded render-blocking on every visit) only get fetched
  // once the map section is about to scroll into view — cuts contact's LCP
  // critical path without touching the map itself.
  function watchContactMap() {
    const el = document.getElementById("contact-map");
    if (!el) return;
    mapObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        mapObserver?.disconnect();
        mapObserver = null;
        initContactMap(el);
      },
      { rootMargin: "600px 0px" },
    );
    mapObserver.observe(el);
  }

  // `?url` keeps Vite from bundling these as page CSS (which Astro hoists
  // into a render-blocking <link> even for a dynamic import() — the async
  // import above doesn't actually defer it). Resolving to a plain asset URL
  // lets us attach the <link> ourselves, only once the map is really needed.
  function loadStylesheet(href: string): Promise<void> {
    if (document.querySelector(`link[href="${href}"]`)) return Promise.resolve();
    return new Promise((resolve) => {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      link.onload = () => resolve();
      document.head.appendChild(link);
    });
  }

  // CartoDB Voyager tiles + a custom pin in the brand atlantic blue, instead
  // of the plain default-style OpenStreetMap embed (bright cartoon colours,
  // "Export"-page chrome baked into the iframe) — same map stack as the
  // rest of the agency's sites. leaflet-gesture-handling requires a second
  // finger to pan on touch, so one careless swipe over the map doesn't trap
  // the page's own scroll.
  async function initContactMap(el: HTMLElement) {
    map?.remove();
    const GA = document.documentElement.lang === "ga";

    const [{ default: L }, { GestureHandling }, leafletCssUrl, gestureCssUrl] = await Promise.all([
      import("leaflet"),
      import("leaflet-gesture-handling"),
      import("leaflet/dist/leaflet.css?url").then((m) => m.default),
      import("leaflet-gesture-handling/dist/leaflet-gesture-handling.css?url").then((m) => m.default),
    ]);
    await Promise.all([loadStylesheet(leafletCssUrl), loadStylesheet(gestureCssUrl)]);
    if (!document.getElementById("contact-map")) return; // navigated away while loading

    (L.Map as any).addInitHook("addHandler", "gestureHandling", GestureHandling);

    const coords: [number, number] = [55.0442, -8.341];
    map = L.map(el, { gestureHandling: true, scrollWheelZoom: false } as L_.MapOptions).setView(coords, 13);

    L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/attributions">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    const icon = L.divIcon({
      html: '<span style="display:block;width:16px;height:16px;border-radius:50%;background:#1a4a6e;border:3px solid #fff;box-shadow:0 1px 6px rgba(0,0,0,.4)"></span>',
      className: "",
      iconSize: [16, 16],
      iconAnchor: [8, 8],
    });
    // `alt` only reaches the marker's img element for image-based icons —
    // this is a divIcon (a plain <div>, no <img>), so Leaflet silently
    // drops it and the marker ends up with no accessible name at all
    // (axe: aria-command-name). `title` sets a real title attribute on
    // the marker element itself regardless of icon type.
    L.marker(coords, { icon, title: GA ? "Aerfort Dhún na nGall" : "Donegal Airport" }).addTo(map);
  }
</script>
