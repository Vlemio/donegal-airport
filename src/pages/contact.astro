---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact · Donegal Airport";
const description = "Reach Donegal Airport (CFN). Phone, email, address, opening hours, lost & found and press contact.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-40">
    <p class="text-xs uppercase tracking-[0.28em] text-atlantic">Contact</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl leading-[1.05] sm:text-6xl">
      Talk to us.
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">
      General enquiries, lost & found, press, ATC. We answer fast — it's a small team.
    </p>

    <div data-animate="fade-up" class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-line bg-surface-hi p-7">
        <p class="text-xs uppercase tracking-[0.22em] text-sand">General</p>
        <p class="mt-4 text-sm text-mute">Carrickfinn, Kincasslagh, Letterkenny, Co. Donegal · F94 X2RH</p>
        <p class="mt-4"><a href="tel:+353749548284" class="text-ink hover:text-atlantic">+353 (0)74 9548284</a></p>
        <p class="mt-1"><a href="mailto:info@donegalairport.ie" class="text-ink hover:text-atlantic">info@donegalairport.ie</a></p>
      </div>
      <div class="rounded-2xl border border-line bg-surface-hi p-7">
        <p class="text-xs uppercase tracking-[0.22em] text-sand">Air Traffic Control</p>
        <p class="mt-4 text-sm text-mute">For PPR, drone operations and aerodrome enquiries.</p>
        <p class="mt-4"><a href="tel:+353749548604" class="text-ink hover:text-atlantic">+353 (0)74 9548604</a></p>
        <p class="mt-1"><a href="mailto:atc@donegalairport.ie" class="text-ink hover:text-atlantic">atc@donegalairport.ie</a></p>
      </div>
    </div>

    <div data-animate="fade-up" class="mt-10 rounded-2xl border border-dashed border-line bg-surface-hi p-10 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-mute">Coming next</p>
      <p class="mt-3 text-base text-ink">
        Contact form (Web3Forms post-firma) · mini Leaflet · opening hours · lost & found · press contact.
      </p>
    </div>
  </section>
</BaseLayout>
