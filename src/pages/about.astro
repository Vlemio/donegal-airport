---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About · Donegal Airport";
const description = "From the founding of Malinair in 1986 to becoming the first Irish airport with ACA Level 4. The story of Carrickfinn.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-40">
    <p class="text-xs uppercase tracking-[0.28em] text-atlantic">About</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl leading-[1.05] sm:text-6xl">
      Forty years on the beach.
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">
      Malinair · Shorts 360 & Jetstream 41 · Aer Arann · Loganair · today.
      Awards, sustainability, the team behind CFN.
    </p>

    <div data-animate="fade-up" class="mt-12 rounded-2xl border border-dashed border-line bg-surface-hi p-10 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-mute">Coming next</p>
      <p class="mt-3 text-base text-ink">
        Editorial timeline (18 historical photos), awards page, sustainability section, team.
      </p>
    </div>
  </section>
</BaseLayout>
