---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Discover Donegal · Donegal Airport";
const description = "From CFN you're minutes from the Wild Atlantic Way, blue-flag beaches, world-class golf and the heart of the Gaeltacht.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-40">
    <p class="text-xs uppercase tracking-[0.28em] text-atlantic">Discover</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl leading-[1.05] sm:text-6xl">
      Land in Donegal.
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">
      Wild Atlantic Way · Carrickfinn beach · Errigal · Glenveagh · the Gaeltacht.
    </p>

    <div data-animate="fade-up" class="mt-12 rounded-2xl border border-dashed border-line bg-surface-hi p-10 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-mute">Coming next</p>
      <p class="mt-3 text-base text-ink">
        Editorial cards with Jose Manuel's photography, distances from CFN, golf course directory.
      </p>
    </div>
  </section>
</BaseLayout>
