---

<BaseLayout title={title} description={description}>

  {/* ─── HERO — D: full-bleed photo · centred kicker + title + links · no body ─ */}
  <section class="relative h-[88vh] min-h-[540px] overflow-hidden border-b border-line">

    <img
      src="/photos/discover-hero.webp"
      alt="Sunset from Errigal, Donegal"
      class="absolute inset-0 h-full w-full object-cover object-[50%_42%]"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />

    {/* Overall darkening scrim — subtle, lets colours through */}
    <div class="pointer-events-none absolute inset-0 bg-ink/25" aria-hidden="true"></div>

    {/* Content — centred */}
    <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-white sm:tracking-[0.34em]"
        style="text-shadow: 0 1px 10px rgba(0,0,0,0.8)"
      >
        Donegal · Ireland · Wild Atlantic Way
      </p>
      <h1
        data-split
        data-split-delay="0.1"
        class="mt-5 font-display text-[clamp(3.5rem,7vw,8rem)] font-normal leading-[0.9] text-white"
      >
        The Atlantic<br />begins here.
      </h1>
      <p
        data-animate="fade-up"
        data-animate-delay="0.25"
        class="mt-6 max-w-lg text-[1rem] leading-relaxed text-white/80"
        style="text-shadow: 0 1px 8px rgba(0,0,0,0.45)"
      >
        Most people land and then travel. Here, you've already arrived somewhere worth being. Fly into Ireland's wildest coast.
      </p>
      <div
        data-animate="fade-up"
        data-animate-delay="0.4"
        class="mt-8 flex flex-wrap justify-center gap-8"
      >
        <a
          href="#destinations"
          class="border-b border-white/50 pb-0.5 font-mono text-xs uppercase tracking-[0.22em] text-white transition-colors hover:border-sand hover:text-sand"
        >
          Explore destinations →
        </a>
        <a
          href="/flights"
          class="border-b border-white/50 pb-0.5 font-mono text-xs uppercase tracking-[0.22em] text-white transition-colors hover:border-sand hover:text-sand"
        >
          Book a flight →
        </a>
      </div>
    </div>

    <figcaption class="absolute bottom-4 right-5 font-mono text-[0.55rem] uppercase tracking-[0.18em] text-white/35">
      Errigal · Co. Donegal
    </figcaption>

  </section>

  {/* ─── THREE HIGHLIGHTS ──────────────────────────────────────────────────────
      Photo on top of each column, text below. */}
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <ul class="grid gap-12 sm:grid-cols-3">
        {highlights.map((h, i) => (
          <li
            data-animate="fade-up"
            data-animate-delay={`${0.07 * i}`}
            class="flex flex-col"
          >
            {/* Photo — 3:4 portrait */}
            <figure data-drag-fig class="relative aspect-[3/4] w-full overflow-hidden bg-surface-lo">
              {h.src && (
                <img
                  data-drag-img
                  src={h.src}
                  alt={h.label}
                  class="absolute inset-0 h-full w-full object-cover"
                  style={`object-position: ${h.srcPos}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div data-drag-overlay class="pointer-events-none absolute inset-0"></div>
              <div data-drag-readout class="pointer-events-none absolute left-3 top-3 hidden rounded bg-black/60 px-2 py-1 font-mono-num text-[0.6rem] text-white backdrop-blur-sm">
                {h.srcPos}
              </div>
              <figcaption class="pointer-events-none absolute bottom-3 left-4 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-white" style="text-shadow:0 1px 6px rgba(0,0,0,0.85)">
                {h.caption}
              </figcaption>
            </figure>

            <div class="mt-6 flex flex-1 flex-col">
              <p class="font-mono text-[0.82rem] font-bold uppercase tracking-[0.22em] text-atlantic">
                {h.label}
              </p>
              <p class="mt-3 text-[0.9rem] leading-relaxed text-mute">
                {h.text}
              </p>
              <a
                href={h.link}
                class="mt-auto pt-5 inline-block border-b border-ink/40 pb-0.5 font-mono text-[0.66rem] uppercase tracking-[0.22em] text-ink transition-colors hover:border-sand hover:text-sand"
              >
                Explore →
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── DESTINATIONS GRID ─────────────────────────────────────────────────────
      6 cards · 3×2 on desktop · photos fill each card · text below. */}
  <section class="border-b border-line bg-surface-lo/50">
    <div class="mx-auto max-w-7xl px-6 py-20">

      <div class="mb-14 flex items-end justify-between gap-6">
        <div>
          <p
            data-animate="fade-up"
            class="font-mono text-[0.82rem] font-bold uppercase tracking-[0.26em] text-atlantic"
          >
            From the terminal
          </p>
          <h2
            data-split
            class="mt-3 font-display text-[clamp(2rem,4.5vw,4.2rem)] font-normal leading-[0.97]"
          >
            Where do you go first?
          </h2>
        </div>
      </div>

      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {destinations.map((d, i) => (
          <li
            data-animate="fade-up"
            data-animate-delay={`${0.05 * i}`}
            data-tilt
            class="group"
          >
            {/* Photo area — 4:5 portrait */}
            <figure
              data-drag-fig
              class="relative aspect-[4/5] w-full overflow-hidden bg-surface-lo"
            >
              {d.src && (
                <img
                  data-drag-img
                  src={d.src}
                  alt={d.title}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  style={`object-position: ${d.srcPos}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                aria-hidden="true"
              ></div>
              <p class="pointer-events-none absolute bottom-4 left-5 right-4 font-display text-[clamp(1.2rem,2.5vw,1.7rem)] font-normal leading-tight text-[#f0eee6] opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                {d.tagline}
              </p>
              <div data-drag-overlay class="pointer-events-none absolute inset-0"></div>
              <div data-drag-readout class="pointer-events-none absolute left-3 top-3 hidden rounded bg-black/60 px-2 py-1 font-mono-num text-[0.6rem] text-white backdrop-blur-sm">
                {d.srcPos}
              </div>
              <figcaption class="pointer-events-none absolute bottom-3 right-3 font-mono text-[0.52rem] uppercase tracking-[0.15em] text-white" style="text-shadow:0 1px 6px rgba(0,0,0,0.85)">
                {d.caption}
              </figcaption>
            </figure>

            {/* Text below photo — always visible */}
            <div class="mt-4 flex items-start justify-between gap-4">
              <div>
                <h3 class="font-display text-[1.5rem] font-bold leading-tight">
                  {d.title}
                </h3>
                <p data-odometer class="mt-1 font-mono-num text-[0.65rem] uppercase tracking-[0.2em] text-mute">
                  {d.drive}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── ACTIVITIES GRID ───────────────────────────────────────────────────────
      6 cards · same design as destinations · sports & activities */}
  <section id="activities" class="border-b border-line">
    <div class="mx-auto max-w-7xl px-6 py-20">

      <div class="mb-14 flex items-end justify-between gap-6">
        <div>
          <p
            data-animate="fade-up"
            class="font-mono text-[0.82rem] font-bold uppercase tracking-[0.26em] text-atlantic"
          >
            Sports &amp; activities
          </p>
          <h2
            data-split
