<style>
  [data-drag-img] {
    transform-origin: center;
    transition: transform 0.1s ease;
  }

  /* Golf carousel */
  #golf-prev:disabled,
  #golf-next:disabled { opacity: 0.3; pointer-events: none; }

  #isl-prev:disabled,
  #isl-next:disabled { opacity: 0.2; pointer-events: none; }
</style>

<script>
  function initGolfCarousel() {
    const wrap    = document.getElementById("golf-carousel-wrap");
    const track   = document.getElementById("golf-track");
    const prevBtn = document.getElementById("golf-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("golf-next") as HTMLButtonElement | null;
    const counter = document.getElementById("golf-counter");
    if (!wrap || !track || !prevBtn || !nextBtn) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>("[data-golf-card]"));
    const gap = 24; // 1.5rem gap-6
    let idx = 0;
    // Below sm the row is a native swipe-scroll-snap strip (basis-[84%] on
    // each card, arrows hidden) instead of JS-sized/positioned — matches
    // the Operators/airlines strip pattern.
    const isMobile = () => window.innerWidth < 640;

    // Desktop keeps its original fixed 3-per-view; tablet scales down
    // like the islands carousel (same 1024/640 breakpoints), instead of
    // squeezing 3 cards into a phone-width track.
    const getPerView = () => window.innerWidth >= 1024 ? 3 : 2;

    const setWidths = () => {
      if (isMobile()) return; // sized by the basis-[84%] class instead
      const pv = getPerView();
      const w = Math.floor((wrap.offsetWidth - gap * (pv - 1)) / pv);
      cards.forEach((c) => (c.style.width = `${w}px`));
    };

    // Assign src from data-src so images load even when hidden by overflow:hidden
    track.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
      img.src = img.dataset.src!;
    });

    const go = (i: number) => {
      if (isMobile()) {
        // Native scroll drives position on mobile — clear any transform
        // left over from a resize down from a wider breakpoint.
        track.style.transform = "";
        return;
      }
      const pv = getPerView();
      const maxIdx = Math.max(0, cards.length - pv);
      idx = Math.max(0, Math.min(maxIdx, i));
      const step = cards[0].offsetWidth + gap;
      track.style.transform = `translateX(-${idx * step}px)`;
      if (counter) counter.textContent = `${Math.min(idx + pv, cards.length)} / ${cards.length}`;
      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx >= maxIdx;
    };

    // Mobile: reflect whichever card is nearest the left edge in the
    // counter, same approach as the Operators strip's swipe counter.
    const updateMobileCounter = () => {
      if (!isMobile() || !counter) return;
      const wrapLeft = wrap.getBoundingClientRect().left;
      let nearest = 0, smallestGap = Infinity;
      cards.forEach((card, i) => {
        const gapPx = Math.abs(card.getBoundingClientRect().left - wrapLeft);
        if (gapPx < smallestGap) { smallestGap = gapPx; nearest = i; }
      });
      counter.textContent = `${nearest + 1} / ${cards.length}`;
    };

    setWidths();
    go(0);
    updateMobileCounter();

    prevBtn.addEventListener("click", () => go(idx - 1));
    nextBtn.addEventListener("click", () => go(idx + 1));
    wrap.addEventListener("scroll", updateMobileCounter, { passive: true });
    window.addEventListener("resize", () => { setWidths(); go(idx); updateMobileCounter(); });
  }

  function initGrain() {
    if (document.getElementById("grain-overlay")) return;
    const d = document.createElement("div");
    d.id = "grain-overlay";
    d.setAttribute("aria-hidden", "true");
    d.style.cssText = "position:fixed;inset:-25%;width:150%;height:150%;z-index:9999;pointer-events:none;opacity:0.055;will-change:transform;";
    const c = document.createElement("canvas");
    c.width = c.height = 512;
    const ctx = c.getContext("2d")!;
    const img = ctx.createImageData(512, 512);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = (Math.random() * 255) | 0;
      img.data[i] = img.data[i + 1] = img.data[i + 2] = v;
      img.data[i + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
    d.style.backgroundImage = `url(${c.toDataURL()})`;
    d.style.backgroundSize = "256px";
    document.body.appendChild(d);
    let f = 0, grainScrolling = false, grainScrollTimer = 0;
    window.addEventListener('scroll', () => {
      grainScrolling = true;
      clearTimeout(grainScrollTimer);
      grainScrollTimer = setTimeout(() => { grainScrolling = false; }, 150) as unknown as number;
    }, { passive: true });
    (function tick() {
      requestAnimationFrame(tick);
      if (document.hidden || grainScrolling) return;
      if (++f % 3 === 0)
        d.style.transform = `translate(${((Math.random() * 40 - 20) | 0)}px,${((Math.random() * 40 - 20) | 0)}px)`;
    })();
  }

  function initCardTilt() {
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      let raf = 0;
      let leaveTimer: ReturnType<typeof setTimeout>;
      let entering = false;

      const figure = card.querySelector<HTMLElement>("figure");
      const img = !card.querySelector("[data-drag-img]")
        ? card.querySelector<HTMLImageElement>("img")
        : null;

      let spot: HTMLDivElement | null = null;
      if (figure) {
        spot = document.createElement("div");
        spot.setAttribute("aria-hidden", "true");
        spot.style.cssText =
          "position:absolute;inset:0;pointer-events:none;z-index:3;" +
          "opacity:0;transition:opacity 0.35s ease;border-radius:inherit;";
        figure.appendChild(spot);
      }

      let cardRect: DOMRect | null = null;
      let figureRect: DOMRect | null = null;

      card.addEventListener("mouseenter", () => {
        clearTimeout(leaveTimer);
        entering = true;
        cardRect = card.getBoundingClientRect();
        figureRect = figure ? figure.getBoundingClientRect() : null;
        card.style.transition = "transform 0.2s ease";
        if (img) img.style.transition = "transform 0.2s ease";
        if (spot) spot.style.opacity = "1";
      });

      card.addEventListener("mousemove", (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          if (!cardRect) return;
          const x = (e.clientX - cardRect.left) / cardRect.width - 0.5;
          const y = (e.clientY - cardRect.top) / cardRect.height - 0.5;

          // Keep entry transition for the first move so it eases in smoothly;
          // clear it on subsequent moves for direct tracking.
          if (entering) {
            entering = false;
          } else {
            card.style.transition = "";
            if (img) img.style.transition = "";
          }

          card.style.transform = `perspective(900px) rotateY(${x * 7}deg) rotateX(${-y * 4}deg)`;

          if (spot && figureRect) {
            spot.style.background = `radial-gradient(circle 200px at ${e.clientX - figureRect.left}px ${e.clientY - figureRect.top}px, rgba(255,255,255,0.09) 0%, transparent 70%)`;
          }

          if (img) {
            img.style.transform = `translateX(${-x * 10}px) translateY(${-y * 7}px) scale(1.06)`;
          }
        });
      });

      card.addEventListener("mouseleave", () => {
        cancelAnimationFrame(raf);
        entering = false;
        if (spot) spot.style.opacity = "0";
        clearTimeout(leaveTimer);
        leaveTimer = setTimeout(() => {
          card.style.transition = "transform 0.55s cubic-bezier(0.23,1,0.32,1)";
          card.style.transform = "";
          if (img) {
            img.style.transition = "transform 0.55s cubic-bezier(0.23,1,0.32,1)";
            img.style.transform = "";
          }
        }, 40);
      });
    });
  }

  function initOdometer() {
    document.querySelectorAll<HTMLElement>("[data-odometer]").forEach((el) => {
      const text = el.textContent ?? "";
      const m = text.match(/\d+/);
      if (!m) return;
      const target = parseInt(m[0]);
      const pre = text.slice(0, m.index);
      const suf = text.slice((m.index ?? 0) + m[0].length);
      const obs = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        const t0 = performance.now();
        const dur = 2400;
        (function tick(now: number) {
          const p = Math.min((now - t0) / dur, 1);
          const ease = 1 - (1 - p) ** 3;
          el.textContent = pre + Math.round(ease * target) + suf;
          if (p < 1) requestAnimationFrame(tick);
        })(performance.now());
      }, { threshold: 0.6 });
      obs.observe(el);
    });
  }

  function initIslandCarousel() {
    const wrap    = document.getElementById("isl-carousel-wrap");
    const track   = document.getElementById("isl-track");
    const prevBtn = document.getElementById("isl-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("isl-next") as HTMLButtonElement | null;
    const counter = document.getElementById("isl-counter");
    if (!wrap || !track || !prevBtn || !nextBtn) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>("[data-isl-card]"));
    const gap = 24;
    let idx = 0;
    // Below sm the row is a native swipe-scroll-snap strip (basis-[84%] on
    // each card, arrows hidden) instead of JS-sized/positioned — matches
    // the Operators/airlines strip pattern.
    const isMobile = () => window.innerWidth < 640;

    const getPerView = () => window.innerWidth >= 1024 ? 4 : 2;

    const setWidths = () => {
      if (isMobile()) return; // sized by the basis-[84%] class instead
      const pv = getPerView();
      const w = Math.floor((wrap.offsetWidth - gap * (pv - 1)) / pv);
      cards.forEach((c) => (c.style.width = `${w}px`));
    };

    const go = (i: number) => {
      if (isMobile()) {
        // Native scroll drives position on mobile — clear any transform
        // left over from a resize down from a wider breakpoint.
        track.style.transform = "";
        return;
      }
      const pv = getPerView();
      const maxIdx = Math.max(0, cards.length - pv);
      idx = Math.max(0, Math.min(maxIdx, i));
      const step = cards[0].offsetWidth + gap;
      track.style.transform = `translateX(-${idx * step}px)`;
      if (counter) counter.textContent = `${Math.min(idx + pv, cards.length)} / ${cards.length}`;
      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx >= maxIdx;
    };

    // Mobile: reflect whichever card is nearest the left edge in the
    // counter, same approach as the Operators strip's swipe counter.
    const updateMobileCounter = () => {
      if (!isMobile() || !counter) return;
      const wrapLeft = wrap.getBoundingClientRect().left;
      let nearest = 0, smallestGap = Infinity;
      cards.forEach((card, i) => {
        const gapPx = Math.abs(card.getBoundingClientRect().left - wrapLeft);
        if (gapPx < smallestGap) { smallestGap = gapPx; nearest = i; }
      });
      counter.textContent = `${nearest + 1} / ${cards.length}`;
    };

    setWidths();
    go(0);
    updateMobileCounter();

    prevBtn.addEventListener("click", () => go(idx - 1));
    nextBtn.addEventListener("click", () => go(idx + 1));
    wrap.addEventListener("scroll", updateMobileCounter, { passive: true });
    window.addEventListener("resize", () => { setWidths(); go(idx); updateMobileCounter(); });
  }

  document.addEventListener("astro:page-load", () => {
    initGolfCarousel();
    initIslandCarousel();
    initGrain();
    initCardTilt();
    initOdometer();

    // Trigger map intro animation when the section enters the viewport
    const frame = document.getElementById('don-map-frame') as HTMLIFrameElement | null;
    if (frame) {
      const obs = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        // Small delay so the user sees the full animation from the start
        setTimeout(() => {
          frame.contentWindow?.postMessage({ type: 'don-start-intro' }, '*');
        }, 1100);
      }, { threshold: 0.15 });
      obs.observe(frame);

      // Pause WAW animation when iframe is off-screen to save GPU cycles
      const wawVis = new IntersectionObserver(([entry]) => {
        frame.contentWindow?.postMessage(
          { type: entry.isIntersecting ? 'don-waw-resume' : 'don-waw-pause' }, '*'
        );
      }, { threshold: 0 });
      wawVis.observe(frame);

      // The iframe keeps normal pointer-events at all times (no more toggling
      // it off during page scroll — that trick raced with the places list's own
      // scrolling and never reliably won). Ctrl+scroll-to-zoom and the places
      // list's own scroll are both handled natively inside the iframe now.
      // The only thing the parent still needs to do: when the cursor is over
      // the iframe but not over anything scrollable in there (e.g. empty map
      // area), the iframe forwards the wheel delta here so the page keeps
      // scrolling through instead of getting stuck.
      window.addEventListener('message', (e) => {
        // The map iframe is self-hosted (same-origin) — reject anything else.
        if (e.origin !== location.origin) return;
        if (e.data?.type !== 'don-scroll-through') return;
        const delta = e.data.deltaY * (e.data.deltaMode === 1 ? 20 : 1);
        window.scrollBy({ top: delta, left: 0, behavior: 'auto' });
      });

      // Replay intro animation every time "Explore destinations →" is clicked
      const exploreLink = document.querySelector<HTMLAnchorElement>('a[href="#destinations"]');
      if (exploreLink) {
        exploreLink.addEventListener('click', () => {
          setTimeout(() => {
            frame.contentWindow?.postMessage({ type: 'don-replay-intro' }, '*');
          }, 450);
        });
      }
    }
  });
</script>
