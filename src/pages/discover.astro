---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Discover Donegal · Donegal Airport";
const description =
  "From CFN you are minutes from the Wild Atlantic Way, blue-flag beaches, Errigal Mountain and the heart of the Irish Gaeltacht.";

const highlights = [
  {
    label: "Coast & Ocean",
    text: "Blue-flag beaches, sea stacks, cliff walks. Ireland's most dramatic coastline is ten minutes from baggage claim. Carrickfinn beach starts at the runway threshold.",
    link: "#destinations",
    src: "/photos/discover-carrickfinn.webp",
    srcPos: "90% 38%",
    caption: "Carrickfinn beach · CFN",
  },
  {
    label: "Mountain & Lough",
    text: "Errigal, Slieve League and Glenveagh National Park sit within an hour's drive. No queues. No crowds. The park's 16,000 hectares of blanket bog and oak wood are free.",
    link: "#destinations",
    src: "/photos/discover-mountain-lough.webp",
    srcPos: "50% 70%",
    caption: "Errigal · Co. Donegal",
  },
  {
    label: "Gaeltacht",
    text: "Donegal is Ireland's largest Irish-speaking county. The airport sits at its heart. The dialect here — Úlaidh — is the oldest form of Irish still spoken daily.",
    link: "#destinations",
    src: "/photos/discover-gaeltacht.jpg",
    srcPos: "26% 48%",
    caption: "Bunbeg Pier. Gweedore village",
  },
] as const;

const destinations = [
  {
    code: "01",
    title: "Wild Atlantic Way",
    drive: "CFN sits on the route",
    tagline: "Ireland's great coastal road. 2,500 km of cliff, cove and open sky. Donegal holds the wildest stretch.",
    src: "/photos/discover-wild-atlantic.jpg",
    srcPos: "49% 0%",
    caption: "Wild Atlantic Way · north Donegal",
  },
  {
    code: "02",
    title: "Errigal Mountain",
    drive: "22 min from CFN",
    tagline: "Donegal's iconic quartzite cone, 751 m. The summit ridge trail takes two hours. The view takes the rest of the day.",
    src: "/photos/discover-errigal.jpg",
    srcPos: "60% 78%",
    caption: "Errigal · Co. Donegal",
  },
  {
    code: "03",
    title: "Glenveagh",
    drive: "45 min from CFN",
    tagline: "Ireland's largest national park. Red deer, peregrine falcons, a Victorian castle beside a glacier lough. Entry is free.",
    src: "/photos/discover-glenveagh.jpg",
    srcPos: "48% 89%",
    caption: "Glenveagh · Co. Donegal",
  },
  {
    code: "04",
    title: "Slieve League",
    drive: "55 min from CFN",
    tagline: "Three times the height of the Cliffs of Moher. A fraction of the visitors. The Atlantic crashes 600 m below the summit.",
    src: "/photos/discover-slieve-league.jpg",
    srcPos: "24% 38%",
    caption: "Slieve League · Co. Donegal",
  },
  {
    code: "05",
    title: "Malin Head",
    drive: "75 min from CFN",
    tagline: "Ireland's most northern point. End of the Wild Atlantic Way. The signs point here from every corner of the island.",
    src: "/photos/discover-malin-head.jpg",
    srcPos: "61% 48%",
    caption: "Malin Head · Co. Donegal",
  },
  {
    code: "06",
    title: "Donegal Town",
    drive: "60 min from CFN",
    tagline: "A medieval castle, a diamond square, the best tweed on the island. Small enough to walk end-to-end before dinner.",
    src: "/photos/discover-donegal-town.jpg",
    srcPos: "50% 50%",
    caption: "Donegal Town",
  },
] as const;


type Provider = { name: string; website: string; phone: string; email: string };

const activities: {
  code: string;
  label: string;
  title: string;
  tagline: string;
  src: string;
  srcPos: string;
  providers: Provider[];
  moreUrl: string;
}[] = [
  {
    code: "01",
    label: "Golf",
    title: "Links Golf Capital of Ireland",
    tagline: "Ten championship courses within an hour of CFN — Rosapenna, Ballyliffin and Portsalon among the finest links in Europe.",
    src: "/photos/discover-golf.jpg",
    srcPos: "50% 50%",
    providers: [],
    moreUrl: "",
  },
  {
    code: "02",
    label: "Water Sports",
    title: "Kite, windsurf, paddle. At the fence.",
    tagline: "Carrickfinn Watersports sits at the airport perimeter fence. Kitesurfing, windsurfing, paddleboarding and open-water swimming on Blue Flag water.",
    src: "/photos/discover-watersports.jpg",
    srcPos: "62% 39%",
    providers: [
      { name: "Carrickfinn Watersports", website: "https://www.carrickfinnwatersports.ie", phone: "+353 83 073 1517", email: "cfnwatersports@gmail.com" },
    ],
    moreUrl: "https://www.govisitdonegal.com/things-to-do/activities/water-activities",
  },
  {
    code: "03",
    label: "Sea Kayaking",
    title: "Paddle the Wild Atlantic",
    tagline: "Guided sea kayaking along sea caves, sea stacks and headlands only reachable from the water. Day trips and multi-day expeditions.",
    src: "/photos/discover-kayaking.jpg",
    srcPos: "50% 50%",
    providers: [
      { name: "Sea Kayaking Donegal", website: "https://www.seakayakingdonegal.com", phone: "", email: "seakayakingdonegal@gmail.com" },
    ],
    moreUrl: "",
  },
  {
    code: "04",
    label: "Sailing",
    title: "Open water, big sky",
    tagline: "Skippered sailing trips along Donegal Bay and the northwest coast. Day sails and longer charters from local harbours.",
    src: "/photos/discover-sailing.jpg",
    srcPos: "50% 50%",
    providers: [
      { name: "Selkie Sailing", website: "https://www.selkieseaadventures.com", phone: "+353 86 222 3328", email: "info@selkiesailing.com" },
    ],
    moreUrl: "",
  },
  {
    code: "05",
    label: "Trek & Paddle",
    title: "Two ways to see the coast",
    tagline: "Guided multi-activity days combining coastal walking with sea kayaking. Donegal's wild coast, explored from land and water on the same day.",
    src: "/photos/discover-trek-paddle.jpg",
    srcPos: "50% 50%",
    providers: [
      { name: "Trek and Paddle", website: "", phone: "+353 87 090 3163", email: "trekandpaddledonegal@gmail.com" },
    ],
    moreUrl: "",
  },
  {
    code: "06",
    label: "Outdoor Adventure",
    title: "From cliff faces to open water",
    tagline: "Rock climbing, archery, power boating and sea kayaking. All-weather, all-ability programmes for groups, families and individuals.",
    src: "/photos/discover-adventure.jpg",
    srcPos: "68% 100%",
    providers: [
      { name: "Gartan Outdoor Pursuits Centre", website: "https://www.gartan.com", phone: "+353 74 913 7032", email: "" },
      { name: "Unique Ascent", website: "https://www.uniqueascent.ie", phone: "+353 87 758 4710", email: "" },
    ],
    moreUrl: "",
  },
  {
    code: "07",
    label: "Diving",
    title: "Wrecks of the northwest coast",
    tagline: "Cold, clear Atlantic water with exceptional visibility. Wreck dives, reef dives and shore diving from beginner to technical grade.",
    src: "/photos/discover-diving.jpg",
    srcPos: "48% 13%",
    providers: [
      { name: "Dive Arranmore", website: "https://www.divearranmore.com", phone: "+353 86 330 0516", email: "" },
      { name: "Mevagh Dive Centre", website: "https://www.mevaghdiving.com", phone: "+353 74 914 4708", email: "" },
    ],
    moreUrl: "",
  },
  {
    code: "08",
    label: "Surfing",
    title: "Atlantic swells, year-round",
    tagline: "Donegal's exposed coast picks up consistent Atlantic swell from September to May. Board hire and lessons are minutes from the airport.",
    src: "/photos/discover-surfing.jpg",
    srcPos: "63% 15%",
    providers: [],
    moreUrl: "https://www.govisitdonegal.com/things-to-do/activities/surfing",
  },
  {
    code: "09",
    label: "Cycling",
    title: "Empty roads, epic scenery",
    tagline: "The Wild Atlantic Way cycle route winds through some of Ireland's most spectacular coastal scenery, with very little traffic.",
    src: "/photos/discover-cycling.jpg",
    srcPos: "50% 50%",
    providers: [],
    moreUrl: "https://www.govisitdonegal.com/things-to-do/activities/cycling",
  },
  {
    code: "10",
    label: "Angling",
    title: "The catch of a lifetime",
    tagline: "Donegal's rivers run with salmon and sea trout. The Atlantic coast offers shore angling and fully-equipped deep-sea charter boats.",
    src: "/photos/discover-angling.jpg",
    srcPos: "50% 50%",
    providers: [],
    moreUrl: "https://www.govisitdonegal.com/things-to-do/activities/angling",
  },
  {
    code: "11",
    label: "Walking & Hiking",
    title: "Pull on boots. Point anywhere.",
    tagline: "Waymarked Ways, National Loops and the Wild Nephin Wilderness Trail. 50,000 km² of Donegal — and very few other walkers.",
    src: "/photos/discover-hiking.jpg",
    srcPos: "50% 50%",
    providers: [],
    moreUrl: "https://www.govisitdonegal.com/things-to-do/activities/walking",
  },
];


const golfClubs = [
  { name: "Rosapenna Golf Resort",     location: "Downings",    contact: "golf@rosapenna.ie",            phone: "+353 74 91 55000",  website: "https://www.rosapenna.ie",             photo: "/photos/golf/rosapenna.webp" },
  { name: "Ballyliffin Golf Club",     location: "Ballyliffin", contact: "info@ballyliffingolfclub.com", phone: "+353 74 9376 119",  website: "https://www.ballyliffingolfclub.com",  photo: "/photos/golf/ballyliffin.webp" },
  { name: "Portsalon Golf Club",       location: "Portsalon",   contact: "admin@portsalongolfclub.ie",   phone: "+353 74 9159459",   website: "https://www.portsalongolfclub.ie",     photo: "/photos/golf/portsalon.webp" },
  { name: "Narin & Portnoo Golf Club", location: "Portnoo",     contact: "info@nandplinks.com",          phone: "+353 74 95 45107",  website: "https://www.narinandportnoo.com",      photo: "/photos/golf/narin-portnoo.webp" },
  { name: "Cruit Island Golf Club",    location: "Kincasslagh", contact: "info@cruitislandgolfclub.com", phone: "+353 74 9543296",   website: "https://www.cruitislandgolfclub.com",  photo: "/photos/golf/cruit-island.webp" },
  { name: "Dunfanaghy Golf Club",      location: "Dunfanaghy",  contact: "dunfanaghygolf@eircom.net",    phone: "+353 74 913 6335",  website: "https://www.dunfanaghygolfclub.com",   photo: "/photos/golf/dunfanaghy.webp" },
  { name: "Gweedore Golf Club",        location: "Gweedore",    contact: "gweedoregc@gmail.com",         phone: "+353 74 9531140",   website: "https://www.gweedoregolfclub.com",     photo: "/photos/golf/gweedore.webp" },
  { name: "Donegal Golf Club",         location: "Murvagh",     contact: "info@donegalgolfclub.ie",      phone: "+353 74 97 34054",  website: "https://www.donegalgolfclub.ie",       photo: "/photos/golf/donegal-club.webp" },
  { name: "Bundoran Golf Club",        location: "Bundoran",    contact: "info@bundorangolfclub.com",    phone: "+353 71 984 1302",  website: "https://www.bundorangolfclub.com",     photo: "/photos/golf/bundoran.jpg" },
  { name: "North West Golf Club",      location: "Buncrana",    contact: "booking@northwestgolfclub.com",phone: "+353 74 936 1715",  website: "https://www.northwestgolfclub.com",    photo: "/photos/golf/north-west.webp" },
] as const;

const islands = [
  // ── Original four — most visited, shown first ──────────────────────────────
  {
    name: "Arranmore",
    irish: "An Oileán Mór",
    ferry: "Burtonport · 15 min crossing",
    drive: "35 min from CFN",
    text: "Donegal's largest inhabited island. 500 residents, blue-flag beaches, sea cliffs and a pub that opens when the fishermen get back.",
    src: "/photos/discover-island-arranmore.jpg", srcPos: "36% 28%",
    credit: "", creditUrl: "",
  },
  {
    name: "Tory Island",
    irish: "Toraigh",
    ferry: "Magheroarty · 45 min crossing",
    drive: "55 min from CFN",
    text: "Nine miles offshore. A world of its own — an elected king, a school of naïve painters, and a way of life untouched by the mainland.",
    src: "/photos/discover-island-tory.jpg", srcPos: "49% 41%",
    credit: "", creditUrl: "",
  },
  {
    name: "Gola Island",
    irish: "Oileán Ghabhla",
    ferry: "Bunbeg · 10 min crossing",
    drive: "40 min from CFN",
    text: "Uninhabited since 1967. White beaches, abandoned stone cottages, complete silence. Day trips run in summer from Bunbeg harbour.",
    src: "/photos/discover-island-gola.jpg", srcPos: "35% 0%",
    credit: "", creditUrl: "",
  },
  {
    name: "Owey Island",
    irish: "Uaigh",
    ferry: "Cruit Island · 10 min crossing",
    drive: "40 min from CFN",
    text: "No road. No permanent residents. A small summer population returns each year to keep the old cottages alive. Arranged crossings only.",
    src: "/photos/discover-island-owey.jpg", srcPos: "50% 50%",
    credit: "Iain Miller / Unique Ascent", creditUrl: "",
  },
  // ── Additional islands ─────────────────────────────────────────────────────
  {
    name: "Inishbofin",
    irish: "Inis Bó Finne",
    ferry: "Magheraroarty · 20 min crossing",
    drive: "50 min from CFN",
    text: "A small Gaeltacht community off the northwest coast. White beaches, dramatic cliffs, and one of Donegal's most important seabird colonies.",
    src: "/photos/discover-island-bofin.jpg", srcPos: "50% 50%",
    credit: "Alan Reid", creditUrl: "https://www.geograph.ie/photo/5015145",
  },
  {
    name: "Inishfree",
    irish: "Inis Fraoigh",
    ferry: "Burtonport · 10 min crossing",
    drive: "35 min from CFN",
    text: "Island of heather, sheltered in the bay between Dungloe and Burtonport. Once home to farmers and fishermen; now visited for its peace.",
    src: "/photos/discover-island-free.jpg", srcPos: "50% 50%",
    credit: "Donegal County Council", creditUrl: "",
  },
  {
    name: "Inishirrer",
    irish: "Inis Oirthir",
    ferry: "Gweedore coast · short crossing",
    drive: "45 min from CFN",
    text: "The Eastern Island — long and narrow, off the Gweedore coast. Its islanders were famed throughout Donegal for seamanship and rowing.",
    src: "/photos/discover-island-irrer.jpg", srcPos: "50% 50%",
    credit: "Joseph Mischyshyn", creditUrl: "https://www.geograph.ie/photo/1173028",
  },
  {
    name: "Inishkerragh",
    irish: "Inis Caorach",
    ferry: "Burtonport · short crossing",
    drive: "40 min from CFN",
    text: "Sheep Island — a tiny flat islet in Boylagh Bay, just 650 m long. One of the most sheltered of the Rosses archipelago.",
    src: "/photos/discover-island-kerragh.jpg", srcPos: "50% 50%",
    credit: "Donegal County Council", creditUrl: "",
  },
  {
    name: "Inishtrahull",
