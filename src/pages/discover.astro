    src: "/photos/discover-island-inishtrahull.jpg", srcPos: "71% 52%",
    credit: "", creditUrl: "",
  },
  {
    name: "Island Roy",
    irish: "Oileán Ruaidh",
    ferry: "Downings · short crossing",
    drive: "60 min from CFN",
    text: "A quiet islet in the sheltered waters of Mulroy Bay, near Downings. Calm tidal channels, birdlife, and some of the most still water in Donegal.",
