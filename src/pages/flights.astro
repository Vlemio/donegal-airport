---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Flights · Donegal Airport";
const description = "Live arrivals and departures, full timetable, carrier information and check-in for Donegal Airport (CFN).";
---

<BaseLayout title={title} description={description} pageTheme="ops-theme">
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-40">
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-atlantic">
      Flights
    </p>
    <h1
      data-split
      class="mt-4 max-w-4xl font-display text-[clamp(2.5rem,6vw,5.5rem)] font-normal leading-[0.98]"
    >
      Live arrivals and departures.
    </h1>
    <p class="mt-7 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">
      Aer Lingus Regional to Dublin · Loganair to Glasgow (weekends).
      Full timetable, baggage allowances, cut-offs.
    </p>

    <div data-animate="fade-up" class="mt-16 border-t border-line pt-10">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-mute">
        Coming next
      </p>
      <p class="mt-4 max-w-2xl font-display text-2xl leading-snug text-ink">
        Live board · timetable by carrier · baggage rules · student fare.
      </p>
    </div>
  </section>
</BaseLayout>
