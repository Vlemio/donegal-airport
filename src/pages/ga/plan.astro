---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Pleanáil do thuras · Aerfort Dhún na nGall";
const description = "Conas teacht anseo, páirceáil, cíos gluaisteán, tacsaithe, inrochtaineacht (PRM) agus slándáil ag Aerfort Dhún na nGall (CFN).";

const carHire = [
  {
    name: "Enterprise",
    details: ["Aois 25+", "Bailiú agus fágáil ag an teirminéal", "Gnó agus fóillíocht", "+353 74 910 3202"],
    website: "https://www.enterprise.ie/en/car-hire-locations/ie/donegal-airport-i128.html",
    bg: "#089759",
    logo: "/photos/plan/cars/logo-enterprise-white.png",
    car: "/photos/plan/cars/car-enterprise.png",
    roof: "/photos/plan/cars/logo-enterprise-white.png",
    side: "left", logoW: 54, logoLeft: 44,
    cardH: 230, logoPct: 31,
  },
  {
    name: "Yuko Car Rental",
    details: ["Aois 22–70", "Flít Toyota — lámhrothar agus uathoibríoch", "Cuir in áirithe ar líne tríd an aip Yuko", "Luan–Sath 06:30–20:00", "Domh 08:00–20:00", "+353 74 912 1385"],
    website: "https://letterkenny.kellystoyota.com/car-rentals-at-kellys-toyota",
    bg: "#E62334",
    logo: "/photos/plan/cars/logo-yuko-decal.png",
    car: "/photos/plan/cars/car-yuko.png",
    roof: "/photos/plan/cars/logo-yuko-decal.png",
    side: "right", logoW: 38, logoLeft: 56,
    cardH: 230, logoPct: 37,
  },
  {
    name: "Europcar",
    details: ["07:30–20:30 gach lá", "Réamh-áirithint do sliotáin 07:30–09:00", "10% lascaine ar áirithintí díreacha", "+353 74 970 7000", "+353 86 199 1651 — tar éis am oscailte"],
    website: "https://www.europcar.ie/en-ie/places/car-rental-ireland/carrickfinn/donegal-airport",
    bg: "#009B01",
    logo: "/photos/plan/cars/logo-europcar-white.png",
    car: "/photos/plan/cars/car-europcar.png",
    roof: "/photos/plan/cars/logo-europcar-white.png",
    side: "left", logoW: 44, logoLeft: 43,
    cardH: 230, logoPct: 10,
  },
  {
    name: "GoCar",
    details: ["Cíos uaire", "Breosla agus árachas san áireamh", "Solúbtha — gan gealltanas", "fadtéarmach"],
    website: "https://www.gocar.ie/",
    bg: "#8DC73F",
    logo: "/photos/plan/cars/logo-gocar-white.png",
    car: "/photos/plan/cars/car-gocar.png",
    roof: "/photos/plan/cars/logo-gocar-white.png",
    side: "right", logoW: 38, logoLeft: 56,
    cardH: 230, logoPct: 40,
  },
] as const;

const tariff = [
  { d: "2 uair", p: "Saor in aisce" },
  { d: "1 lá",   p: "€7" },
  { d: "2 lá",  p: "€14" },
  { d: "3 lá",  p: "€21" },
  { d: "4 lá",  p: "€28" },
  { d: "5 lá",  p: "€35" },
  { d: "6 lá",  p: "€39" },
  { d: "7 lá",  p: "€45", best: true },
  { d: "8 lá",  p: "€45", best: true },
  { d: "9 lá",  p: "€45", best: true },
  { d: "10 lá", p: "€45", best: true },
  { d: "11 lá", p: "€50" },
  { d: "12 lá", p: "€54" },
  { d: "13 lá", p: "€58" },
  { d: "14 lá", p: "€60" },
  { d: "15+ lá", p: "€4/lá" },
] as const;

const tariffLeft = tariff.slice(0, 8);
const tariffRight = tariff.slice(8);

const taxis = [
  { name: "Jackie Hughes Airport Transfers", phone: "087 261 8885", href: "tel:+353872618885" },
  { name: "Josie Joe / Larsson Cabs",        phone: "087 653 6272", href: "tel:+353876536272" },
  { name: "Charlie Mac Taxis",               phone: "087 260 3757", href: "tel:+353872603757" },
  { name: "Teague Taxis",                    phone: "087 641 5985", href: "tel:+353876415985" },
  { name: "Frank Gallagher",                 phone: "086 821 5936", href: "tel:+353868215936" },
  { name: "Packie Gallagher",                phone: "087 261 5625", href: "tel:+353872615625" },
  { name: "James Rodgers",                   phone: "086 809 3561", href: "tel:+353868093561" },
  { name: "Martin McGlynn",                  phone: "087 259 6521", href: "tel:+353872596521" },
] as const;

const transfers = [
  { name: "Cronan Mac Buses",          phone: "087 237 8888", href: "tel:+353872378888", note: "Aistrithe do ghrúpaí móra agus cóistí" },
  { name: "Turas Cartha · Nicola Doherty", phone: "087 055 6708", href: "tel:+353870556708", note: "Suas le 8 · turais agus corparáideach" },
  { name: "Donegal Tour Guide · Henry Doohan", phone: "086 333 1031", href: "tel:+353863331031", note: "Tiománaí príobháideach · turais agus corparáideach" },
] as const;

const cardTints = [
  { bg: "bg-[color-mix(in_srgb,var(--color-atlantic)_10%,var(--color-surface))]", hover: "hover:bg-[var(--color-atlantic)]" },
  { bg: "bg-[color-mix(in_srgb,var(--color-sand)_13%,var(--color-surface))]",     hover: "hover:bg-[var(--color-sand)]" },
];

const coffees = [
  { name: "Flat White",  desc: "Ristretto dúbailte faoi bhainne galaithe síodúil. Gan chúr, gan trioblóid.",   img: "/photos/plan/coffees/cup-flatwhite.png" },
  { name: "Cappuccino",  desc: "Espresso, bainne galaithe agus barr cúir domhain, cócó dusta air.",  img: "/photos/plan/coffees/cup-cappuccino.png" },
  { name: "Americano",   desc: "Deoch espresso scaoilte le huisce te. Fada, dubh agus éasca.", img: "/photos/plan/coffees/cup-americano.png" },
  { name: "Latte",       desc: "Bainne galaithe doirte ar espresso — cúr, leis an gcaife thíos.",  img: "/photos/plan/coffees/cup-latte.png" },
];

// Local Link bus times at Donegal Airport. Each pair is depart → arrive.
// "ms: true" = Mon–Sat only; all other trips run daily (incl. Sun & public holidays).
// Place names use their Irish forms — An Fál Carrach (Falcarragh), Croithlí
// (Crolly), An Clochán Liath (Dungloe) — matching the route-info line below.
const busToAirport = [
  { place: "An Fál Carrach", route: "966", pairs: [
    { dep: "06:20", arr: "07:15", ms: true },
    { dep: "11:00", arr: "11:55" },
    { dep: "16:10", arr: "17:05" },
    { dep: "19:50", arr: "20:45" },
  ] },
  { place: "Croithlí", route: "992", pairs: [
    { dep: "14:50", arr: "15:05", ms: true, demand: true },
  ] },
  { place: "An Clochán Liath", route: "966", pairs: [
    { dep: "08:50", arr: "09:25", ms: true },
    { dep: "12:50", arr: "13:25" },
    { dep: "14:10", arr: "14:45" },
    { dep: "18:10", arr: "18:45" },
    { dep: "21:30", arr: "22:05" },
  ] },
] as const;

const busFromAirport = [
  { place: "An Fál Carrach", route: "966", pairs: [
    { dep: "09:25", arr: "10:20", ms: true },
    { dep: "13:25", arr: "15:40" },
    { dep: "14:45", arr: "15:40" },
    { dep: "18:45", arr: "19:40" },
    { dep: "22:05", arr: "23:00" },
  ] },
  { place: "Croithlí", route: "992", pairs: [
    { dep: "13:55", arr: "14:10", ms: true, demand: true },
  ] },
  { place: "An Clochán Liath", route: "966", pairs: [
    { dep: "07:15", arr: "07:50", ms: true },
    { dep: "11:55", arr: "12:30" },
    { dep: "17:05", arr: "17:40" },
    { dep: "20:45", arr: "21:20" },
  ] },
] as const;

const busColumns = [
  { title: "Go dtí an t-aerfort", sub: "imeacht → teacht ag an aerfort", legs: busToAirport },
  { title: "Ón aerfort", sub: "imeacht ón aerfort → teacht", legs: busFromAirport },
] as const;
---

<BaseLayout title={title} description={description}>

  {/* ─── HERO ── mirrors plan.astro (EN) section-for-section ─────────────── */}
  <section class="relative isolate flex min-h-[80vh] w-full items-end overflow-hidden border-b border-line">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/photos/plan/plan-checkin-hero.jpg"
        alt="Deasc seiceála isteach in theirminéal Aerfort Dhún na nGall"
        class="h-full w-full object-cover object-[center_30%]"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="cfn-hero-content relative z-10 mx-auto w-full max-w-7xl px-6 pb-16 pt-40 sm:pb-24">
      <p
        data-animate="fade-up"
        class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.32em] text-white [text-shadow:0_1px_10px_rgba(0,0,0,.6)]"
      >
        Pleanáil do thuras · CFN
      </p>
      <h1
        data-split
        data-split-delay="0.1"
        class="mt-8 max-w-5xl font-display text-[clamp(2.75rem,7vw,7.5rem)] font-light leading-[0.95] text-ink [text-shadow:0_2px_24px_rgba(0,0,0,.55),0_1px_6px_rgba(0,0,0,.4)]"
      >
        Gach rud a theastaíonn uait<br/>sula n-eitlíonn tú.
      </h1>
      <p
        data-animate="fade-up"
        data-animate-delay="0.35"
        class="mt-10 max-w-2xl text-base font-semibold leading-relaxed text-white sm:text-lg [text-shadow:0_1px_10px_rgba(0,0,0,.5)]"
      >
        Conas teacht anseo, páirceáil, iompar, amanna seiceála isteach,
        cúnamh speisialta agus a bhfuil sa teirminéal — uilig in aon áit
        amháin.
      </p>
    </div>
  </section>

  {/* ─── PARKING ── ────────────────────────────────────── */}
  <section class="relative isolate border-t border-line bg-[#090f1c] sm:bg-transparent">
    {/* Below sm, pinned to a fixed height at the top instead of stretching the
        full section (inset-0) — otherwise expanding the tariff panel grows
        the section, and object-cover rescales/"zooms" the photo to match.
        Desktop is unchanged (sm:inset-0 restores it). initParkingBg() grows
        this past the 88vh starting guess to match the actual closed-state
        content height, which can run taller on a real phone. */}
    <div id="parking-bg" class="absolute inset-x-0 top-0 -z-10 h-[88vh] sm:inset-0 sm:h-auto" aria-hidden="true">
      <img
        src="/photos/plan/plan-parking-aerial.jpg"
        alt="Radharc aeriúil ar theirminéal Aerfort Dhún na nGall agus a charrchlós in aice leis an rúidbhealach"
        class="h-full w-full object-cover object-center"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div id="parking-content" class="cfn-hero-content mx-auto flex min-h-[88vh] max-w-7xl flex-col justify-between gap-y-16 px-6 pb-14 pt-24">
      <div>
        <p
          data-animate="fade-up"
          class="font-mono text-base font-bold uppercase tracking-[0.3em] text-white [text-shadow:0_1px_10px_rgba(0,0,0,.6)]"
        >
          Páirceáil
        </p>
        <h2
          data-split
          class="mt-3 font-display text-[clamp(2.4rem,4.5vw,4.2rem)] font-normal leading-[1.02] text-white [text-shadow:0_2px_22px_rgba(0,0,0,.6)]"
        >
          Páirceáil agus siúil isteach díreach.
        </h2>
        <p
          data-animate="fade-up"
          data-animate-delay="0.08"
          class="mt-5 max-w-xl text-[1.05rem] font-medium leading-relaxed text-white [text-shadow:0_1px_14px_rgba(0,0,0,.75)]"
        >
          Tá an carrchlós díreach os comhair an teirminéil — siúlóid nóiméad
          amháin ón gcarrchlós go dtí an seiceáil isteach. Íoc trí mheaisín
          (airgead tirim nó cárta) nó tapáil gan teagmháil ag an mbacainn
          imeachta.
        </p>
      </div>

      <div>
        <div
          id="parking-figures"
          class="grid gap-px overflow-hidden rounded-xl bg-white/15 sm:grid-cols-3"
        >
          <div class="bg-black/30 p-8 backdrop-blur-sm sm:col-start-1 sm:row-start-1">
            <div data-animate="fade-up">
              <p class="font-display text-[3.2rem] leading-none text-white">2 u</p>
              <p class="mt-3 font-mono text-[0.82rem] font-bold uppercase tracking-[0.2em] text-white/90">Saor in aisce</p>
              <p class="mt-2 text-sm leading-relaxed text-white/75">
                An chéad dhá uair saor in aisce — fág, bailigh, nó suigh
                isteach le haghaidh caife.
              </p>
            </div>
          </div>
          <div class="flex flex-col bg-black/30 p-8 backdrop-blur-sm sm:col-start-2 sm:row-start-1">
            <div data-animate="fade-up" data-animate-delay="0.08">
              <p class="font-display text-[3.2rem] leading-none text-white">Fanacht Fada</p>
              <p class="mt-3 font-mono text-[0.82rem] font-bold uppercase tracking-[0.2em] text-white/90">Ó €7 / lá</p>
              <p class="mt-2 text-sm leading-relaxed text-white/75">
                €45 do 7–10 lá · €60 do choicís, ansin €4/lá.
              </p>
              <button
                type="button"
                data-tariff-toggle
                aria-expanded="false"
                aria-controls="tariff-panel"
                class="mt-4 inline-flex w-fit items-center gap-1.5 font-mono text-[0.7rem] font-bold uppercase tracking-[0.18em] text-white underline decoration-white/40 underline-offset-4 transition-opacity hover:opacity-70"
              >
                <span data-tariff-label>Taispeáin an táille iomlán</span>
                <span data-tariff-arrow>↓</span>
              </button>
            </div>
          </div>

          {/* Collapsible full tariff — lives right after the Long Stay card
              (not after the whole grid) so below sm, where the grid stacks
              to one column, it opens directly under the card that triggered
              it instead of under EV at the bottom. sm:col-span-3 spans the
              full row again once the grid becomes 3 columns. */}
          <div
            id="tariff-panel"
            class="overflow-hidden transition-[max-height,opacity] duration-500 ease-out sm:col-start-1 sm:col-span-3 sm:row-start-2"
            style="max-height: 0; opacity: 0;"
          >
            <div class="mt-3 rounded-xl bg-black/45 p-8 backdrop-blur-md">
              <div class="flex items-baseline justify-between">
                <p class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.25em] text-white/90">Táille iomlán an charrchlóis</p>
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.15em] text-white/55">Íoc ag an imeacht</p>
              </div>

              <div class="mt-5 grid grid-cols-1 gap-x-12 sm:grid-cols-2">
                <ul class="divide-y divide-white/10">
                  {tariffLeft.map((t) => (
                    <li class={`flex items-center justify-between py-1.5 ${t.best ? "text-white" : "text-white/80"}`}>
                      <span class={`text-sm ${t.best ? "font-semibold" : ""}`}>{t.d}</span>
                      <span class={`font-mono text-sm ${t.best ? "font-semibold text-white" : "text-white/80"}`}>{t.p}</span>
                    </li>
                  ))}
                </ul>
                <ul class="divide-y divide-white/10">
                  {tariffRight.map((t) => (
                    <li class={`flex items-center justify-between py-1.5 ${t.best ? "text-white" : "text-white/80"}`}>
                      <span class={`text-sm ${t.best ? "font-semibold" : ""}`}>
                        {t.d}
                        {t.d === "10 lá" && (
                          <span class="ml-2 rounded-full bg-white/15 px-2 py-0.5 font-mono text-[0.5rem] font-bold uppercase tracking-[0.12em] text-white">
                            Luach is fearr
                          </span>
                        )}
                      </span>
                      <span class={`font-mono text-sm ${t.best ? "font-semibold text-white" : "text-white/80"}`}>{t.p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-black/30 p-8 backdrop-blur-sm sm:col-start-3 sm:row-start-1">
            <div data-animate="fade-up" data-animate-delay="0.16">
              <p class="font-display text-[3.2rem] leading-none text-white">EV</p>
              <p class="mt-3 font-mono text-[0.82rem] font-bold uppercase tracking-[0.2em] text-white/90">4 × luchtaire 22 kW</p>
              <p class="mt-2 text-sm leading-relaxed text-white/75">
                Pointí luchtaithe EVBox sa charrchlós. Rochtain tríd an aip EVBox.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── CHECK-IN & BAGGAGE ── ──────────────────────────── */}
  <section id="checkin" class="scroll-mt-[calc(var(--header-h)+2rem)] border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">

        <div>
          <p
            data-animate="fade-up"
            class="font-mono text-base font-bold uppercase tracking-[0.3em] text-atlantic"
          >
            Seiceáil isteach agus bagáiste
          </p>
          <h2
            data-split
            class="mt-3 font-display text-[clamp(1.8rem,3.5vw,3rem)] font-normal leading-[1.02]"
          >
            Bí ar an eolas faoi na spriocamanna.
          </h2>

          <div data-animate="fade-up" data-animate-delay="0.1" class="mt-10">
            <div class="relative mt-2">
              <div class="absolute left-[12%] right-[12%] top-[6px] h-px bg-line" aria-hidden="true"></div>
              <div class="relative grid grid-cols-3 text-center">
                <div class="flex flex-col items-center">
                  <span class="h-3 w-3 rounded-full bg-sand"></span>
                  <p class="mt-5 font-display text-[clamp(2.4rem,5vw,3.6rem)] leading-none text-sand">45</p>
                  <p class="mt-2 font-mono text-[0.72rem] font-bold uppercase tracking-[0.18em] text-atlantic">nóim. roimh ré</p>
                  <p class="mt-1 text-sm text-ink">Dúnann fágáil bagáiste</p>
                </div>
                <div class="flex flex-col items-center">
                  <span class="h-3 w-3 rounded-full bg-sand"></span>
                  <p class="mt-5 font-display text-[clamp(2.4rem,5vw,3.6rem)] leading-none text-sand">30</p>
                  <p class="mt-2 font-mono text-[0.72rem] font-bold uppercase tracking-[0.18em] text-atlantic">nóim. roimh ré</p>
                  <p class="mt-1 text-sm text-ink">Slándáil agus geata</p>
                </div>
                <div class="flex flex-col items-center">
                  <span class="h-3 w-3 rounded-full bg-atlantic"></span>
                  {/* A plain "✈" text glyph renders as a full-colour emoji picture
                     (e.g. blue, ignoring text colour) depending on the OS/browser's
                     emoji font — an SVG (Material Design Icons "airplane-takeoff",
                     bar removed) renders identically everywhere, in the same
                     atlantic blue as the "take-off" label and the dot above it.
                     Size is editable live at ?edit — see initTakeoffIconEditor(). */}
                  <p class="mt-4 flex h-[clamp(2.4rem,5vw,3.6rem)] items-center justify-center text-atlantic">
                    <svg id="takeoff-icon" viewBox="0.8 2.5 21.5 14.5" fill="currentColor" class="h-10 w-auto" aria-hidden="true">
                      <path d="M22.07 9.64c-.21-.8-1.04-1.28-1.84-1.06L14.92 10L8 3.57l-1.91.51l4.14 7.17l-4.97 1.33l-1.97-1.54l-1.45.39l1.82 3.16l.77 1.33l1.6-.42l5.31-1.43l4.35-1.16L21 11.5c.81-.24 1.28-1.06 1.07-1.86" />
                    </svg>
                  </p>
                  <p class="mt-2 font-mono text-[0.72rem] font-bold uppercase tracking-[0.18em] text-atlantic">eitilt</p>
                  <p class="mt-1 text-sm text-ink">Imeacht</p>
                </div>
              </div>
            </div>
          </div>

          <dl data-animate="fade-up" data-animate-delay="0.15" class="mt-12 divide-y divide-line border-y border-line">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.16em] text-atlantic">Bagáiste cábáin · Aer Lingus Regional</dt>
              <dd class="basis-full text-sm text-ink">San áireamh sa bhagáiste seiceáilte de réir réamhshocraithe — costaíonn <span class="font-medium">10 kg</span> sa chábán breis: réamh-áirithint ar líne, nó <span class="font-medium">€35</span> ag an aerfort</dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.16em] text-atlantic">Osclaíonn seiceáil isteach ar líne</dt>
              <dd class="text-sm text-ink">Aer Lingus <span class="font-medium">48u</span> · Loganair <span class="font-medium">96u</span></dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.16em] text-atlantic">Cúnamh speisialta · PRM</dt>
              <dd class="text-sm text-ink">Socraigh le d'aerlíne <span class="font-medium">48u</span> roimh ré</dd>
            </div>
          </dl>

          <div data-animate="fade-up" data-animate-delay="0.2" class="mt-10">
            <p class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.16em] text-atlantic">Ag nascadh ar aghaidh trí Bhaile Átha Cliath</p>
            <p class="mt-2 text-sm text-ink">
              Bí i láthair <span class="font-medium">1u 30</span> roimh d'eitilt go Dún na nGall — ansin braitheann sé ar do bhagáiste:
            </p>
            <dl class="mt-4 divide-y divide-line border-y border-line">
              <div class="py-4">
                <dt class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.14em] text-sand">Bagáiste cábáin amháin</dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink">Conair na Nasceitiltí díreach go dtí do gheata — gan slándáil ná inimirce arís.</dd>
              </div>
              <div class="py-4">
