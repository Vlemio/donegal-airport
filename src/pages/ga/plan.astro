<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Mobile: the desktop "cars drive in" animation is gated behind md: (see
  // the md:opacity-0 class on .ch-card) — below that breakpoint the cards
  // showed at full opacity immediately, with no entrance of their own.
  // Give them a simple staggered fade-up instead, matching the rest of the
  // page's reveals.
  function initCarHireMobileReveal() {
    if (window.matchMedia("(min-width: 768px)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const cards = [...document.querySelectorAll("#car-hire-grid .ch-card")];
    if (!cards.length) return;
    gsap.fromTo(
      cards,
      { opacity: 0, y: 28 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
        stagger: 0.12,
        scrollTrigger: { trigger: "#car-hire-grid", start: "top 88%", once: true },
      },
    );
  }

  // Mobile café menu rows had no entrance of their own either — same
  // staggered fade-up treatment as the car hire cards above.
  function initCafeMobileListReveal() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const list = document.getElementById("cafe-mobile-list");
    if (!list) return;
    const rows = [...list.children];
    if (!rows.length) return;
    gsap.fromTo(
      rows,
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power3.out",
        stagger: 0.1,
        scrollTrigger: { trigger: list, start: "top 88%", once: true },
      },
    );
  }

  // ── Car hire: branded cars drive in from the sides and become their cards ──
  function initCarHireDrive() {
    const track = document.getElementById("ch-track");
    const stage = document.getElementById("ch-stage");
    const grid  = document.getElementById("car-hire-grid");
    const canvas = document.getElementById("ch-trail");
    if (!track || !stage || !grid || !canvas) return;
    const ctx = canvas.getContext("2d");
    const cardEls = [...grid.querySelectorAll(".ch-card")];
    const carEls  = [...stage.querySelectorAll(".ch-car")];
    if (!cardEls.length || !carEls.length) return;

    const isMobile = () => window.matchMedia("(max-width: 767px)").matches;
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const easeOutCubic = t => 1 - Math.pow(1 - t, 3);
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let cars = [], W = 0, H = 0, enabled = false;

    function hideCards() { cardEls.forEach(c => { c.style.opacity = "0"; }); }
    function showCards() { cardEls.forEach(c => { c.style.opacity = ""; }); }

    function measure() {
      if (isMobile()) {
        enabled = false;
        showCards();
        carEls.forEach(c => { c.style.opacity = "0"; });
        if (ctx) ctx.clearRect(0, 0, W, H);
        return;
      }
      enabled = true;
      W = stage.clientWidth; H = stage.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const sRect = stage.getBoundingClientRect();
      cars = carEls.map(el => {
        const i = +el.dataset.idx;
        const side = el.dataset.side;
        const body = el.querySelector(".ch-car-body");
        const carW = body.offsetWidth || 200;
        const carH = el.offsetHeight || carW * 0.66;
        const card = cardEls.find(c => +c.dataset.idx === i);
        const cR = card.getBoundingClientRect();
        const cx = cR.left - sRect.left + cR.width / 2;
        const cy = cR.top - sRect.top + cR.height / 2;
        const startX = side === "left" ? -carW - 60 : W + 60;
        const dir = side === "left" ? 1 : -1;
        el.style.opacity = "1";
        return { el, card, side, carW, carH, cy, startX, endX: cx - carW / 2, dir, i };
      });
      hideCards();
      render();
    }

    function render() {
      if (!enabled) return;
      const r = track.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = r.height - vh;
      const startPx = vh * 0.65;
      const endPx = total > 0 ? -total * 0.65 : -vh * 0.9;
      const p = clamp((startPx - r.top) / (startPx - endPx), 0, 1);
      const cf = clamp((p - 0.8) / 0.2, 0, 1);
      const DWIN = [[0.00, 0.60], [0.06, 0.66], [0.32, 0.80], [0.40, 0.80]];
      ctx.clearRect(0, 0, W, H);
      cars.forEach(c => {
        const win = DWIN[c.i] || [0, 0.8];
        const drive = clamp((p - win[0]) / (win[1] - win[0]), 0, 1);
        const x = c.startX + (c.endX - c.startX) * easeOutCubic(drive);
        c.el.style.transform = `translate(${x}px, ${c.cy - c.carH / 2}px)`;
        c.el.style.opacity = String(1 - cf);
        c.card.style.opacity = String(cf);
        if (cf < 1) {
          const carCx = x + c.carW / 2;
          const rearX = carCx - c.dir * c.carW * 0.30;
          const edgeX = c.dir > 0 ? 0 : W;
          const grad = ctx.createLinearGradient(edgeX, 0, rearX, 0);
          grad.addColorStop(0, "rgba(24,29,22,0)");
          grad.addColorStop(1, `rgba(24,29,22,${0.18 * (1 - cf)})`);
          ctx.strokeStyle = grad; ctx.lineWidth = 4; ctx.lineCap = "round";
          const dy = c.carH * 0.16;
          [c.cy - dy, c.cy + dy].forEach(y => { ctx.beginPath(); ctx.moveTo(edgeX, y); ctx.lineTo(rearX, y); ctx.stroke(); });
        }
      });
    }

    measure();
    function loop() { render(); requestAnimationFrame(loop); }
    requestAnimationFrame(loop);
    let rt;
    window.addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(measure, 200); });
    window.addEventListener("load", measure);
  }

  // Below sm the parking background photo is pinned to a fixed height
  // (see the JSX comment above #parking-bg) so opening the tariff panel
  // doesn't rescale it. That fixed height starts as a plain 88vh guess,
  // which real phones can exceed once the three stacked figure cards wrap
  // their text — grow the photo to match the actual closed-state content
  // height (never shrink below the 88vh floor) so it always reaches the
  // bottom of the last card instead of running out partway down.
  function initParkingBg() {
    const bg = document.getElementById("parking-bg");
    const content = document.getElementById("parking-content");
    if (!bg || !content) return;

    // Breakpoint re-checked INSIDE sync() on every call — see plan.astro
    // (EN) for why: an inline style always wins over a class-based sm:
    // breakpoint, so a visitor who loaded below 640px and then widened the
    // window got stuck with a stale mobile pixel height fighting desktop.
    const sync = () => {
      if (window.matchMedia("(min-width: 640px)").matches) {
        bg.style.height = ""; // hand back control to the sm:h-auto CSS rule
        return;
      }
      const floorPx = window.innerHeight * 0.88;
      const neededPx = content.getBoundingClientRect().height;
      bg.style.height = Math.max(floorPx, neededPx) + "px";
    };
    sync();
    window.addEventListener("resize", sync);
  }

  function initTariffPanel() {
    const panel = document.getElementById("tariff-panel");
    const btn = document.querySelector("[data-tariff-toggle]");
    if (!panel || !btn) return;
    const label = btn.querySelector("[data-tariff-label]");
    const arrow = btn.querySelector("[data-tariff-arrow]");
    let open = false;

    const setState = () => {
      if (open) {
        panel.style.maxHeight = panel.scrollHeight + "px";
        panel.style.opacity = "1";
        btn.setAttribute("aria-expanded", "true");
        if (label) label.textContent = "Folaigh an táille iomlán";
        if (arrow) arrow.textContent = "↑";
      } else {
        panel.style.maxHeight = "0";
        panel.style.opacity = "0";
        btn.setAttribute("aria-expanded", "false");
        if (label) label.textContent = "Taispeáin an táille iomlán";
        if (arrow) arrow.textContent = "↓";
      }
    };

    btn.addEventListener("click", () => { open = !open; setState(); });
    window.addEventListener("resize", () => { if (open) panel.style.maxHeight = panel.scrollHeight + "px"; });
  }

  // The `autoplay` attribute alone silently fails on some mobile browsers
  // (iOS Low Power Mode, or the page not yet counted as "engaged" at the
  // moment the video would start) with no error and no visual sign why —
  // it just sits on the poster frame. Re-attempt .play() once the element
  // is actually in view; still muted, so it stays within autoplay policy.
  function initCafeVideo() {
    const video = document.getElementById("cafe-video");
    if (!video || !(video instanceof HTMLVideoElement)) return;
    if (!video.paused) return;

    const tryPlay = () => { video.play().catch(() => {}); };
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) tryPlay(); });
    }, { threshold: 0.25 });
    obs.observe(video);
  }

  function initCafeCoffee() {
    const track = document.getElementById("cafe-track");
    const stage = document.getElementById("cafe-stage");
    const wrap  = document.getElementById("cafe-groups");
    const textEl = document.getElementById("cafe-text");
    const nameEl = document.getElementById("cafe-name");
    const descEl = document.getElementById("cafe-desc");
    const outroEl = document.getElementById("cafe-outro");
    const dataEl = document.getElementById("cafe-data");
    if (!track || !stage || !wrap || !textEl || !dataEl) return;
    let COFFEES;
    try { COFFEES = JSON.parse(dataEl.textContent || "[]"); } catch { return; }
    if (!COFFEES.length) return;

    const N = COFFEES.length;
    const BEAN = "/photos/plan/coffees/bean.png";
    const M_BEANS = 8, HOLD = 0.26, SPIN = 190, GAP = 0.06;
    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const smooth = t => t*t*(3 - 2*t);
    const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;

    const groups = COFFEES.map(c => {
      const g = document.createElement("div"); g.className = "cafe-group";
      const cup = document.createElement("img"); cup.className = "cafe-cup"; cup.src = c.img; cup.alt = "";
      g.appendChild(cup);
      const beans = [];
      const half = M_BEANS/2;
      for (let j = 0; j < M_BEANS; j++) {
        const b = document.createElement("img"); b.className = "cafe-bean"; b.src = BEAN; b.alt = "";
        const side = (j < half) ? -1 : 1;
        const k = (side < 0) ? j : j - half;
        let ang;
        if (side < 0) {
          ang = -Math.PI/2 + ((k/(half-1)) - 0.5)*1.9 + (Math.random()-0.5)*0.25;
        } else {
          const lr = (k % 2 === 0) ? 1 : -1;
          const tier = Math.floor(k/2);
          ang = Math.PI/2 + lr*(0.95 + tier*0.45 + (Math.random()-0.5)*0.2);
        }
        const rt = 0.58 + Math.random()*0.34;
        const tx = Math.cos(ang)*rt, ty = Math.sin(ang)*rt;
        const startMul = 2.2 + Math.random()*1.0;
        const sp = Math.random()*360;
        const tw = (50 + Math.random()*150) * (Math.random() < 0.5 ? -1 : 1);
        g.appendChild(b);
        beans.push({ el:b, side, tx, ty, startMul, sp, tw });
      }
      wrap.appendChild(g);
      return { g, cup, beans };
    });

    function spinDeg(d) {
      if (d <= -HOLD) return (d + HOLD)/(1 - HOLD) * SPIN;
      if (d >=  HOLD) return (d - HOLD)/(1 - HOLD) * SPIN;
      return 0;
    }
    function beanPresence(d, side) {
      const dC    = side < 0 ?  0.02 : -0.18;
      const halfW = side < 0 ?  0.52 :  0.62;
      return clamp(1 - Math.abs((d - dC)/halfW), 0, 1);
    }

    function render() {
      if (!isDesktop()) return;
      const r = track.getBoundingClientRect();
      const total = track.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const p = clamp(-r.top / total, 0, 1);

      const W = stage.clientWidth, H = stage.clientHeight;
      if (!W || !H) return;
      const cupSize = Math.min(H*0.40, W*0.50);
      const beanSize = cupSize*0.13;
      const R  = Math.min(W*0.64, H*0.40);
      const cx = W, cy = H*0.46, centreX = cx - R;

      const segLen = 1/N;
      let centreIdx = 0, centreVal = 0;

      groups.forEach((grp, i) => {
        const lp = ((p - i*segLen)/segLen - GAP)/(1 - 2*GAP);
        if (lp < 0 || lp > 1) { grp.g.style.opacity = "0"; return; }
        grp.g.style.opacity = "1";

        const d = (lp < 0.5) ? (-1 + lp/0.5) : ((lp - 0.5)/0.5);
        const ad = Math.abs(d);

        const centred = clamp(1 - ad/0.5, 0, 1);
        if (centred > centreVal) { centreVal = centred; centreIdx = i; }

        const th = d * Math.PI/2;
        const x = cx - R*Math.cos(th);
        const y = cy + R*Math.sin(th);
        grp.g.style.transform = `translate(${x}px, ${y}px)`;

        const cupOp = clamp((0.94 - ad)/0.2, 0, 1);
        grp.cup.style.width = cupSize+"px";
        grp.cup.style.opacity = String(cupOp);
        grp.cup.style.transform = `translate(-50%,-50%) rotate(${spinDeg(d)}deg)`;

        grp.beans.forEach(b => {
          const pres = beanPresence(d, b.side);
          const gather = smooth(pres);
          const bx = b.tx*cupSize;
          const by = b.ty*cupSize*gather + b.side*b.startMul*cupSize*(1 - gather);
          const rot = b.sp + (1 - gather)*b.tw;
          b.el.style.width = beanSize+"px";
          b.el.style.opacity = String(clamp(pres/0.4, 0, 1));
          b.el.style.transform = `translate(${bx}px, ${by}px) translate(-50%,-50%) rotate(${rot}deg)`;
        });
      });

      if (nameEl) nameEl.textContent = COFFEES[centreIdx].name;
      if (descEl) descEl.textContent = COFFEES[centreIdx].desc;
      textEl.style.opacity = String(centreVal);
      textEl.style.transform =
        `translate(${centreX}px, ${cy + cupSize*0.66 + (1-centreVal)*16}px) translate(-50%,0)`;

      if (outroEl) {
        const outro = clamp((p - 0.90)/0.06, 0, 1);
        outroEl.style.opacity = String(outro);
        outroEl.style.transform =
          `translate(${W/2}px, ${cy}px) translate(-50%,-50%) translateY(${(1-outro)*22}px)`;
      }
    }

    function loop() { render(); requestAnimationFrame(loop); }
    requestAnimationFrame(loop);
  }

  document.addEventListener("astro:page-load", () => {
    initCarHireDrive();
    initCarHireMobileReveal();
    initParkingBg();
    initTariffPanel();
    initCafeCoffee();
    initCafeVideo();
    initCafeMobileListReveal();
  });
</script>

<style is:global>
  .cafe-name { font-family: "Playfair Display", Georgia, serif; font-style: italic; font-weight: 600; }

  #cafe-groups { position: absolute; inset: 0; pointer-events: none; }
  .cafe-group { position: absolute; left: 0; top: 0; }
  .cafe-cup {
    position: absolute; left: 0; top: 0; max-width: none; transform-origin: center;
    will-change: transform, opacity;
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.26));
  }
  .cafe-bean {
    position: absolute; left: 0; top: 0; max-width: none; transform-origin: center;
    will-change: transform, opacity;
    filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.25));
  }
  #cafe-text {
    position: absolute; left: 0; top: 0; width: 62%; text-align: center;
    opacity: 0; pointer-events: none; will-change: transform, opacity;
  }
  #cafe-outro {
    position: absolute; left: 0; top: 0; width: 68%; text-align: center;
    opacity: 0; pointer-events: none; will-change: transform, opacity;
  }
</style>

</BaseLayout>
