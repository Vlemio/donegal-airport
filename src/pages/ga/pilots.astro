          </div>
        </div>
        <p class="mt-4 font-mono text-[0.72rem] font-bold uppercase tracking-[0.14em] text-ink">Scéimreach · gan a bheith ar scála — seiceáil léarscáil dróin an <a href="https://www.iaa.ie/general-aviation/drones/uas-geographic-zones" target="_blank" rel="noopener" class="text-atlantic underline hover:text-ink">IAA</a> i gcónaí le haghaidh na dteorainneacha beachta</p>
      </div>

      <ol data-animate="fade-up" class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2">
        {droneSteps.map((s) => (
          <li class="bg-surface p-7">
            <p class="font-display text-3xl leading-none text-sand">{s.n}</p>
            <p class="mt-3 font-display text-xl leading-snug text-ink">{s.t}</p>
            <p class="mt-2 text-sm leading-relaxed text-mute">{s.d}</p>
          </li>
        ))}
      </ol>

      <div data-animate="fade-up" class="mt-8 flex flex-col gap-5 rounded-2xl border border-line bg-[color-mix(in_srgb,var(--color-atlantic)_6%,var(--color-surface))] p-7 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-display text-xl leading-tight text-ink">Foirm iarratais dróin</p>
          <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-mute">Íoslódáil foirm iarratais dróin an IAA, comhlánaigh í agus seol ríomhphost í chuig <a href="mailto:atc@donegalairport.ie" class="text-atlantic hover:underline">atc@donegalairport.ie</a> ar a laghad 48 uair roimh d'eitilt bheartaithe.</p>
        </div>
        <a href="https://donegalairport.ie/wp-content/uploads/2026/03/IAA-Drone-Request-Blank-Form.docx" target="_blank" rel="noopener" download class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-atlantic px-6 py-3.5 font-mono text-[0.72rem] font-bold uppercase tracking-[0.16em] text-white transition-colors hover:bg-ink sm:self-auto">Íoslódáil an fhoirm ↓</a>
      </div>

      <div data-animate="fade-up" class="mt-10 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-mono text-[0.82rem] font-bold uppercase tracking-[0.2em] text-sand">Pointe tagartha an aeradróim</p>
          <p class="mt-2 font-mono-num text-sm text-ink">55°02′39″N 008°20′28″W</p>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-3 font-mono-num text-[0.72rem] uppercase tracking-[0.16em]">
          <a href="https://www.iaa.ie/general-aviation/drones/uas-geographic-zones" target="_blank" rel="noopener" class="text-atlantic hover:underline">Criosanna UAS an IAA ↗</a>
          <a href="mailto:atc@donegalairport.ie" class="text-atlantic hover:underline">atc@donegalairport.ie ↗</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("astro:page-load", () => {
      // Declared here (not next to initEidlWeather() below) because that
      // function is called earlier in this listener (initEidlWeather();)
      // than its own body appears in the file — a plain `let` down there
      // would still be in its temporal dead zone at call time and throw,
      // silently aborting the rest of this listener on every run.
      let eidlWeatherTimer: ReturnType<typeof setInterval> | undefined;
      const links = [...document.querySelectorAll<HTMLElement>("[data-nav-link]")];
      if (!links.length) return;
      const setActive = (id: string) => {
        links.forEach((l) => l.classList.toggle("is-active", l.dataset.navLink === id));
        // The nav strip scrolls horizontally on narrow screens, so the active
        // link can end up off-screen — center it into view alongside the
        // underline. Scroll the strip's own scrollLeft directly (not
        // scrollIntoView) so only this row moves — scrollIntoView walks up
        // to ancestor scroll containers too and was dragging the whole page
        // sideways along with it.
        const active = links.find((l) => l.dataset.navLink === id);
        const scroller = active?.parentElement;
        if (active && scroller) {
          scroller.scrollTo({
            left: active.offsetLeft - (scroller.clientWidth - active.clientWidth) / 2,
            behavior: "smooth",
          });
        }
      };
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (vis) setActive((vis.target as HTMLElement).id);
        },
        { rootMargin: "-40% 0px -55% 0px", threshold: [0, 0.25, 0.5, 1] },
      );
      ["data", "ppr", "fees", "drones"].forEach((id) => {
        const el = document.getElementById(id);
        if (el) obs.observe(el);
      });

      // Declared-distances bars — fill in when scrolled into view
      const dd = document.getElementById("dd");
      if (dd) {
        const ddObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                dd.classList.add("is-in");
                ddObs.disconnect();
              }
            });
          },
          { rootMargin: "0px 0px -20% 0px", threshold: 0.15 },
        );
        ddObs.observe(dd);
      }

      // UAS zones — link map rings and rule cards on hover/focus
      const uas = document.getElementById("uas-zones");
      if (uas) {
        const hot = (id: string, on: boolean) =>
          uas.querySelectorAll('[data-zone="' + id + '"]').forEach((el) => el.classList.toggle("is-hot", on));
        uas.querySelectorAll("[data-zone]").forEach((el) => {
          const id = el.getAttribute("data-zone");
          if (!id) return;
          el.addEventListener("mouseenter", () => hot(id, true));
          el.addEventListener("mouseleave", () => hot(id, false));
          el.addEventListener("focus", () => hot(id, true));
          el.addEventListener("blur", () => hot(id, false));
        });
      }

      // Tower opening-hours interactive widget
      initTowerHours();

      // Live TAF widget
      initEidlWeather();

      function initTowerHours() {
        const host = document.getElementById("tower-hours");
        const dataEl = document.getElementById("tower-hours-data");
        if (!host || !dataEl) return;
        type Row = { day: string; blocks: [string, string][] };
        const DATA = JSON.parse(dataEl.textContent || "{}") as Record<string, Row[]>;
        const SEASON_GA: Record<string, string> = { Winter: "Geimhreadh", Summer: "Samhradh" };
        const DAY_GA: Record<string, string> = { "Mon–Sun": "Luan–Domh" };
        const parseHM = (x: string) => { const n = parseInt(x, 10); return Math.floor(n / 100) * 60 + (n % 100); };
        const pad2 = (n: number) => ("0" + n).slice(-2);
        const isSummer = (d: Date) => {
          const y = d.getUTCFullYear();
          const lastSun = (m: number) => { const t = new Date(Date.UTC(y, m + 1, 0)); return t.getUTCDate() - t.getUTCDay(); };
          const start = Date.UTC(y, 2, lastSun(2), 1), end = Date.UTC(y, 9, lastSun(9), 1);
          const t = d.getTime(); return t >= start && t < end;
        };
        const matches = (day: string, dow: number) =>
          day === "Sun" ? dow === 0 : day === "Sat" ? dow === 6 : day === "Mon–Fri" ? dow >= 1 && dow <= 5 : day === "Mon–Sun" ? true : dow >= 1 && dow <= 6;

        let view: string | null = null;
        const render = () => {
          const now = new Date();
          const nowMin = now.getUTCHours() * 60 + now.getUTCMinutes();
          const dow = now.getUTCDay();
          const curSeason = isSummer(now) ? "Summer" : "Winter";
          const season = view || curSeason;
          const fill = season === "Winter" ? "var(--color-atlantic)" : "var(--color-sand)";
          // Mobile: a side-by-side label column left the bar too narrow (blocks show
          // exact minutes, not just hours) and overlapped. Stack the day label above
          // its bar instead, giving the bar the full row width.
          const isMobile = window.matchMedia("(max-width: 1023px)").matches;
          const gridCols = isMobile ? "1fr" : "112px 1fr";
          const rowGap = isMobile ? 6 : 16;

          let statusText = "Dúnta — sceidealta", statusSub = "", open = false;
          const todayRow = (DATA[curSeason] || []).find((r) => matches(r.day, dow));
          if (todayRow) {
            const blks = todayRow.blocks.map((b) => ({ s: parseHM(b[0]), e: parseHM(b[1]), s0: b[0], e0: b[1] }));
            const cur = blks.find((b) => nowMin >= b.s && nowMin < b.e);
            if (cur) { open = true; statusText = "Oscailte — sceidealta"; statusSub = "dúnann ag " + cur.e0 + "Z · deimhnigh le NOTAM"; }
            else { const next = blks.find((b) => b.s > nowMin); statusText = "Dúnta — sceidealta"; statusSub = (next ? "osclaíonn ag " + next.s0 + "Z" : "athosclaíonn amárach") + " · deimhnigh le NOTAM"; }
          } else { statusSub = "níl seirbhís sceidealta inniu · deimhnigh le NOTAM"; }
          const statusCol = open ? "#0e7c66" : "var(--color-mute)";

          // Bar axis: fit tightly to the season's actual open blocks with equal
          // breathing room on both ends, so the empty space at the start of the
          // bar matches the empty space at the end instead of drifting with the season.
          const seasonBlocks = (DATA[season] || []).flatMap((r) => r.blocks);
          const seasonStarts = seasonBlocks.map((b) => parseHM(b[0]));
          const seasonEnds = seasonBlocks.map((b) => parseHM(b[1]));
          const PAD = 50;
          const AX0 = (seasonStarts.length ? Math.min(...seasonStarts) : 360) - PAD;
          const AX1 = (seasonEnds.length ? Math.max(...seasonEnds) : 1260) + PAD;
          const SPAN = AX1 - AX0;
          const TICK_STEP = 3;
          const firstTickH = Math.ceil(AX0 / 60 / TICK_STEP) * TICK_STEP;
          const lastTickH = Math.floor(AX1 / 60 / TICK_STEP) * TICK_STEP;
          const tickHours: number[] = [];
          for (let h = firstTickH; h <= lastTickH; h += TICK_STEP) tickHours.push(h);

          const rowsHtml = (DATA[season] || []).map((r) => {
            const isToday = season === curSeason && matches(r.day, dow);
            const blocksHtml = r.blocks.map((b) => {
              const s = parseHM(b[0]), e = parseHM(b[1]);
              const left = (s - AX0) / SPAN * 100, width = (e - s) / SPAN * 100, mid = ((s + e) / 2 - AX0) / SPAN * 100;
              return `<div style="position:absolute;top:7px;height:22px;left:${left}%;width:${width}%;background:${fill};border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.14)"></div>`
                + `<div style="position:absolute;top:34px;left:${mid}%;transform:translateX(-50%);white-space:nowrap;font-family:var(--font-mono-num);font-size:10.5px;color:var(--color-mute)">${b[0]}–${b[1]}</div>`;
            }).join("");
            const showNow = isToday && nowMin >= AX0 && nowMin <= AX0 + SPAN;
            const nowPos = (nowMin - AX0) / SPAN * 100;
            const nowHtml = showNow
              ? `<div style="position:absolute;top:2px;height:32px;width:2px;left:${nowPos}%;background:#b4462f;border-radius:2px;z-index:5"><div style="position:absolute;top:-15px;left:50%;transform:translateX(-50%);white-space:nowrap;font-family:var(--font-mono-num);font-size:9px;font-weight:600;letter-spacing:.06em;color:#b4462f">${pad2(now.getUTCHours()) + pad2(now.getUTCMinutes())}Z</div></div>`
              : "";
            const todayTagStyle = isMobile
              ? "font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;color:#b4462f;white-space:nowrap"
              : "font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;color:#b4462f;margin-top:4px";
            const todayTag = isToday ? `<div style="${todayTagStyle}">● INNIU</div>` : "";
            const labelWrapStyle = isMobile
              ? "display:flex;align-items:baseline;justify-content:space-between;gap:10px"
              : "padding-top:5px";
            return `<div style="padding:13px 12px;margin:0 -12px;border-radius:12px;background:${isToday ? "color-mix(in srgb,var(--color-atlantic) 8%,transparent)" : "transparent"}">`
              + `<div style="display:grid;grid-template-columns:${gridCols};gap:${rowGap}px;align-items:start">`
              + `<div style="${labelWrapStyle}"><div style="font-size:15px;font-weight:700;letter-spacing:-.01em;color:var(--color-ink)">${DAY_GA[r.day] ?? r.day}</div>${todayTag}</div>`
              + `<div style="position:relative;height:54px"><div style="position:absolute;top:7px;height:22px;left:0;right:0;background:var(--color-surface-lo);border-radius:8px"></div>${blocksHtml}${nowHtml}</div>`
              + `</div></div>`;
          }).join("");

          const ticksHtml = tickHours.map((h) => {
            const left = (h * 60 - AX0) / SPAN * 100;
            return `<div style="position:absolute;top:5px;left:${left}%;transform:translateX(-50%);font-family:var(--font-mono-num);font-size:10px;letter-spacing:.08em;color:var(--color-mute)">${pad2(h)}</div>`;
          }).join("");

          const btn = (label: string, on: boolean, col: string) =>
            `<button data-season="${label}" style="cursor:pointer;border:none;border-radius:999px;padding:8px 20px;font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;background:${on ? "var(--color-surface)" : "transparent"};color:${on ? col : "var(--color-mute)"};font-weight:${on ? 600 : 400};box-shadow:${on ? "0 1px 2px rgba(0,0,0,.1)" : "none"};transition:all .15s ease">${SEASON_GA[label] ?? label}</button>`;

          const statusPill = `<div style="display:flex;align-items:center;gap:11px;background:var(--color-surface-lo);border:1px solid var(--color-line);border-radius:12px;padding:11px 16px">`
            + `<span style="position:relative;width:9px;height:9px;flex:0 0 auto">${open ? `<span style="position:absolute;inset:0;border-radius:50%;background:${statusCol};animation:pulseDot 2s ease-out infinite"></span>` : ""}<span style="position:absolute;inset:0;border-radius:50%;background:${statusCol}"></span></span>`
            + `<div style="line-height:1.15"><div style="font-size:14px;font-weight:700;letter-spacing:-.01em;color:var(--color-ink)">${statusText}</div><div style="font-family:var(--font-mono-num);font-size:11px;color:var(--color-mute);margin-top:2px">${statusSub}</div></div></div>`;

          const seasonNote = season === curSeason ? "Sceideal reatha i bhfeidhm" : "Réamhamharc — níl i bhfeidhm faoi láthair";
          const noteCol = season === curSeason ? "var(--color-ink)" : "#b4462f";

          host.innerHTML =
            `<div style="display:flex;flex-wrap:wrap;gap:16px 20px;align-items:flex-start;justify-content:space-between;margin-bottom:24px">`
            + `<div><div style="font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--color-sand);margin-bottom:9px">Rialú Aerthráchta</div>`
            + `<h3 style="font-family:var(--font-display);font-size:clamp(22px,3vw,27px);font-weight:400;letter-spacing:-.02em;line-height:1.05;margin:0;color:var(--color-ink)">Uaireanta oscailte an túir</h3>`
            + `<div style="font-family:var(--font-mono);font-size:11.5px;letter-spacing:.06em;color:var(--color-mute);margin-top:7px">Dún na nGall · EIDL · gach am UTC (Z)</div></div>`
            + statusPill + `</div>`
            + `<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:26px">`
            + `<div style="display:inline-flex;background:var(--color-surface-lo);border-radius:999px;padding:4px;gap:2px">${btn("Winter", season === "Winter", "var(--color-atlantic)")}${btn("Summer", season === "Summer", "var(--color-sand)")}</div>`
            + `<div style="font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.04em;color:${noteCol}">${seasonNote}</div></div>`
            + `<div>${rowsHtml}<div style="display:grid;grid-template-columns:${gridCols};gap:${rowGap}px;margin-top:6px"><div></div><div style="position:relative;height:18px;border-top:1px solid var(--color-line)">${ticksHtml}</div></div></div>`
            + `<div style="margin:26px 0 0;padding-top:20px;border-top:1px solid var(--color-line)">`
            + `<p style="font-size:13.5px;line-height:1.6;color:var(--color-mute);margin:0">Tá an túr <strong style="color:var(--color-ink);font-weight:600">dúnta idir na bloic a thaispeántar</strong> (sosanna rialtóra) agus lasmuigh díobh. Is trí shocrú lasmuigh d'uaireanta a dhéantar gluaiseachtaí lasmuigh de na huaireanta foilsithe — fógra 48 uair.</p>`
            + `<div style="display:flex;flex-direction:column;gap:9px;margin-top:16px">`
            + `<div style="display:grid;grid-template-columns:78px 1fr;gap:12px;align-items:baseline"><span style="font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.14em;color:var(--color-sand)">SAMHRADH</span><span style="font-size:13.5px;line-height:1.5;color:var(--color-mute)">I bhfeidhm ón Domhnach deireanach de mhí an Mhárta go dtí an Domhnach deireanach de mhí Dheireadh Fómhair (am sábhála soilse na hÉireann).</span></div>`
            + `<div style="display:grid;grid-template-columns:78px 1fr;gap:12px;align-items:baseline"><span style="font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.14em;color:var(--color-atlantic)">GEIMHREADH</span><span style="font-size:13.5px;line-height:1.5;color:var(--color-mute)">I bhfeidhm ón Domhnach deireanach de mhí Dheireadh Fómhair go dtí an Domhnach deireanach de mhí an Mhárta (gnáth-am).</span></div></div>`
            + `<p style="font-size:13.5px;font-weight:700;color:var(--color-ink);margin:16px 0 0">Fógraítear athruithe trí NOTAM.</p>`
            + `<a href="https://www.airnav.ie/air-traffic-management/notam-notice-to-airmen-24e348473e7b0153452e634c36c72213" target="_blank" rel="noopener" style="display:inline-block;margin-top:8px;font-family:var(--font-mono);font-size:11.5px;font-weight:600;letter-spacing:.06em;color:var(--color-atlantic);text-decoration:underline;text-underline-offset:2px">NOTAManna Reatha — AirNav Ireland ↗</a></div>`;

          host.querySelectorAll<HTMLElement>("[data-season]").forEach((b) =>
            b.addEventListener("click", () => { view = b.dataset.season || null; render(); }),
          );
        };
        render();
        setInterval(render, 60000);
      }

      function initEidlWeather() {
        const host = document.getElementById("eidl-weather");
        if (!host) return;
        if (eidlWeatherTimer) clearInterval(eidlWeatherTimer);

        const pad2 = (n: number) => ("0" + n).slice(-2);
        const fmtZ = (unixSeconds: number) => {
          const d = new Date(unixSeconds * 1000);
          return `${pad2(d.getUTCDate())}/${pad2(d.getUTCHours())}${pad2(d.getUTCMinutes())}Z`;
        };
        // rawTAF comes straight from aviationweather.gov (a third-party API,
        // not user input, but still not ours to trust blindly) and gets
        // interpolated into an innerHTML template below — escape it so a
        // compromised or malformed upstream response can't inject markup.
        const escapeHtml = (s: string) =>
          s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

        async function load() {
          try {
            const res = await fetch("/api/weather.json?_=" + Date.now());
            const data = await res.json();
            render(data.taf);
          } catch {
            host!.innerHTML = `<p style="font-family:var(--font-mono);font-size:12px;color:var(--color-mute)">Níl an tuairisc bheo ar fáil faoi láthair — seiceáil an TAF agus NOTAM reatha go díreach.</p>`;
          }
        }

        // TAF amháin — níl stáisiún uathoibríoch METAR ag EIDL lasmuigh
        // d'uaireanta ATC/AFIS, mar sin níl sé ar fáil go hiontaofa; tá an
        // réamhaisnéis (TAF) ann i gcónaí.
        function render(taf: any) {
          if (!taf) {
            host!.innerHTML = `<p style="font-family:var(--font-mono);font-size:12px;color:var(--color-mute)">Níl an tuairisc bheo ar fáil faoi láthair — seiceáil an TAF agus NOTAM reatha go díreach.</p>`;
            return;
          }

          host!.innerHTML =
            `<div style="margin-bottom:20px">`
            + `<p style="margin:0;font-family:var(--font-mono);font-size:13px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--color-atlantic)">Aimsir bheo · TAF</p>`
            + `</div>`
            + `<div>`
            + `<p style="margin:0;font-family:var(--font-mono-num);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--color-mute)">TAF · bailí ${fmtZ(taf.validTimeFrom)} – ${fmtZ(taf.validTimeTo)}</p>`
            + `<p style="margin:12px 0 0;font-family:var(--font-mono-num);font-size:13px;line-height:1.6;color:var(--color-ink);word-break:break-word">${taf.rawTAF ? escapeHtml(taf.rawTAF) : "—"}</p>`
            + `</div>`;
        }

        load();
        eidlWeatherTimer = setInterval(load, 300000);
      }

    });

    // Runway diagram — mobile only: rotate the (landscape) chart -90° into a
    // straight portrait view, RWY 02/023° at the bottom pointing straight
    // up. Sized to fit the whole drawing within one screen height (no
    // scrolling needed to see the runway shape itself) — at this image's
    // aspect ratio (2896:392) that makes it fairly narrow, so labels near
    // the edges may run close together or extend slightly; the drawing
    // itself staying fully visible was the priority here. The angle is
    // adjustable (see the ?edit panel below) if a tilted, wider-but-off-
    // vertical layout is wanted again later. The canvas keeps its native
    // aspect ratio, just reoriented — its own width is set in JS so the rotated
    // bounding box matches the target height, since a plain CSS transform
    // doesn't resize the element's box. Each label carries the matching
    // counter-rotation (.map-counter-rotate, rotate-[90deg] in the markup)
    // so the numbers stay upright; direction arrows/ruler bars are left
    // un-countered so they end up pointing along the runway's new axis.
    // Desktop is untouched — sm: classes disable all of this and the chart
    // renders exactly as before.
    document.addEventListener("astro:page-load", () => {
      const wrap = document.getElementById("map-canvas-wrap");
      const canvas = document.getElementById("map-canvas");
      if (!wrap || !canvas) return;
      const ASPECT = 2896 / 392; // original landscape width/height

      const angle = 90; // degrees off vertical — straight portrait orientation
      const heightFrac = 0.72; // fraction of viewport height, capped below
      const previewOn = true;

      const counterRotated = () => Array.from(canvas.querySelectorAll<HTMLElement>(".map-counter-rotate"));

      const reset = () => {
        wrap.style.height = "";
        wrap.style.width = "";
        wrap.style.marginInline = "";
        canvas.style.position = "";
        canvas.style.top = "";
        canvas.style.left = "";
        canvas.style.width = "";
        canvas.style.transform = "";
        counterRotated().forEach((el) => { el.style.rotate = ""; });
      };

      const apply = () => {
        if (window.innerWidth >= 640 || !previewOn) { reset(); return; }
        const rad = (angle * Math.PI) / 180;
        const s = Math.abs(Math.sin(rad));
        const c = Math.abs(Math.cos(rad));
        // Leave room above for the "Runway 02 / 20" heading and the box's
        // own padding so the whole drawing — not just part of it — lands
        // inside one viewport.
        const targetH = Math.min(window.innerHeight * heightFrac, 700);
        // bbox height = Cw*s + (Cw/ASPECT)*c → solve for the canvas's own
        // (pre-rotation) width Cw, then derive the bbox width to match.
        const cw = targetH / (s + c / ASPECT);
        const bboxWidth = cw * c + (cw / ASPECT) * s;
        wrap.style.height = `${targetH}px`;
        wrap.style.width = `${bboxWidth}px`;
        wrap.style.marginInline = "auto";
        canvas.style.position = "absolute";
        canvas.style.top = "50%";
        canvas.style.left = "50%";
        canvas.style.width = `${cw}px`;
        canvas.style.transform = `translate(-50%, -50%) rotate(-${angle}deg)`;
        counterRotated().forEach((el) => { el.style.rotate = `${angle}deg`; });
      };

      apply();
      window.addEventListener("resize", apply);
    });
  </script>

  <style>
    /* Hero "CFN" — the split engine renders F in Inter (.f-fix); at this
       size it reads larger than the display face's caps, so trim it to match.
       :global reaches the runtime-created span; the cid on .hero-display
       keeps this scoped to the pilots hero (the homepage "Aerfort" F is safe). */
    .hero-display :global(.f-fix) { font-size: 0.91em; }
    [data-nav-link].is-active { border-color: var(--color-atlantic); color: var(--color-ink); }
    .map-item { white-space: nowrap; z-index: 20; }
    /* Space Mono's "0" glyph has a dot through the middle — fine for prose,
       but every label on this runway map is a number (bearings, clearway
       and threshold distances) — see --font-mono-num in global.css.
       Targets .map-txt too: the 209m/129m threshold labels put Tailwind's
       font-mono directly on that inner span rather than on .map-item, and
       a directly-matched declaration always wins over one only inherited
       from a parent, regardless of cascade order. Applied on both mobile
       and desktop. */
    .map-item, .map-item .map-txt { font-family: var(--font-mono-num); }
    .uas-ring { transition: fill-opacity .2s ease, stroke-width .2s ease; cursor: pointer; }
    .uas-ring.is-hot { fill-opacity: .4; stroke-width: 4; }
    .uas-card { transition: background-color .2s ease, border-color .2s ease; outline: none; }
    .uas-card.is-hot { border-color: var(--zc); background: color-mix(in srgb, var(--zc) 9%, var(--color-surface)); }
    @keyframes pulseDot { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.7); opacity: 0; } }
    .dd-fill { width: 0; transition: width 1.1s cubic-bezier(.22,.61,.36,1); }
    #dd.is-in .dd-fill { width: var(--w); }
    @media (prefers-reduced-motion: reduce) { .dd-fill { transition: none; width: var(--w); } }
    details.acc > summary { list-style: none; }
    details.acc > summary::-webkit-details-marker { display: none; }
    .acc-chevron { transition: transform 0.25s ease; display: inline-block; }
    details.acc[open] .acc-chevron { transform: rotate(180deg); }
  </style>
</BaseLayout>
