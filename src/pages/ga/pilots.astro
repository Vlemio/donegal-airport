        <div class="mt-6 grid gap-8 md:grid-cols-[minmax(0,300px)_1fr] md:items-center">
          <svg viewBox="0 0 300 300" class="mx-auto w-full max-w-[300px]" role="img" aria-label="Criosanna geografacha UAS Dhún na nGall — scéimreach comhlárnach">
