---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readTowerHours, readAerodromeData, readFees, parseHourBlocks } from "../../lib/siteContent";

const title = "Píolótaí agus dróin · Aerfort Dhún na nGall";
const description =
  "Sonraí tagartha an aeradróim, minicíochtaí ATC, nós imeachta PPR, táillí agus muirir agus oibríochtaí dróin i gcrios rialaithe Dhún na nGall (EIDL) — ó AIP Ireland AD 2 EIDL.";

// Editable in /keystatic — see src/lib/siteContent.ts and keystatic.config.ts.
const towerHoursCms = await readTowerHours();
const aero = await readAerodromeData();
const fees = await readFees();

/* Figures from AIP Ireland — EIDL AD 2 (AIRAC Amdt 004/26, eff 16 APR 2026). Cross-check current AIP & NOTAMs. */

const nav = [
  { id: "data", label: "Sonraí an aeradróim" },
  { id: "ppr", label: "PPR agus nósanna" },
  { id: "fees", label: "Táillí agus muirir" },
  { id: "drones", label: "Dróin" },
];

/* At-a-glance stats */
const stats = [
  { big: "02 / 20", small: "Rúidbhealach · 1495 × 30 m" },
  { big: "30", unit: "ft", small: "Airde AMSL" },
  { big: "10 NM", small: "CTR · SFC–5000 ft" },
  { big: "5000", unit: "ft", small: "Airde trasdula" },
  { big: "129.805", small: "Túr · ATIS 129.930" },
  { big: "CAT 5", small: "Eitiltí sceidealta" },
];

/* Detail blocks (accordions). Values come from /keystatic ("Aerodrome data"
   singleton) — labels stay fixed here since they're standard AIP field
   names, not something an editor should be retyping. */
const identifiers = [
  ["IATA / ICAO", aero.identifiers.iataIcao.ga],
  ["Cineál aeradróim", aero.identifiers.aerodromeType.ga],
  ["ARP", aero.identifiers.arp.ga],
  ["Suíomh", aero.identifiers.position.ga],
  ["Teocht thagartha", aero.identifiers.refTemp.ga],
  ["Athraitheas maighnéadach", aero.identifiers.magVar.ga],
  ["Trácht ceadaithe", aero.identifiers.trafficPermitted.ga],
];
const runwayFull = [
  ["Treo", aero.runway.bearing.ga],
  ["Dromchla", aero.runway.surface.ga],
  ["Tairseach aistrithe", aero.runway.displacedThr.ga],
  ["Stráice / RESA", aero.runway.stripResa.ga],
  ["PAPI", aero.runway.papi.ga],
  ["Soilse druidime", aero.runway.approachLgt.ga],
];
/* Mobile-only: rows whose value wraps to an extra line in the narrow accordion
   column — pull letters (and word gaps) tighter, not smaller, just enough per
   row to read on one line. Desktop is unaffected (sm: resets to normal). */
const tightRows: Record<string, string> = {
  // Irish labels/values run longer than English — some rows (marked below)
  // can't reach one line without crushing word-spacing past legibility, so
  // they stay at two lines at a safe compression ceiling instead.
  "Teocht thagartha": "tracking-[-0.075em] [word-spacing:-4px] sm:tracking-normal sm:[word-spacing:normal]", // stays 2 lines
  "Athraitheas maighnéadach": "tracking-[-0.075em] [word-spacing:-4px] sm:tracking-normal sm:[word-spacing:normal]", // stays 2 lines
  "Dromchla": "tracking-[-0.06em] [word-spacing:-3px] sm:tracking-normal sm:[word-spacing:normal]",
  "Cineál aeradróim": "tracking-[-0.075em] [word-spacing:-4px] sm:tracking-normal sm:[word-spacing:normal]", // stays 2 lines
  "Slí rollta A": "tracking-[-0.06em] [word-spacing:-3px] sm:tracking-normal sm:[word-spacing:normal]",
  "Tairseach aistrithe": "tracking-[-0.06em] [word-spacing:-3px] sm:tracking-normal sm:[word-spacing:normal]",
  "Stráice / RESA": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]",
  "PAPI": "tracking-[-0.06em] [word-spacing:-3px] sm:tracking-normal sm:[word-spacing:normal]",
  "Plean eitilte": "tracking-[-0.075em] [word-spacing:-4px] sm:tracking-normal sm:[word-spacing:normal]", // stays 2 lines
  "AFIS": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]",
  "RFFS": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]", // 3→2 lines
  "Custaim / Inimirce": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]", // 3→2 lines
};
const declared = [
  { rwy: "02", tora: "1314", toda: "1593", asda: "1314", lda: "1159", thr: "209 m" },
  { rwy: "20", tora: "1332", toda: "1406", asda: "1332", lda: "1203", thr: "129 m" },
];

/* Declared distances — interactive selector (bars to scale by length). */
const DDMAX = 1593; // longest declared distance (TODA 02) → sets the scale
const ddItems = [
  { key: "TORA", name: "Fad Rite Éirí Ar Fáil", color: "#1a4a6e" },
  { key: "ASDA", name: "Fad Luasghéaraithe-Stad Ar Fáil", color: "#2e7d5b" },
  { key: "TODA", name: "Fad Éirí Ar Fáil", color: "#a07840" },
  { key: "LDA", name: "Fad Tuirlingthe Ar Fáil", color: "#9c3d54" },
];
type DDRwy = { TORA: number; ASDA: number; TODA: number; LDA: number; disp: number; cwy: number; cwyEnd: string; papi: string; appr: string; note: string };
const ddRwy: Record<string, DDRwy> = {
  "02": { TORA: 1314, ASDA: 1314, TODA: 1593, LDA: 1159, disp: 209, cwy: 279, cwyEnd: "20", papi: "PAPI 3.3° · MEHT 43 ft", appr: "RNP · NDB/DME", note: "Tosaíonn rith éirí 155 m roimh an tairseach aistrithe. Áirítear sa TODA an t-achar imréitigh 279 m thar chionn RWY 20." },
  "20": { TORA: 1332, ASDA: 1332, TODA: 1406, LDA: 1203, disp: 129, cwy: 74, cwyEnd: "02", papi: "No PAPI serving RWY 20", appr: "RNP · LOC · NDB/DME", note: "Tairseach aistrithe 129 m. Áirítear sa TODA an t-achar imréitigh 74 m thar chionn RWY 02." },
};
const ddDir: Record<string, string> = { "02": "→", "20": "←" };

/* All 5 remaining boxes + Cautions, values from /keystatic ("Aerodrome
   data" singleton) — labels stay fixed here, only the values are editable. */
const airspace = [
  ["Ainmniú", aero.airspace.designation.ga],
  ["Teorainneacha cliathánacha", aero.airspace.lateralLimits.ga],
  ["Teorainneacha ingearacha", aero.airspace.verticalLimits.ga],
  ["Aicme", aero.airspace.airspaceClass.ga],
  ["Airde trasdula", aero.airspace.transitionAltitude.ga],
  ["Plean eitilte", aero.airspace.flightPlan.ga],
];
const approaches = [
  ["RWY 02", aero.approaches.rwy02.ga],
  ["RWY 20", aero.approaches.rwy20.ga],
];
const navaids = [
  ["NDB", aero.navaids.ndb.ga],
  ["DME", aero.navaids.dme.ga],
  ["LOC 20", aero.navaids.loc20.ga],
];
const comms = [
  ["Túr", aero.comms.tower.ga],
  ["Talamh", aero.comms.ground.ga],
  ["AFIS", aero.comms.afis.ga],
  ["ATIS", aero.comms.atis.ga],
];
const ops = [
  ["RFFS", aero.ops.rffs.ga],
  ["Aprún thuaidh", aero.ops.northApron.ga],
  ["Aprún theas", aero.ops.southApron.ga],
  ["Slí rollta A", aero.ops.taxiwayA.ga],
  ["Slí rollta B", aero.ops.taxiwayB.ga],
  ["Breosla", aero.ops.fuel.ga],
  ["Slándáil", aero.ops.security.ga],
  ["PPR", aero.ops.ppr.ga],
  ["Custaim / Inimirce", aero.ops.customsImm.ga],
];
const cautions = aero.cautions.ga.split("\n").map((c) => c.trim()).filter(Boolean);

/* Opening hours → timeline (UTC). Bar range 06:00–21:00. Editable in
   /keystatic ("Tower opening hours" singleton) — times only, same in both
   languages, so there's no EN/GA split to thread through here. */
const hoursData = {
  Winter: [
    { day: "Mon–Sun", blocks: parseHourBlocks(towerHoursCms.winter) },
  ],
  Summer: [
    { day: "Mon–Sun", blocks: parseHourBlocks(towerHoursCms.summer) },
  ],
};
/* Display-only translations. Data keys stay English (used as lookups both
   here and in the client script) — only the rendered label changes. */
const SEASON_GA: Record<string, string> = { Winter: "Geimhreadh", Summer: "Samhradh" };
const DAY_GA: Record<string, string> = { "Mon–Sun": "Luan–Domh" };
const START = 360, SPAN = 900; // 06:00 → 21:00
const toMin = (t: string) => parseInt(t.slice(0, 2)) * 60 + parseInt(t.slice(2));
const pct = (m: number) => ((m - START) / SPAN) * 100;
const ticks = ["06", "09", "12", "15", "18", "21"];

/* Accordion groups */
const accordions = [
  { title: "Aitheantóirí agus Suíomh", badge: "AD 2.2", rows: identifiers },
  { title: "Rúidbhealach — Mionsonraí Iomlána", badge: "AD 2.12", rows: runwayFull },
  { title: "Aerspás · CTR Dhún na nGall", badge: "AD 2.17", rows: airspace },
  { title: "Druidimí Ionstraime", badge: "IAP", rows: approaches },
  { title: "Áiseanna Loingseoireachta", badge: "NAV", rows: navaids },
  { title: "Cumarsáid", badge: "COMM", rows: comms },
  { title: "Oibríochtúil", badge: "OPS", rows: ops },
];

/* ── Fees & charges (effective 1 March 2025) ────────────────── */
/* Values from /keystatic ("Fees & charges" singleton) — group/row labels
   stay fixed here, only the amounts on the right are editable. */
const feeGroups = [
  { title: "Tuirlingt", badge: "in aghaidh na tuirlinge", rows: [["Inneall amháin", fees.landing.singleEngine.ga], ["Déinneall (< 4 t)", fees.landing.twinEngine.ga], ["Os cionn 4 t", fees.landing.over4t.ga]] },
  { title: "Páirceáil Aerárthaigh", badge: "in aghaidh 24 uair", rows: [["An chéad 2 uair", fees.parking.first2h.ga], ["Faoi bhun 3 t", fees.parking.under3t.ga], ["Faoi bhun 10 t", fees.parking.under10t.ga], ["Faoi bhun 20 t", fees.parking.under20t.ga], ["Os cionn 20 t", fees.parking.over20t.ga]] },
  { title: "Láimhseáil", badge: "in aghaidh an phaisinéara amach", rows: [["Formhuirear ualaigh paisinéirí", fees.handling.paxSupplement.ga], ["Táille láimhseála", fees.handling.handlingFee.ga], ["Díolmhaithe", fees.handling.exempt.ga]] },
  { title: "Seirbhísí Talún", badge: "de réir úsáide", rows: [["Aonad cumhachta talún", fees.groundServices.gpu.ga], ["Uisce te", fees.groundServices.hotWater.ga], ["Glanadh soithí lónadóireachta", fees.groundServices.cleaning.ga], ["Tarraingt aerárthaigh", fees.groundServices.towing.ga], ["Seirbhísí speisialta", fees.groundServices.special.ga]] },
  { title: "Lasmuigh d'Uaireanta", badge: "fógra 48 uair", rows: [["Síneadh aerfoirt", fees.outOfHours.extension.ga]] },
  { title: "Haingear", badge: "+ 23% CBL", rows: [["Inneall aonair príobháideach", fees.hangarage.privateSingle.ga], ["Déinneall príobháideach", fees.hangarage.privateTwin.ga], ["Tráchtála", fees.hangarage.commercial.ga], ["Brú isteach / amach", fees.hangarage.pushInOut.ga]] },
];

/* ── Drones ─────────────────────────────────────────────────── */
const droneSteps = [
  { n: "01", t: "Cláraigh agus sealbhaigh an chatagóir Shonrach", d: "Cláraigh leis an IAA má tá do dhrón os cionn 250 g nó má tá ceamara aige. Chun eitilt laistigh de CTR Dhún na nGall ní mór duit údarú oibriúcháin sa chatagóir Shonrach ón IAA a bheith agat freisin." },
  { n: "02", t: "Seiceáil an crios UAS agus an teorainn airde", d: "Tá Dún na nGall clúdaithe ag trí Chrios Geografach UAS — coiscthe laistigh den CTR dearg 10 NM, ansin teorainneacha airde 15 m agus 90 m lasmuigh de sin (féach thuas)." },
  { n: "03", t: "Iarr cead roimh ré", d: "Íoslódáil an fhoirm iarratais dróin agus seol ríomhphost í chuig atc@donegalairport.ie. Déanann ATC measúnú ar d'iarratas i gcoinne an tráchta agus freagraíonn siad ar ríomhphost. Fág ar a laghad 48 uair; b'fhéidir nach bpróiseálfar iarratais laistigh den achar sin in am." },
  { n: "04", t: "Glaoigh ar an túr — roimh agus i ndiaidh", d: "Má fhaomhtar é, glaoigh ar Thúr Dhún na nGall ar an bhfón sula seolann tú agus arís nuair a thuirlingíonn tú. Bíodh do ghuthán faoi réir: is féidir leis an trácht athrú agus b'fhéidir go nglaofadh ATC ort chun an drón a thuirlingt láithreach." },
];

/* Published UAS Geographical Zones for Donegal (IAA / EIDL MATS App. 3) */
const droneZones = [
  { id: "EIU69", tag: "Dearg · croílár istigh", color: "#c0392b", cond: "Gan eitiltí dróin", note: "An croílár is faide istigh, is gaire don aerfort." },
  { id: "EIU70", tag: "Ómra · lár", color: "#e0a81e", cond: "Uasmhéid 15 m", note: "An fháinne láir. Suas le 15 m ar airde, nó an bac is airde laistigh de 50 m." },
  { id: "EIU35", tag: "Glas · seachtrach", color: "#4a9d5b", cond: "Uasmhéid 90 m", note: "An fháinne sheachtrach, amach go himeall an CTR (18.5 km / 10 NM). Gearrtha as ó thuaidh siar ag teorainn an aerspáis." },
];
---

<BaseLayout title={title} description={description}>
  {/* ─── HERO ─────────────────────────────────────────────────── */}
  <section class="relative isolate flex min-h-[82vh] w-full items-center overflow-hidden">
    <img src="/photos/pilots/pilots-hero.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover object-center" />
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-28 [text-shadow:0_2px_10px_rgba(0,0,0,0.55),0_1px_30px_rgba(0,0,0,0.4)]">
      <p data-animate="fade-up" class="font-mono text-[0.9rem] font-bold uppercase tracking-[0.28em] text-white">Píolótaí &amp; dróin</p>
      <h1 data-split class="hero-display mt-6 max-w-4xl whitespace-nowrap font-display text-[clamp(2rem,6.5vw,6.5rem)] font-normal leading-[0.95] text-white">Oibríochtaí ag CFN.</h1>
      <p data-animate="fade-up" data-animate-delay="0.15" class="mt-8 max-w-2xl text-base font-medium leading-relaxed text-white [text-shadow:0_2px_6px_rgba(0,0,0,0.75),0_1px_16px_rgba(0,0,0,0.6)] sm:text-lg">
        Sonraí tagartha an aeradróim, minicíochtaí, nós imeachta PPR, táillí
        agus oibríochtaí dróin i gcrios rialaithe Dhún na nGall (EIDL) — ó AIP Ireland AD 2.
      </p>
    </div>
  </section>

  {/* ─── ANCHOR NAV ───────────────────────────────────────────── */}
  <nav class="sticky top-[var(--header-h)] z-30 border-y border-line bg-[color-mix(in_srgb,var(--color-surface-lo)_94%,transparent)] shadow-[0_1px_3px_rgba(24,29,22,0.08)] backdrop-blur">
    <div class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {nav.map((n) => (
        <a href={`#${n.id}`} data-nav-link={n.id} class="shrink-0 border-b-2 border-transparent px-4 py-5 text-center font-mono text-[0.82rem] font-bold uppercase tracking-[0.14em] text-ink/70 transition-colors hover:text-atlantic">{n.label}</a>
      ))}
    </div>
  </nav>

  {/* ─── AERODROME DATA ───────────────────────────────────────── */}
  <section id="data" class="scroll-mt-[calc(var(--header-h)+3.5rem)] border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p data-animate="fade-up" class="font-mono text-base font-bold uppercase tracking-[0.3em] text-atlantic">Sonraí an aeradróim</p>
      <h2 data-split class="mt-3 font-display text-[clamp(2.2rem,4vw,3.4rem)] font-normal leading-[1.02]">EIDL — an tagairt thapa.</h2>

      {/* At a glance */}
      <div data-animate="fade-up" class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3 lg:grid-cols-6">
        {stats.map((s, i) => (
          <div class={`group bg-surface px-5 py-6 transition-colors duration-300 ${i % 2 === 0 ? "hover:bg-[var(--color-atlantic)]" : "hover:bg-[var(--color-sand)]"}`}>
            <p class="inline-block origin-left font-display text-[clamp(1.5rem,2.4vw,2rem)] leading-none text-ink transition-all duration-300 group-hover:scale-110 group-hover:text-white">{s.big}{s.unit && <span class="ml-0.5 font-mono text-[0.5em] font-medium tracking-tight">{s.unit}</span>}</p>
            <p class:list={[
              "mt-2.5 whitespace-nowrap font-mono-num text-[0.72rem] uppercase text-mute transition-colors duration-300 group-hover:text-white/80",
              // Card 0's Irish label ("Rúidbhealach · 1495 × 30 m") runs longer
              // than the others — same size as every other card, just a touch
              // tighter tracking so it still fits on one line at the
              // narrowest (lg:grid-cols-6) width.
              i === 0 ? "tracking-[-0.01em]" : "tracking-[0.14em]",
            ]}>{s.small}</p>
          </div>
        ))}
      </div>

      {/* Runway diagram — horizontal schematic, lengths to scale */}
      <div data-animate="fade-up" class="mt-12">
        <p class="font-mono-num text-[0.82rem] font-bold uppercase tracking-[0.2em] text-sand">Rúidbhealach 02 / 20</p>
        <div class="mt-4 rounded-2xl border border-line bg-[color-mix(in_srgb,var(--color-atlantic)_4%,var(--color-surface))] px-10 py-6 sm:px-20 sm:py-8">
          {/* Aerodrome chart (Photoshop-edited AIP figure), rotated to read left-to-right
             on desktop. On mobile it's rotated again, in the browser, to a portrait
             view with RWY 02 (023°) at the bottom pointing up — see
             initRunwayDiagramMobile() below. Runway-end bearings are overlaid as crisp
             text rather than baked into the image; each label's own .map-txt/wrapper
             carries a counter-rotation so the numbers stay upright even though the
             canvas around them is rotated 90°. */}
          <div class="relative overflow-visible" id="map-canvas-wrap">
          <div class="relative" id="map-canvas">
            <img
              src="/photos/pilots/aerodrome-chart.png?v=5"
              alt="Cairt aeradróim Aerfort Dhún na nGall — rúidbhealach 02/20 le tairseacha aistrithe, limistéir chasta agus PAPI"
              width="2896"
              height="392"
              loading="lazy"
              class="w-full"
            />
            {/* bearing + direction of travel, pinned just above each threshold */}
            <span class="map-item absolute left-[19.06%] top-[68.36%] flex -translate-x-1/2 items-center gap-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] text-atlantic sm:left-[18.3%] sm:top-[28.3%] sm:text-[0.74rem]">
              <span class="map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">023°</span>
              <svg viewBox="0 0 24 10" class="h-2 w-6" aria-hidden="true"><line x1="1" y1="5" x2="21" y2="5" stroke="currentColor" stroke-width="1.6" /><polyline points="16,1 22,5 16,9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="map-item absolute left-[77.67%] top-[13.56%] flex -translate-x-1/2 items-center gap-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] text-atlantic sm:left-[79.2%] sm:top-[28.3%] sm:text-[0.74rem]">
              <svg viewBox="0 0 24 10" class="h-2 w-6" aria-hidden="true"><line x1="3" y1="5" x2="23" y2="5" stroke="currentColor" stroke-width="1.6" /><polyline points="8,1 2,5 8,9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span class="map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">203°</span>
            </span>
            {/* displaced-threshold dimension arrows — to scale, draggable as a unit */}
            <span class="map-item absolute left-[8.8%] top-[90.5%] flex -translate-x-1/2 flex-col items-center gap-0.5 sm:left-[8.8%] sm:top-[81.9%]" style="width:12.1%">
              <svg class="w-full" viewBox="0 0 200 24" preserveAspectRatio="none" style="height:11px" fill="none" aria-hidden="true">
                <g stroke="var(--color-atlantic)" stroke-width="1.6" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="2" y1="2" x2="2" y2="22" /><line x1="198" y1="2" x2="198" y2="22" />
                  <line x1="2" y1="12" x2="198" y2="12" />
                  <polyline points="12,6 2,12 12,18" /><polyline points="188,6 198,12 188,18" />
                </g>
              </svg>
              <span class="map-txt map-counter-rotate rotate-[90deg] font-mono text-[0.58rem] font-bold uppercase tracking-[0.06em] text-atlantic mt-3 sm:mt-0 sm:rotate-0 sm:text-[0.7rem]">209 m</span>
            </span>
            <span class="map-item absolute left-[86.1%] top-[95.6%] flex -translate-x-1/2 flex-col items-center gap-0.5 sm:left-[86.2%] sm:top-[60.3%]" style="width:7.5%">
              <svg class="w-full" viewBox="0 0 200 24" preserveAspectRatio="none" style="height:11px" fill="none" aria-hidden="true">
                <g stroke="var(--color-atlantic)" stroke-width="1.6" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="2" y1="2" x2="2" y2="22" /><line x1="198" y1="2" x2="198" y2="22" />
                  <line x1="2" y1="12" x2="198" y2="12" />
                  <polyline points="12,6 2,12 12,18" /><polyline points="188,6 198,12 188,18" />
                </g>
              </svg>
              <span class="map-txt map-counter-rotate rotate-[90deg] font-mono text-[0.58rem] font-bold uppercase tracking-[0.06em] text-atlantic mt-3 sm:mt-0 sm:rotate-0 sm:text-[0.7rem]">129 m</span>
            </span>
            {/* clearways */}
            <span class="map-item absolute left-[90.13%] top-[-90%] -translate-x-1/2 font-mono text-[0.58rem] font-bold uppercase tracking-[0.08em] text-atlantic sm:left-[90.6%] sm:top-[5.3%] sm:text-[0.68rem]"><span class="map-txt map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">CWY 279 m × 150 m</span></span>
