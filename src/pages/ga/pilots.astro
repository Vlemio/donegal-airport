            <path class="uas-ring" data-zone="EIU69" style="--zc:#c0392b" fill="#c0392b" fill-opacity="0.2" stroke="#c0392b" stroke-width="1.5" d="M150 112 A38 38 0 1 1 150 188 A38 38 0 1 1 150 112 Z" />
