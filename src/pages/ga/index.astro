---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n";
import trim from "../../data/video-trim.json";
import { getCollection } from "astro:content";
import type { SyncedFlight } from "../../lib/flightsStore";
export const prerender = true;

const locale = "ga";
const title = `${t("site.name", locale)} · ${t("site.tagline", locale)}`;
const description = t("site.description", locale);

// Flight data — single source of truth is the /api/flights-today.json
// endpoint (src/pages/api/flights-today.json.ts), which the Donegal FIDS
// pushes to. This page is statically prerendered, so it has no live data
// at build time — start empty (never show made-up sample flights as if
// real) and let the client poll fill in genuine data once it loads.
const flightsToday: SyncedFlight[] = [];

function statusKey(s: string) { return String(s || "").toLowerCase().replace(/[^a-z]/g, ""); }

// Same palette as the live information display (/flights): grey = check-in,
// green = on time/landed/boarding, blue = departed, amber = delayed/approach,
// red = cancelled/diverted/gate closed. One deliberate difference from the
// info display here: "Scheduled" is green (not grey) on this hero card.
function toneFor(s: string) {
  const key = statusKey(s);
  if (key === "checkin") return "grey";
  if (key === "departed") return "info";
  if (key === "onapproach" || key === "finalcall" || key === "delayed") return "warn";
  if (key === "gateclosed" || key === "cancelled" || key === "diverted") return "bad";
  return "ok";
}

// 'En Route'/'Departed' are real internal states the ADS-B tracker uses for
// an arrival's own progression, but every passenger-facing display collapses
// them to 'On Time' before rendering — see displayStatus() in the FIDS's
// public/board.js and public/operator.js, and the same fix applied on
// /flights. Mirrored here (inert today since flightsToday is always empty
// at prerender, but kept correct for when the client script's own copy of
// this function runs against real data below).
function displayStatus(f: SyncedFlight) {
  const s = f.status || "Scheduled";
  if (f.type === "arrival" && (s === "En Route" || s === "Departed")) return "On Time";
  return s;
}

// Hero ops-panel — derived from flightsToday so both are always in sync.
// Capped at the 4 nearest departures; the card shows a fallback line
// (below) when there are none left today.
const HERO_MAX = 4;
const heroDepartures = flightsToday
  .filter((f) => f.type === "departure" && f.status !== "Departed")
  .slice(0, HERO_MAX)
  .map((f) => ({
    time: f.time,
    dest: f.city,
    flight: `${f.flightNo} · ${f.airline}`,
    status:
      statusKey(displayStatus(f)) === "delayed" && f.estTime ? `→ ${f.estTime}` :
      displayStatus(f),
    tone: toneFor(displayStatus(f)),
  }));
const heroArrivals = flightsToday
  .filter((f) => f.type === "arrival" && f.status !== "Landed")
  .slice(0, HERO_MAX)
  .map((f) => ({
    time: f.time,
    dest: f.city,
    flight: `${f.flightNo} · ${f.airline}`,
    status:
      statusKey(displayStatus(f)) === "delayed" && f.estTime ? `→ ${f.estTime}` :
      displayStatus(f),
    tone: toneFor(displayStatus(f)),
  }));

// Hero weather (static placeholder — wire to Met Éireann or METAR post-firma)
const heroWeather = { tempC: 12, condition: "Néalta scaipthe", windDir: "SW", windKt: 14, visKm: 10 };

// Destinations — horizontal-scroll panels. Each panel is one viewport
// wide on desktop; on mobile they stack vertically.
// City names use their Irish forms (Baile Átha Cliath / Glaschú), matching
// the real Irish-language press material already reused in the news
// articles — not the Footer's English-form convention.
const destinations = [
  {
    code: "DUB",
    city: "Baile Átha Cliath",
    country: "Éire",
    duration: "55 nóim.",
    schedule: "Gach lá · 2× fillte",
    carrier: "Aer Lingus Regional",
    hero: "/photos/dest-dub.webp",
    heroMobile: "/photos/dest-dub-mobile.webp",
    photoPos: "center center",
    bookUrl: "https://www.aerlingus.com",
  },
  {
    code: "GLA",
    city: "Glaschú",
    country: "Albain",
    duration: "1 u",
    schedule: "Bliain ar fad",
    carrier: "Loganair",
    hero: "/photos/dest-gla.webp",
    heroMobile: "/photos/dest-gla-mobile.webp",
    photoPos: "center 20%",
    bookUrl: "https://www.loganair.co.uk",
  },
];

// Awards — editorial blocks, not cards. Big year, big claim, no
// bounded rectangles. Sourced from CFN press history (verify dates).
const awards = [
  {
    year: "2024",
    title: "An chéad aerfort ar oileán na hÉireann",
    detail: "a bhain Leibhéal 4 'Claochlú' de Chreidiúnú Carbóin Aerfoirt amach.",
    source: "ACA · Airports Council International",
  },
  {
    year: "2018",
    title: "An rúidbhealach is suaithinsí ar domhan",
    detail: "Roghnaithe mar Uimhir a 1 ag painéal domhanda phíolótaí agus lucht taistil PrivateFly.",
    source: "PrivateFly",
  },
  {
    year: "2016",
    title: "I measc na 10 dtuirlingt is áille ar domhan",
    detail: "Gearrliosta domhanda PrivateFly — cur chuige trá Charraig Fhinn le Sliabh an Earagail sa radharc.",
    source: "PrivateFly",
  },
];

// News — read from src/content/news/ (managed via Keystatic CMS).
// titleGa/kindGa are required going forward for new articles (see
// keystatic.config.ts) but fall back to the English copy for any of the
// existing articles that haven't been translated yet.
const IRISH_MONTHS = [
  "Eanáir", "Feabhra", "Márta", "Aibreán", "Bealtaine", "Meitheamh",
  "Iúil", "Lúnasa", "Meán Fómhair", "Deireadh Fómhair", "Samhain", "Nollaig",
];
const newsEntries = await getCollection("news");
const _newsSorted = newsEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const _mapNews = (n: (typeof _newsSorted)[0]) => ({
  slug: n.id,
  date: `${n.data.date.getDate()} ${IRISH_MONTHS[n.data.date.getMonth()]} ${n.data.date.getFullYear()}`,
  kind: n.data.kindGa || n.data.kind,
  title: n.data.titleGa || n.data.title,
  image: n.data.image
    ? n.data.image.startsWith("/") ? n.data.image : `/photos/${n.data.image}`
    : "/photos/intro-airport.webp",
});
const news = _newsSorted.slice(0, 7).map(_mapNews);
---

<BaseLayout title={title} description={description}>

  {/* ---------- HERO — "Live Ops" (Distribution A) ----------
      Mirrors index.astro (EN) section-for-section — same classes, same
      data-attributes, same scripts. Only the visible copy changes. */}
  <section
    data-scrub-trigger
    data-hero-scroll
    class="relative isolate h-screen w-full md:h-[300vh]"
  >

    {/* ── Layer 1: sticky background ─────────────────────────────── */}
    <div class="sticky top-0 h-screen w-full overflow-hidden" aria-hidden="true">
      <img
        data-ken-burns
        src="/video/frames/frame-0001.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[center_55%]"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <canvas
        data-scrub-canvas
        data-frames="121"
        data-fps="24"
        data-frame-path="/video/frames/frame-"
        data-scrub-start="top top"
        data-scrub-end="bottom bottom"
        data-video-start={String(trim.start)}
        data-video-end={String(trim.end)}
        class="absolute inset-0 block h-full w-full"
      ></canvas>
      <div class="absolute inset-x-0 top-0 h-[220px] bg-gradient-to-b from-[rgba(18,22,29,0.60)] to-transparent" />
      <div class="absolute inset-y-0 left-0 w-[65%] bg-gradient-to-r from-[rgba(18,22,29,0.52)] to-transparent" />
      <div class="absolute inset-x-0 bottom-0 h-[160px] bg-gradient-to-t from-[rgba(18,22,29,0.45)] to-transparent" />
      <div class="absolute inset-y-0 left-0 w-[80%] bg-gradient-to-r from-[rgba(9,13,20,0.4)] to-transparent md:hidden" />
    </div>

    {/* ── Layer 2: hero content (scrolls with page) ──────────────── */}
    <div
      class="cfn-hero-content absolute left-0 top-0 z-10 flex h-screen w-full flex-col"
      style="padding: calc(var(--header-h) + 3rem) 3.5rem 2.5rem"
    >
      <div class="flex flex-1 items-center justify-between gap-[60px]">

        {/* ── Hero lead (left column) ── */}
        <div class="flex min-w-0 flex-1 flex-col gap-7">
          <p
            data-animate="fade-up"
            data-edit="hero-eyebrow"
            class="font-mono text-[11px] uppercase tracking-[0.16em] md:text-[15px] md:tracking-[0.26em]"
            style="color: var(--hi)"
          >
            <span class="md:hidden">Aerfort Dhún na nGall · CFN</span>
            <span class="hidden md:inline">Aerfort Dhún na nGall · Co. Dhún na nGall · CFN</span>
          </p>

          <h1
            data-split
            data-split-delay="0.15"
            data-edit="hero-h1"
            class="hero-display md:whitespace-nowrap"
          >
            Aerfort<br />Dhún na nGall
          </h1>

          <p
            data-animate="fade-up"
            data-animate-delay="0.35"
            data-edit="hero-lede"
            class="max-w-[820px] text-[12px] leading-[1.45] md:text-[24px]"
            style="color: var(--hi)"
          >
            Baile Átha Cliath gach lá. Glaschú ag an deireadh seachtaine — agus
            roinnt laethanta samhraidh. Tá aerfort Dhún na nGall suite san áit
            a dtosaíonn an tAigéan Atlantach.
          </p>

          <div
            data-animate="fade-up"
            data-animate-delay="0.5"
            class="flex flex-col items-start gap-4 md:flex-row md:items-center md:gap-[34px]"
          >
            <a href="/ga/flights" class="hero-cta hero-cta--primary" data-edit="cta-primary">
              Eitiltí an lae inniu <span class="arrow">→</span>
            </a>
            <a href="/ga/plan#parking" class="hero-cta" data-edit="cta-secondary">
              Páirceáil agus conas teacht anseo <span class="arrow">→</span>
            </a>
          </div>
        </div>

        {/* ── Live Ops Panel (right column, desktop only) ── */}
        <aside class="ops-panel hidden lg:flex lg:flex-col">

          <div class="flex items-start justify-between">
            <span
              class="font-mono text-[14px] uppercase tracking-[0.18em]"
              style="color: var(--hi-amber)"
            >
              Inniu
            </span>
            <div class="flex flex-col items-end gap-[3px]">
              <span
                id="ops-clock"
                class="font-mono-num text-[13.5px] tracking-[0.08em]"
                style="color: var(--hi)"
              >
                — — : — —
              </span>
              <span
                id="ops-clock-utc"
                class="font-mono-num text-[11.5px] tracking-[0.06em]"
                style="color: var(--hi)"
              >
                — — : — — <span style="opacity:0.75">UTC</span>
              </span>
            </div>
          </div>

          <div
            class="mt-[14px] pb-[18px]"
            style="border-bottom: 1px solid var(--hi-line)"
          >
            <div class="flex items-baseline gap-[10px]">
              <span id="wx-temp" class="ops-temp">{heroWeather.tempC}°C</span>
              <span
                id="wx-cond"
                class="font-mono text-[17px] leading-none"
                style="color: var(--hi)"
              >{heroWeather.condition}</span>
            </div>
            <div
              class="mt-[7px] flex items-baseline gap-[8px] font-mono-num text-[13px] tracking-[0.04em]"
              style="color: var(--hi-soft)"
            >
              <span id="wx-wind">{heroWeather.windDir} {heroWeather.windKt} kt</span>
              <span style="color: var(--hi-faint)">·</span>
              <span id="wx-vis" class="text-[13px]">Léargas {heroWeather.visKm} km</span>
            </div>
          </div>

          <div
            class="mt-[18px] flex items-center justify-between font-mono text-[12.5px] uppercase tracking-[0.16em]"
            style="color: var(--hi)"
          >
            <span>Imeachtaí atá le teacht</span>
            <span
              class="flex items-center gap-[7px] text-[11px] uppercase tracking-[0.12em]"
              style="color: var(--hi-green)"
            >
              <span class="live-dot ops-badge"></span>Beo
            </span>
          </div>

          <ul class="mt-[6px]" id="hero-deps">
            {heroDepartures.length ? (
              heroDepartures.map((dep) => (
                <li class="ops-board-row">
                  <span class="b-time">{dep.time}</span>
                  <span class="b-dest">{dep.dest}</span>
                  <span class={`b-status ${dep.tone}`}>{dep.status}</span>
                  <span class="b-flight">{dep.flight}</span>
                </li>
              ))
            ) : (
              <li class="py-2 font-mono text-[12.5px] uppercase tracking-[0.1em]" style="color: var(--hi-soft)">
                Níl aon imeacht eile inniu
              </li>
            )}
          </ul>

          <div
            class="mt-[18px] flex items-center justify-between pt-[16px] font-mono text-[12.5px] uppercase tracking-[0.16em]"
            style="border-top: 1px solid var(--hi-line); color: var(--hi)"
          >
            <span>Teachtaí atá le teacht</span>
          </div>
          <ul class="mt-[6px]" id="hero-arrs">
            {heroArrivals.length ? (
              heroArrivals.map((arr) => (
                <li class="ops-board-row">
                  <span class="b-time">{arr.time}</span>
                  <span class="b-dest">{arr.dest}</span>
                  <span class={`b-status ${arr.tone}`}>{arr.status}</span>
                  <span class="b-flight">{arr.flight}</span>
                </li>
              ))
            ) : (
              <li class="py-2 font-mono text-[12.5px] uppercase tracking-[0.1em]" style="color: var(--hi-soft)">
                Níl aon teacht eile inniu
              </li>
            )}
          </ul>

          <div class="mt-[10px] flex justify-end">
            <a href="/ga/flights" class="ops-cta-link">
              Painéal iomlán <span class="arrow">→</span>
            </a>
          </div>
        </aside>
      </div>

      {/* Desktop only — see the English page's identical comment. */}
      <div
        class="hidden items-center gap-[10px] font-mono text-[12px] uppercase tracking-[0.22em] md:flex"
        style="color: var(--hi-faint)"
        aria-hidden="true"
      >
        Scrollaigh síos <span class="hero-bob">↓</span>
      </div>
    </div>

    {/* Live clock script — weekday/month names translated to Irish.
        Browser Intl support for the "ga" locale is unreliable (tested:
        this environment's ICU data silently falls back to the OS locale
        instead of erroring, showing Spanish "jueves"/"ene" — not English,
        not Irish). So: get the day/month via the always-reliable "en-IE"
        locale and map those English short names to Irish through a fixed
        lookup table instead of trusting Intl to localise them itself. */}
    <script is:inline>
      (function () {
        // Checked at tick time (not baked in once): Astro's client-side
        // router doesn't reliably re-run an inline <script> that's
        // structurally similar to one already executed on a prior page, so
        // whichever page's copy of this script last actually ran can stay
        // "in charge" of tick() even after navigating to the other locale.
        // Reading document.documentElement.lang fresh each tick makes the
        // output self-correct regardless of which file's script instance
        // is the one still running.
        const WEEKDAY_GA = { Sun:'Domh', Mon:'Luan', Tue:'Máirt', Wed:'Céad', Thu:'Déar', Fri:'Aoine', Sat:'Sath' };
        const MONTH_GA = { Jan:'Ean', Feb:'Feabh', Mar:'Márta', Apr:'Aib', May:'Beal', Jun:'Meith', Jul:'Iúil', Aug:'Lún', Sep:'MFómh', Oct:'DFómh', Nov:'Samh', Dec:'Noll' };
        function startClock() {
          const el    = document.getElementById('ops-clock');
          const utcEl = document.getElementById('ops-clock-utc');
          if (!el) return;
          // Shared window-level key (not a closure-local variable): the EN
          // and GA home pages each register this same inline script, and a
          // client-side nav between them doesn't tear down the previous
          // page's setInterval — a locally-scoped timer var can never see
          // (and clear) the other page's stale one. This must clear
          // whichever page's timer is currently running, regardless of
          // which page set it.
          if (window.__cfnClockTimer) clearInterval(window.__cfnClockTimer);
          function tick() {
            const isGa = document.documentElement.lang === 'ga';
            const d = new Date();
            const parts = new Intl.DateTimeFormat('en-IE', {
              timeZone: 'Europe/Dublin',
              weekday: 'short', day: 'numeric', month: 'short',
              hour: '2-digit', minute: '2-digit', hour12: false
            }).formatToParts(d).reduce(function(acc, p) { acc[p.type] = p.value; return acc; }, {});
            const wd = isGa ? (WEEKDAY_GA[parts.weekday] || parts.weekday) : parts.weekday;
            const mo = isGa ? (MONTH_GA[parts.month] || parts.month) : parts.month;
            el.textContent = wd + ' ' + parts.day + ' ' + mo + ' · ' + parts.hour + ':' + parts.minute;
            if (utcEl) {
              const uh = String(d.getUTCHours()).padStart(2,'0');
              const um = String(d.getUTCMinutes()).padStart(2,'0');
              utcEl.innerHTML = uh + ':' + um + ' <span>UTC</span>';
            }
          }
          tick();
          window.__cfnClockTimer = setInterval(tick, 60_000);
        }
        // Listeners also accumulate across client-side navs (each page's
        // copy of this script calls addEventListener with a NEW function
        // reference, so old ones are never removed) — whichever locale
        // registered last then keeps "winning" the synchronous tick() on
        // every future astro:page-load, even on a page of the other
        // language. Remove whatever this same shared key points to first,
        // then register + run this page's own version immediately.
        if (window.__cfnStartClock) document.removeEventListener('astro:page-load', window.__cfnStartClock);
        window.__cfnStartClock = startClock;
        document.addEventListener('astro:page-load', startClock);
        startClock();
      })();
    </script>

    {/* Live weather — same Open-Meteo source as EN, WMO code labels in
        Irish. Compass letters (N/NE/E/SE/S/SW/W/NW) are kept as the
        international meteorological convention rather than translated. */}
    <script is:inline>
      (function () {
        // See the clock script's comment above: listeners also accumulate
        // across client-side navs (each page's copy of this script adds a
        // NEW function reference), so the other locale's handler can fire
        // after this one and overwrite this page's just-set text. Remove
        // whatever this shared key points to first.
        if (window.__cfnInitWx) document.removeEventListener('astro:page-load', window.__cfnInitWx);
        window.__cfnInitWx = init;
        document.addEventListener('astro:page-load', init);
        init();

        function init() {
        if (!document.getElementById('wx-temp')) return;
        // Shared window-level key — see the clock script above for why a
        // closure-local timer var can't clear the other locale page's timer.
        if (window.__cfnWxTimer) clearInterval(window.__cfnWxTimer);
        // Both languages' tables live here (see the clock script's comment
        // on why) — apply() re-checks documentElement.lang on every call,
        // not just once at init, so this self-corrects even if the other
        // locale's script instance is the one still running.
        const WMO_EN = {
          0:'Clear sky', 1:'Mainly clear', 2:'Partly cloudy', 3:'Overcast',
          45:'Fog', 48:'Icy fog',
          51:'Light drizzle', 53:'Drizzle', 55:'Heavy drizzle',
          61:'Light rain', 63:'Rain', 65:'Heavy rain',
          71:'Light snow', 73:'Snow', 75:'Heavy snow',
          77:'Snow grains',
          80:'Rain showers', 81:'Heavy showers', 82:'Violent showers',
          85:'Snow showers', 86:'Heavy snow showers',
          95:'Thunderstorm', 96:'Storm & hail', 99:'Storm & heavy hail',
        };
        const WMO_GA = {
          0:'Spéir ghlan', 1:'Den chuid is mó glan', 2:'Scamallach go páirteach', 3:'Ró-scamallach',
          45:'Ceo', 48:'Ceo oighreata',
          51:'Braonta éadroma', 53:'Braonta', 55:'Braonta troma',
          61:'Báisteach éadrom', 63:'Báisteach', 65:'Báisteach throm',
          71:'Sneachta éadrom', 73:'Sneachta', 75:'Sneachta trom',
          77:'Gráinníní sneachta',
          80:'Cithfholcadh báistí', 81:'Cithfholcadh trom', 82:'Cithfholcadh foréigneach',
          85:'Cithfholcadh sneachta', 86:'Cithfholcadh sneachta trom',
          95:'Stoirm thoirní', 96:'Stoirm agus clocha sneachta', 99:'Stoirm agus clocha sneachta troma',
        };
        const DIRS = ['N','NE','E','SE','S','SW','W','NW'];
        const compassDir = (deg) => DIRS[Math.round(deg / 45) % 8];

        const URL =
          'https://api.open-meteo.com/v1/forecast' +
          '?latitude=55.0441&longitude=-8.3411' +
          '&current=temperature_2m,weather_code,' +
          'wind_speed_10m,wind_direction_10m,visibility' +
          '&timezone=Europe%2FDublin';

        function apply(data) {
          const isGa = document.documentElement.lang === 'ga';
          const c = data.current;
          const tempEl = document.getElementById('wx-temp');
          const condEl = document.getElementById('wx-cond');
          const windEl = document.getElementById('wx-wind');
          const visEl  = document.getElementById('wx-vis');
          if (!tempEl) return;

          tempEl.textContent = Math.round(c.temperature_2m) + '°C';
          condEl.textContent = (isGa ? WMO_GA : WMO_EN)[c.weather_code] ?? (isGa ? 'Athraitheach' : 'Variable');

          const kt  = Math.round(c.wind_speed_10m / 1.852);
          windEl.textContent = compassDir(c.wind_direction_10m) + ' ' + kt + ' kt';

          const visMetre = c.visibility ?? 10000;
          visEl.textContent = (isGa ? 'Léargas ' : 'Vis ') +
            (visMetre >= 10000 ? '10 km' : (visMetre / 1000).toFixed(1) + ' km');
        }

        function fetchWx() {
          fetch(URL)
            .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(apply)
            .catch(() => { /* keep static fallback silently */ });
        }

        fetchWx();
        window.__cfnWxTimer = setInterval(fetchWx, 10 * 60 * 1000);
        }
      })();
    </script>
  </section>

  {/* ---------- EDITORIAL INTRO ---------- */}
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <img
        data-ken-burns
        data-ken-burns-duration="26"
        src="/photos/intro-sunrise.webp"
        alt=""
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-[rgba(18,22,29,0.35)] to-transparent"></div>
    </div>

    <div class="cfn-hero-content mx-auto max-w-7xl px-6 py-32 lg:py-48">
      <div class="max-w-3xl">
        <p
          data-animate="fade-up"
          class="font-mono text-[1.05rem] uppercase tracking-[0.2em]"
          style="color: var(--hi-amber)"
        >
          Carraig Fhinn · Co. Dhún na nGall
        </p>
        <p
          data-split
          data-split-link="hero-lead"
          class="mt-8 max-w-3xl font-display text-[clamp(2.1rem,4.2vw,3.8rem)] font-normal leading-[1.02]"
          style="color: var(--hi)"
        >
          Is sinne an t-aerfort idirnáisiúnta is lú sa tír, agus an ceann leis
          an radharc is fearr.
        </p>
