---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Pilots & drones · Donegal Airport";
const description =
  "Aerodrome reference data, ATC frequencies, PPR procedure, fees & charges and drone operations in the Donegal (EIDL) control zone — from AIP Ireland AD 2 EIDL.";

/* Figures from AIP Ireland — EIDL AD 2 (AIRAC Amdt 004/26, eff 16 APR 2026). Cross-check current AIP & NOTAMs. */

const nav = [
  { id: "data", label: "Aerodrome data" },
  { id: "ppr", label: "PPR & procedures" },
  { id: "fees", label: "Fees & charges" },
  { id: "drones", label: "Drones" },
];

/* At-a-glance stats */
const stats = [
  { big: "02 / 20", small: "Runway · 1495 × 30 m" },
  { big: "30", unit: "ft", small: "Elevation AMSL" },
  { big: "10 NM", small: "CTR · SFC–5000 ft" },
  { big: "5000", unit: "ft", small: "Transition altitude" },
  { big: "129.805", small: "Tower · ATIS 129.930" },
  { big: "CAT 5", small: "Scheduled flights" },
];

/* Detail blocks (accordions) */
const identifiers = [
  ["IATA / ICAO", "CFN / EIDL"],
  ["Aerodrome type", "Civil · Donegal Airport Co."],
  ["ARP", "55°02′39″N 008°20′28″W"],
  ["Position", "2 NM SW of Bunbeg"],
  ["Reference temp", "19.1 °C max · 2.2 °C min"],
  ["Magnetic variation", "2°W (2026) · −11′/yr"],
  ["Traffic permitted", "IFR / VFR"],
];
const runwayFull = [
  ["Bearing", "023° / 203° mag · 020.4° / 200.4° true"],
  ["Surface", "Grooved asphalt · PCN 21/F/B/X/T"],
  ["Displaced THR", "02 → 209 m · 20 → 129 m"],
  ["Strip / RESA", "1562 × 150 m / 120 × 60 m"],
  ["PAPI", "3.3° both (left) · MEHT 43 ft"],
  ["Approach lgt", "02: LIH 420 m\n20: LIH 455 m · LED"],
];
/* Mobile-only: rows whose value wraps to an extra line in the narrow accordion
   column — pull letters (and word gaps) tighter, not smaller, just enough per
   row to read on one line. Desktop is unaffected (sm: resets to normal). */
const tightRows: Record<string, string> = {
  "Reference temp": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]",
  "Magnetic variation": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]",
  "Surface": "tracking-[-0.045em] [word-spacing:-2px] sm:tracking-normal sm:[word-spacing:normal]",
  "Aerodrome type": "tracking-[-0.075em] [word-spacing:-4px] sm:tracking-normal sm:[word-spacing:normal]",
  "Taxiway A": "tracking-[-0.06em] [word-spacing:-3px] sm:tracking-normal sm:[word-spacing:normal]",
  "Displaced THR": "tracking-[-0.03em] sm:tracking-normal",
  "Strip / RESA": "tracking-[-0.03em] sm:tracking-normal",
  "PAPI": "tracking-[-0.03em] sm:tracking-normal",
  "Flight plan": "tracking-[-0.03em] sm:tracking-normal",
  "AFIS": "tracking-[-0.03em] sm:tracking-normal",
  "RFFS": "tracking-[-0.03em] sm:tracking-normal",
};
const declared = [
  { rwy: "02", tora: "1314", toda: "1593", asda: "1314", lda: "1159", thr: "209 m" },
  { rwy: "20", tora: "1332", toda: "1406", asda: "1332", lda: "1203", thr: "129 m" },
];

/* Declared distances — interactive selector (bars to scale by length). */
const DDMAX = 1593; // longest declared distance (TODA 02) → sets the scale
const ddItems = [
  { key: "TORA", name: "Take-Off Run Available", color: "#1a4a6e" },
  { key: "ASDA", name: "Accelerate-Stop Distance Available", color: "#2e7d5b" },
  { key: "TODA", name: "Take-Off Distance Available", color: "#a07840" },
  { key: "LDA", name: "Landing Distance Available", color: "#9c3d54" },
];
type DDRwy = { TORA: number; ASDA: number; TODA: number; LDA: number; disp: number; cwy: number; cwyEnd: string; papi: string; appr: string; note: string };
const ddRwy: Record<string, DDRwy> = {
  "02": { TORA: 1314, ASDA: 1314, TODA: 1593, LDA: 1159, disp: 209, cwy: 279, cwyEnd: "20", papi: "PAPI 3.3° · MEHT 43 ft", appr: "RNP · NDB/DME", note: "Take-off run commences 155 m before the displaced threshold. TODA includes the 279 m clearway beyond the RWY 20 end." },
  "20": { TORA: 1332, ASDA: 1332, TODA: 1406, LDA: 1203, disp: 129, cwy: 74, cwyEnd: "02", papi: "No PAPI serving RWY 20", appr: "RNP · LOC · NDB/DME", note: "Threshold displaced 129 m. TODA includes the 74 m clearway beyond the RWY 02 end." },
};
const ddDir: Record<string, string> = { "02": "→", "20": "←" };

const airspace = [
  ["Designation", "Donegal CTR · within Shannon FIR"],
  ["Lateral limits", "Circle radius 10 NM about ARP"],
  ["Vertical limits", "SFC – 5000 ft AMSL"],
  ["Class", "C (G outside ATC hours)"],
  ["Transition altitude", "5000 ft"],
  ["Flight plan", "Mandatory during ATS hours"],
];
const approaches = [
  ["RWY 02", "RNP (RNAV) · NDB/DME"],
  ["RWY 20", "RNP (RNAV) · LOC · NDB/DME"],
];
const navaids = [
  ["NDB", "CFN · 361 kHz · H24 · DOC 25 NM"],
  ["DME", "IFN · 110.3 MHz (Ch 40X)\nzero at DTHR · DOC 20 NM"],
  ["LOC 20", "IFN · 110.3 MHz · H24"],
];
const comms = [
  ["Tower", "Donegal Tower · 129.805 MHz"],
  ["Ground", "Donegal Ground · 129.805 MHz"],
  ["AFIS", "Donegal Information · 129.805 MHz"],
  ["ATIS", "Donegal ATIS · 129.930 MHz"],
];
const ops = [
  ["RFFS", "CAT 5 (scheduled flights) · fire cover during operating hours"],
  ["North apron", "Bitumen / macadam · PCR 134/F/C/X/T"],
  ["South apron", "Concrete · MTOW 5700 kg · GA parking"],
  ["Taxiway A", "Asphalt · PCN 23/F/B/X/T · 25 m"],
  ["Taxiway B", "Concrete · 12 m"],
  ["Fuel", "Jet A1 only · 10000 L bowser"],
  ["Security", "H24"],
  ["PPR", "Required for all flights"],
  ["Customs / Imm.", "24 HR PN non-EU\n12 HR PN EU"],
];
const cautions = [
  "Wind shear & turbulence in the lee of Mt Errigal — caution on approach to RWY 20 in winds 250°–300°.",
];

/* Opening hours → timeline (UTC). Bar range 06:00–21:00. */
const hoursData = {
  Winter: [
    { day: "Mon–Sun", blocks: [["0740", "0830"], ["0900", "1300"], ["1330", "1700"], ["1800", "2010"]] },
  ],
  Summer: [
    { day: "Mon–Sun", blocks: [["0640", "0730"], ["0800", "1200"], ["1230", "1600"], ["1700", "1910"]] },
  ],
};
const START = 360, SPAN = 900; // 06:00 → 21:00
const toMin = (t: string) => parseInt(t.slice(0, 2)) * 60 + parseInt(t.slice(2));
const pct = (m: number) => ((m - START) / SPAN) * 100;
const ticks = ["06", "09", "12", "15", "18", "21"];

/* Accordion groups */
const accordions = [
  { title: "Identifiers & Location", badge: "AD 2.2", rows: identifiers },
  { title: "Runway — Full Detail", badge: "AD 2.12", rows: runwayFull },
  { title: "Airspace · Donegal CTR", badge: "AD 2.17", rows: airspace },
  { title: "Instrument Approaches", badge: "IAP", rows: approaches },
  { title: "Navigation Aids", badge: "NAV", rows: navaids },
  { title: "Communications", badge: "COMM", rows: comms },
  { title: "Operational", badge: "OPS", rows: ops },
];

/* ── Fees & charges (effective 1 March 2025) ────────────────── */
const feeGroups = [
  { title: "Landing", badge: "per landing", rows: [["Single engine", "€15.00"], ["Twin engine (< 4 t)", "€28.75"], ["Over 4 t", "€17.50 / t or part"]] },
  { title: "Aircraft Parking", badge: "per 24 h", rows: [["First 2 hours", "No charge"], ["Not over 3 t", "€15.00"], ["Not over 10 t", "€35.75"], ["Not over 20 t", "€64.00"], ["Over 20 t", "€80.00"]] },
  { title: "Handling", badge: "per outbound pax", rows: [["Passenger load supplement", "€17.50"], ["Handling fee", "€9.75"], ["Exempt", "Under 2s · non-commercial"]] },
  { title: "Ground Services", badge: "as used", rows: [["Ground power unit", "€51.50 hook-up + €51.50/h or part after 30 min"], ["Hot water", "€35.00"], ["Cleaning catering dishes", "€50.00"], ["Aircraft towing", "€50.00 / tow"], ["Special services", "+15% (min €30)"]] },
  { title: "Out-of-Hours", badge: "48 h notice", rows: [["Airport extension", "€330.00 / aircraft / hour"]] },
  { title: "Hangarage", badge: "+ 23% VAT", rows: [["Private single engine", "€20.00 / 24 h"], ["Private twin engine", "€40.00 / 24 h"], ["Commercial", "€15.00 / t / 24 h"], ["Push in / out", "€50.00 / push"]] },
];

/* ── Drones ─────────────────────────────────────────────────── */
const droneSteps = [
  { n: "01", t: "Register & hold Specific category", d: "Register with the IAA if your drone is over 250 g or has a camera. To fly inside the Donegal CTR you must also hold a Specific-category operating authorisation from the IAA." },
  { n: "02", t: "Check the UAS zone & height limit", d: "Donegal is covered by three UAS Geographical Zones — prohibited inside the red 10 NM CTR, then 15 m and 90 m height limits beyond it (see above)." },
  { n: "03", t: "Request permission in advance", d: "Download the drone request form and email it to atc@donegalairport.ie. ATC assesses your request against the traffic and replies by email. Allow at least 48 hours; requests inside that window may not be processed in time." },
  { n: "04", t: "Phone the tower — before & after", d: "If approved, call Donegal Tower by phone before you launch and again when you land. Keep your phone to hand: traffic can change and ATC may call you to land the drone immediately." },
];

/* Published UAS Geographical Zones for Donegal (IAA / EIDL MATS App. 3) */
const droneZones = [
  { id: "EIU69", tag: "Red · inner core", color: "#c0392b", cond: "No drone flights", note: "The innermost core, closest to the airport." },
  { id: "EIU70", tag: "Amber · middle", color: "#e0a81e", cond: "Max 15 m", note: "The middle ring. Up to 15 m high, or the tallest obstacle within 50 m." },
  { id: "EIU35", tag: "Green · outer", color: "#4a9d5b", cond: "Max 90 m", note: "The outer ring, out to the CTR edge (18.5 km / 10 NM). Cut off to the north-west at the airspace boundary." },
];
---

<BaseLayout title={title} description={description}>
  {/* ─── HERO ─────────────────────────────────────────────────── */}
  <section class="relative isolate flex min-h-[82vh] w-full items-center overflow-hidden">
    <img src="/photos/pilots/pilots-hero.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover object-center" />
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-28 [text-shadow:0_2px_10px_rgba(0,0,0,0.55),0_1px_30px_rgba(0,0,0,0.4)]">
      <p data-animate="fade-up" class="font-mono text-[0.9rem] font-bold uppercase tracking-[0.28em] text-white">Pilots &amp; drones</p>
      <h1 data-split class="hero-display mt-6 max-w-4xl font-display text-[clamp(2.75rem,7vw,6.5rem)] font-normal leading-[0.95] text-white">Operations at CFN.</h1>
      <p data-animate="fade-up" data-animate-delay="0.15" class="mt-8 max-w-2xl text-base font-medium leading-relaxed text-white [text-shadow:0_2px_6px_rgba(0,0,0,0.75),0_1px_16px_rgba(0,0,0,0.6)] sm:text-lg">
        Aerodrome reference data, frequencies, PPR procedure, fees and drone
        operations in the Donegal (EIDL) control zone — from AIP Ireland AD 2.
      </p>
    </div>
  </section>

  {/* ─── ANCHOR NAV ───────────────────────────────────────────── */}
  <nav class="sticky top-[var(--header-h)] z-30 border-y border-line bg-[color-mix(in_srgb,var(--color-surface-lo)_94%,transparent)] shadow-[0_1px_3px_rgba(24,29,22,0.08)] backdrop-blur">
    <div class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {nav.map((n) => (
        <a href={`#${n.id}`} data-nav-link={n.id} class="shrink-0 border-b-2 border-transparent px-4 py-5 text-center font-mono text-[0.82rem] font-bold uppercase tracking-[0.14em] text-ink/70 transition-colors hover:text-atlantic">{n.label}</a>
      ))}
    </div>
  </nav>

  {/* ─── AERODROME DATA ───────────────────────────────────────── */}
  <section id="data" class="scroll-mt-[calc(var(--header-h)+3.5rem)] border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p data-animate="fade-up" class="font-mono text-base font-bold uppercase tracking-[0.3em] text-atlantic">Aerodrome data</p>
      <h2 data-split class="mt-3 font-display text-[clamp(2.2rem,4vw,3.4rem)] font-normal leading-[1.02]">EIDL — the quick reference.</h2>

      {/* At a glance */}
      <div data-animate="fade-up" class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3 lg:grid-cols-6">
        {stats.map((s, i) => (
          <div class={`group bg-surface px-5 py-6 transition-colors duration-300 ${i % 2 === 0 ? "hover:bg-[var(--color-atlantic)]" : "hover:bg-[var(--color-sand)]"}`}>
            <p class="inline-block origin-left font-display text-[clamp(1.5rem,2.4vw,2rem)] leading-none text-ink transition-all duration-300 group-hover:scale-110 group-hover:text-white">{s.big}{s.unit && <span class="ml-0.5 font-mono text-[0.5em] font-medium tracking-tight">{s.unit}</span>}</p>
            <p class="mt-2.5 whitespace-nowrap font-mono text-[0.72rem] uppercase tracking-[-0.02em] text-mute transition-colors duration-300 group-hover:text-white/80 sm:tracking-[0.14em]">{s.small}</p>
          </div>
        ))}
      </div>

      {/* Runway diagram — horizontal schematic, lengths to scale */}
      <div data-animate="fade-up" class="mt-12">
        <p class="font-mono text-[0.82rem] font-bold uppercase tracking-[0.2em] text-sand">Runway 02 / 20</p>
        <div class="mt-4 rounded-2xl border border-line bg-[color-mix(in_srgb,var(--color-atlantic)_4%,var(--color-surface))] px-10 py-6 sm:px-20 sm:py-8">
          {/* Aerodrome chart (Photoshop-edited AIP figure), rotated to read left-to-right
             on desktop. On mobile it's rotated again, in the browser, to a portrait
             view with RWY 02 (023°) at the bottom pointing up — see
             initRunwayDiagramMobile() below. Runway-end bearings are overlaid as crisp
             text rather than baked into the image; each label's own .map-txt/wrapper
             carries a counter-rotation so the numbers stay upright even though the
             canvas around them is rotated 90°. */}
          <div class="relative overflow-visible" id="map-canvas-wrap">
          <div class="relative" id="map-canvas">
            <img
              src="/photos/pilots/aerodrome-chart.png?v=5"
              alt="Donegal Airport aerodrome chart — runway 02/20 with displaced thresholds, turning areas and PAPI"
              width="2896"
              height="392"
              loading="lazy"
              class="w-full"
            />
            {/* bearing + direction of travel, pinned just above each threshold */}
            <span class="map-item absolute left-[19.06%] top-[61.36%] flex -translate-x-1/2 items-center gap-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] text-atlantic sm:left-[18.3%] sm:top-[28.3%] sm:text-[0.74rem]">
              <span class="map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">023°</span>
              <svg viewBox="0 0 24 10" class="h-2 w-6" aria-hidden="true"><line x1="1" y1="5" x2="21" y2="5" stroke="currentColor" stroke-width="1.6" /><polyline points="16,1 22,5 16,9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="map-item absolute left-[77.67%] top-[20.56%] flex -translate-x-1/2 items-center gap-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] text-atlantic sm:left-[79.2%] sm:top-[28.3%] sm:text-[0.74rem]">
              <svg viewBox="0 0 24 10" class="h-2 w-6" aria-hidden="true"><line x1="3" y1="5" x2="23" y2="5" stroke="currentColor" stroke-width="1.6" /><polyline points="8,1 2,5 8,9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span class="map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">203°</span>
            </span>
            {/* displaced-threshold dimension arrows — to scale, draggable as a unit */}
            <span class="map-item absolute left-[8.8%] top-[81.9%] flex -translate-x-1/2 flex-col items-center gap-0.5" style="width:12.1%">
              <svg class="w-full" viewBox="0 0 200 24" preserveAspectRatio="none" style="height:11px" fill="none" aria-hidden="true">
                <g stroke="var(--color-atlantic)" stroke-width="1.6" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="2" y1="2" x2="2" y2="22" /><line x1="198" y1="2" x2="198" y2="22" />
                  <line x1="2" y1="12" x2="198" y2="12" />
                  <polyline points="12,6 2,12 12,18" /><polyline points="188,6 198,12 188,18" />
                </g>
              </svg>
              <span class="map-txt map-counter-rotate rotate-[90deg] font-mono text-[0.58rem] font-bold uppercase tracking-[0.06em] text-atlantic sm:rotate-0 sm:text-[0.7rem]">209 m</span>
            </span>
            <span class="map-item absolute left-[86.1%] top-[87.04%] flex -translate-x-1/2 flex-col items-center gap-0.5 sm:left-[86.2%] sm:top-[60.3%]" style="width:7.5%">
              <svg class="w-full" viewBox="0 0 200 24" preserveAspectRatio="none" style="height:11px" fill="none" aria-hidden="true">
                <g stroke="var(--color-atlantic)" stroke-width="1.6" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="2" y1="2" x2="2" y2="22" /><line x1="198" y1="2" x2="198" y2="22" />
                  <line x1="2" y1="12" x2="198" y2="12" />
                  <polyline points="12,6 2,12 12,18" /><polyline points="188,6 198,12 188,18" />
                </g>
              </svg>
              <span class="map-txt map-counter-rotate rotate-[90deg] font-mono text-[0.58rem] font-bold uppercase tracking-[0.06em] text-atlantic sm:rotate-0 sm:text-[0.7rem]">129 m</span>
            </span>
            {/* clearways */}
            <span class="map-item absolute left-[90.13%] top-[-50.99%] -translate-x-1/2 font-mono text-[0.58rem] font-bold uppercase tracking-[0.08em] text-atlantic sm:left-[90.6%] sm:top-[5.3%] sm:text-[0.68rem]"><span class="map-txt map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">CWY 279 m × 150 m</span></span>
            <span class="map-item absolute left-[10.22%] top-[-51.08%] -translate-x-1/2 font-mono text-[0.58rem] font-bold uppercase tracking-[0.08em] text-atlantic sm:left-[10.5%] sm:top-[2.4%] sm:text-[0.68rem]"><span class="map-txt map-counter-rotate rotate-[90deg] inline-block sm:rotate-0">CWY 74 m × 150 m</span></span>
          </div>
          </div>

          {/* Legend */}
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-5 text-sm">
            <span class="flex items-center gap-2.5"><span class="h-2.5 w-6 rounded-sm bg-[#8a8f8b]"></span><span class="text-mute">Runway 02/20 · <span class="text-ink">1495 × 30 m</span></span></span>
            <span class="flex items-center gap-2.5"><span class="h-3 w-6 rounded-[3px] border border-dashed border-atlantic"></span><span class="text-mute">Clearway (CWY)</span></span>
            <span class="flex items-center gap-2.5"><svg viewBox="0 0 28 12" class="h-3 w-7" aria-hidden="true"><g stroke="var(--color-atlantic)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="24" y2="6" /><polyline points="8,3 4,6 8,9" /><polyline points="20,3 24,6 20,9" /></g></svg><span class="text-mute">Displaced threshold</span></span>
            <span class="flex items-center gap-2.5"><span class="inline-flex gap-0.5"><span class="h-2 w-2 rounded-[1px] bg-white outline outline-1 outline-line"></span><span class="h-2 w-2 rounded-[1px] bg-white outline outline-1 outline-line"></span><span class="h-2 w-2 rounded-[1px] bg-[#c0392b]"></span><span class="h-2 w-2 rounded-[1px] bg-[#c0392b]"></span></span><span class="text-mute">PAPI</span></span>
            <span class="flex items-center gap-2.5"><svg viewBox="0 0 16 16" class="h-4 w-4 text-atlantic" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.3" /><line x1="8" y1="1.5" x2="8" y2="14.5" stroke="currentColor" stroke-width="1.3" /><line x1="1.5" y1="8" x2="14.5" y2="8" stroke="currentColor" stroke-width="1.3" /></svg><span class="text-mute">ARP</span></span>
            <span class="flex items-center gap-2.5"><svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true"><path d="M3 4.5 L13 6.4 L13 9.6 L3 11.5 Z" fill="#e2531f" /></svg><span class="text-mute">Windsock</span></span>
            <a href="https://www.airnav.ie/air-traffic-management/aeronautical-information-management/aip-package/donegal-chart-information" target="_blank" rel="noopener" class="ml-auto font-mono text-[0.62rem] uppercase tracking-[0.14em] text-atlantic transition-colors hover:text-ink">AIP EIDL AD 2 ↗</a>
          </div>
        </div>

        {/* Declared distances — both runways, bars animate in on scroll */}
        <div data-animate="fade-up" class="mt-8" id="dd">
          <p class="font-mono text-[0.82rem] font-bold uppercase tracking-[0.2em] text-sand">Declared distances</p>

          <div class="mt-6 grid gap-x-10 gap-y-8 lg:grid-cols-2">
            {["02", "20"].map((rwy) => {
              const d = ddRwy[rwy];
              return (
                <div class="dd-block" data-rwy={rwy}>
                  <div class="flex items-baseline justify-between gap-3 border-b border-line pb-2">
                    <p class="font-display text-2xl text-ink">RWY {rwy}</p>
                    <p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-mute">{d.appr}</p>
                  </div>
                  <div class="mt-4 space-y-2.5">
                    {ddItems.map((it) => {
                      const v = d[it.key as "TORA"];
                      return (
                        <div class="flex items-center gap-3">
                          <span class="w-9 shrink-0 font-mono text-[0.7rem] font-bold text-ink">{it.key}</span>
                          <div class="relative h-6 flex-1 overflow-hidden rounded bg-[color-mix(in_srgb,var(--color-ink)_5%,transparent)]">
                            <div class="dd-fill flex h-full items-center justify-end rounded pr-2" style={`--w:${(v / DDMAX) * 100}%;background:${it.color}`}>
                              <span class="font-mono text-[0.68rem] font-bold text-white">{v} m</span>
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>

          {/* legend — below the diagrams */}
