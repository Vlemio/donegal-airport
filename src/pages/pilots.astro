---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Pilots & ATC · Donegal Airport";
const description = "Aerodrome reference data, ATC frequencies, PPR, drone operations in the Donegal CTR and special operations at Carrickfinn.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-40">
    <p class="text-xs uppercase tracking-[0.28em] text-atlantic">Pilots & ATC</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl leading-[1.05] sm:text-6xl">
      Operations at CFN.
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">
      Aerodrome data, frequencies, PPR procedure, drone operations
      and the beach-landing approach — straight from the tower.
    </p>

    <div data-animate="fade-up" class="mt-12 grid gap-4 font-mono text-sm sm:grid-cols-2">
      <div class="rounded-xl border border-line bg-surface-hi p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-sand">IATA</p>
        <p class="mt-2 font-display text-3xl text-ink">CFN</p>
      </div>
      <div class="rounded-xl border border-line bg-surface-hi p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-sand">ICAO</p>
        <p class="mt-2 font-display text-3xl text-ink">EIDL</p>
      </div>
      <div class="rounded-xl border border-line bg-surface-hi p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-sand">Runway</p>
        <p class="mt-2 font-display text-2xl text-ink">02/20 · 1 495 × 30 m</p>
      </div>
      <div class="rounded-xl border border-line bg-surface-hi p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-sand">Tower / ATIS</p>
        <p class="mt-2 font-display text-2xl text-ink">129.805 / 129.930</p>
      </div>
    </div>

    <div data-animate="fade-up" class="mt-10 rounded-2xl border border-dashed border-line bg-surface-hi p-10 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-mute">Coming next</p>
      <p class="mt-3 text-base text-ink">
        PPR online form · CTR drone map · approach types · AIP link · beach-landing operations notes.
      </p>
    </div>
  </section>
</BaseLayout>
