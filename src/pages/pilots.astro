  <script>
    document.addEventListener("astro:page-load", () => {
      // Declared here (not next to initEidlWeather() below) because that
      // function is called earlier in this listener (initEidlWeather();)
      // than its own body appears in the file — a plain `let` down there
      // would still be in its temporal dead zone at call time and throw,
      // silently aborting the rest of this listener (initMapEditor()
      // included) on every run.
      let eidlWeatherTimer: ReturnType<typeof setInterval> | undefined;
      const links = [...document.querySelectorAll<HTMLElement>("[data-nav-link]")];
      if (!links.length) return;
      const setActive = (id: string) => {
        links.forEach((l) => l.classList.toggle("is-active", l.dataset.navLink === id));
        // The nav strip scrolls horizontally on narrow screens, so the active
        // link can end up off-screen — center it into view alongside the
        // underline. Scroll the strip's own scrollLeft directly (not
        // scrollIntoView) so only this row moves — scrollIntoView walks up
        // to ancestor scroll containers too and was dragging the whole page
        // sideways along with it.
        const active = links.find((l) => l.dataset.navLink === id);
        const scroller = active?.parentElement;
        if (active && scroller) {
          scroller.scrollTo({
            left: active.offsetLeft - (scroller.clientWidth - active.clientWidth) / 2,
            behavior: "smooth",
          });
        }
      };
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (vis) setActive((vis.target as HTMLElement).id);
        },
        { rootMargin: "-40% 0px -55% 0px", threshold: [0, 0.25, 0.5, 1] },
      );
      ["data", "ppr", "fees", "drones"].forEach((id) => {
        const el = document.getElementById(id);
        if (el) obs.observe(el);
      });

      // Declared-distances bars — fill in when scrolled into view
      const dd = document.getElementById("dd");
      if (dd) {
        const ddObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                dd.classList.add("is-in");
                ddObs.disconnect();
              }
            });
          },
          { rootMargin: "0px 0px -20% 0px", threshold: 0.15 },
        );
        ddObs.observe(dd);
      }

      // UAS zones — link map rings and rule cards on hover/focus
      const uas = document.getElementById("uas-zones");
      if (uas) {
        const hot = (id: string, on: boolean) =>
          uas.querySelectorAll('[data-zone="' + id + '"]').forEach((el) => el.classList.toggle("is-hot", on));
        uas.querySelectorAll("[data-zone]").forEach((el) => {
          const id = el.getAttribute("data-zone");
          if (!id) return;
          el.addEventListener("mouseenter", () => hot(id, true));
          el.addEventListener("mouseleave", () => hot(id, false));
          el.addEventListener("focus", () => hot(id, true));
          el.addEventListener("blur", () => hot(id, false));
        });

        // dev-only: drag the schematic labels and read back their coords
        if (new URLSearchParams(location.search).has("edit")) {
          const svg = uas.querySelector("svg");
          const labels = [...uas.querySelectorAll<SVGTextElement>(".uas-label")];
          if (svg && labels.length) {
            const readout = document.createElement("div");
            readout.style.cssText = "margin-top:8px;font:600 11px/1.5 ui-monospace,monospace;color:#1a4a6e;white-space:pre-wrap";
            (svg.parentElement || svg).after(readout);
            const toSvg = (e: PointerEvent) => { const p = svg.createSVGPoint(); p.x = e.clientX; p.y = e.clientY; return p.matrixTransform(svg.getScreenCTM()!.inverse()); };
            const report = () => { readout.textContent = "labels: " + labels.map((l) => `${l.dataset.l}(${Math.round(+l.getAttribute("x")!)},${Math.round(+l.getAttribute("y")!)})`).join("  "); };
            labels.forEach((l) => {
              l.style.pointerEvents = "auto"; l.style.cursor = "move";
              l.addEventListener("pointerdown", (ev: PointerEvent) => {
                ev.preventDefault();
                const move = (e: PointerEvent) => { const p = toSvg(e); l.setAttribute("x", p.x.toFixed(1)); l.setAttribute("y", p.y.toFixed(1)); report(); };
                const up = () => { document.removeEventListener("pointermove", move); document.removeEventListener("pointerup", up); };
                document.addEventListener("pointermove", move);
                document.addEventListener("pointerup", up);
              });
            });
            report();

            // green-cut editor: move the clip in/out (offset) and rotate (angle)
            const cutRect = svg.querySelector("#uas-cut-rect");
            if (cutRect) {
              let ang = 215, off = 104;
              const panel = document.createElement("div");
              panel.style.cssText = "margin-top:6px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;font:600 11px/1.6 ui-monospace,monospace;color:#1a4a6e";
              panel.innerHTML = 'cut angle <input type="range" min="0" max="360" step="1" data-cut="ang" style="vertical-align:middle"> offset <input type="range" min="-20" max="150" step="1" data-cut="off" style="vertical-align:middle"> <span data-cut-read></span>';
              readout.after(panel);
              const angEl = panel.querySelector('[data-cut="ang"]') as HTMLInputElement;
              const offEl = panel.querySelector('[data-cut="off"]') as HTMLInputElement;
              const readEl = panel.querySelector("[data-cut-read]") as HTMLElement;
              angEl.value = String(ang); offEl.value = String(off);
              const edge = svg.querySelector("#uas-cut-edge");
              const apply = () => {
                cutRect.setAttribute("transform", `translate(150 150) rotate(${ang}) translate(${off} 0)`);
                if (edge) {
                  const rad = ang * Math.PI / 180;
                  const px = 150 + off * Math.cos(rad), py = 150 + off * Math.sin(rad);
                  const ux = -Math.sin(rad), uy = Math.cos(rad);
                  const t = off < 144 ? Math.sqrt(144 * 144 - off * off) : 0;
                  edge.setAttribute("x1", (px + t * ux).toFixed(1)); edge.setAttribute("y1", (py + t * uy).toFixed(1));
                  edge.setAttribute("x2", (px - t * ux).toFixed(1)); edge.setAttribute("y2", (py - t * uy).toFixed(1));
                }
                readEl.textContent = `angle=${ang}°  offset=${off}`;
              };
              angEl.addEventListener("input", () => { ang = +angEl.value; apply(); });
              offEl.addEventListener("input", () => { off = +offEl.value; apply(); });
              apply();
            }
          }
        }
      }

      // Tower opening-hours interactive widget
      initTowerHours();

      // Live TAF widget
      initEidlWeather();

      // Map label editor — authoring only. On automatically in local dev,
      // or with ?edit in the URL. Never ships to production visitors.
      if (new URLSearchParams(location.search).has("edit")) initMapEditor();

      // Hero F-glyph size editor — authoring only (?edit). The F is created
      // at runtime by data-split, so poll until the .f-fix span exists, then
      // let me resize it with a slider and read back the em value.
      if (new URLSearchParams(location.search).has("edit")) {
        let tries = 0;
        const wait = setInterval(() => {
          const f = document.querySelector<HTMLElement>("h1.hero-display .f-fix");
          if (f) { clearInterval(wait); mountFEditor(f); }
          else if (++tries > 60) clearInterval(wait);
        }, 100);
      }
      function mountFEditor(f: HTMLElement) {
        let em = 1;
        const panel = document.createElement("div");
        panel.style.cssText = "position:fixed;left:14px;bottom:14px;z-index:9999;background:#fff;border:1px solid #1a4a6e;border-radius:10px;padding:10px 12px;box-shadow:0 4px 16px rgba(0,0,0,.18);font:600 12px/1.6 ui-monospace,monospace;color:#1a4a6e;display:flex;gap:10px;align-items:center";
        panel.innerHTML = 'F size <input type="range" min="0.6" max="1.3" step="0.01" value="1" style="vertical-align:middle"> <span data-f-read></span>';
        document.body.appendChild(panel);
        const range = panel.querySelector("input") as HTMLInputElement;
        const read = panel.querySelector("[data-f-read]") as HTMLElement;
        const apply = () => { f.style.fontSize = em + "em"; read.textContent = "font-size: " + em.toFixed(2) + "em"; };
        range.addEventListener("input", () => { em = +range.value; apply(); });
        apply();
      }

      function initTowerHours() {
        const host = document.getElementById("tower-hours");
        const dataEl = document.getElementById("tower-hours-data");
        if (!host || !dataEl) return;
        type Row = { day: string; blocks: [string, string][] };
        const DATA = JSON.parse(dataEl.textContent || "{}") as Record<string, Row[]>;
        const parseHM = (x: string) => { const n = parseInt(x, 10); return Math.floor(n / 100) * 60 + (n % 100); };
        const pad2 = (n: number) => ("0" + n).slice(-2);
        const isSummer = (d: Date) => {
          const y = d.getUTCFullYear();
          const lastSun = (m: number) => { const t = new Date(Date.UTC(y, m + 1, 0)); return t.getUTCDate() - t.getUTCDay(); };
          const start = Date.UTC(y, 2, lastSun(2), 1), end = Date.UTC(y, 9, lastSun(9), 1);
          const t = d.getTime(); return t >= start && t < end;
        };
        const matches = (day: string, dow: number) =>
          day === "Sun" ? dow === 0 : day === "Sat" ? dow === 6 : day === "Mon–Fri" ? dow >= 1 && dow <= 5 : day === "Mon–Sun" ? true : dow >= 1 && dow <= 6;

        let view: string | null = null;
        const render = () => {
          const now = new Date();
          const nowMin = now.getUTCHours() * 60 + now.getUTCMinutes();
          const dow = now.getUTCDay();
          const curSeason = isSummer(now) ? "Summer" : "Winter";
          const season = view || curSeason;
          const fill = season === "Winter" ? "var(--color-atlantic)" : "var(--color-sand)";
          // Mobile: a side-by-side label column left the bar too narrow (blocks show
          // exact minutes, not just hours) and overlapped. Stack the day label above
          // its bar instead, giving the bar the full row width.
          const isMobile = window.matchMedia("(max-width: 1023px)").matches;
          const gridCols = isMobile ? "1fr" : "112px 1fr";
          const rowGap = isMobile ? 6 : 16;

          let statusText = "Closed — scheduled", statusSub = "", open = false;
          const todayRow = (DATA[curSeason] || []).find((r) => matches(r.day, dow));
          if (todayRow) {
            const blks = todayRow.blocks.map((b) => ({ s: parseHM(b[0]), e: parseHM(b[1]), s0: b[0], e0: b[1] }));
            const cur = blks.find((b) => nowMin >= b.s && nowMin < b.e);
            if (cur) { open = true; statusText = "Open — scheduled"; statusSub = "closes " + cur.e0 + "Z · confirm by NOTAM"; }
            else { const next = blks.find((b) => b.s > nowMin); statusText = "Closed — scheduled"; statusSub = (next ? "opens " + next.s0 + "Z" : "reopens tomorrow") + " · confirm by NOTAM"; }
          } else { statusSub = "no scheduled service today · confirm by NOTAM"; }
          const statusCol = open ? "#0e7c66" : "var(--color-mute)";

          // Bar axis: fit tightly to the season's actual open blocks with equal
          // breathing room on both ends, so the empty space at the start of the
          // bar matches the empty space at the end instead of drifting with the season.
          const seasonBlocks = (DATA[season] || []).flatMap((r) => r.blocks);
          const seasonStarts = seasonBlocks.map((b) => parseHM(b[0]));
          const seasonEnds = seasonBlocks.map((b) => parseHM(b[1]));
          const PAD = 50;
          const AX0 = (seasonStarts.length ? Math.min(...seasonStarts) : 360) - PAD;
          const AX1 = (seasonEnds.length ? Math.max(...seasonEnds) : 1260) + PAD;
          const SPAN = AX1 - AX0;
          const TICK_STEP = 3;
          const firstTickH = Math.ceil(AX0 / 60 / TICK_STEP) * TICK_STEP;
          const lastTickH = Math.floor(AX1 / 60 / TICK_STEP) * TICK_STEP;
          const tickHours: number[] = [];
          for (let h = firstTickH; h <= lastTickH; h += TICK_STEP) tickHours.push(h);

          const rowsHtml = (DATA[season] || []).map((r) => {
            const isToday = season === curSeason && matches(r.day, dow);
            const blocksHtml = r.blocks.map((b) => {
              const s = parseHM(b[0]), e = parseHM(b[1]);
              const left = (s - AX0) / SPAN * 100, width = (e - s) / SPAN * 100, mid = ((s + e) / 2 - AX0) / SPAN * 100;
              return `<div style="position:absolute;top:7px;height:22px;left:${left}%;width:${width}%;background:${fill};border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.14)"></div>`
                + `<div style="position:absolute;top:34px;left:${mid}%;transform:translateX(-50%);white-space:nowrap;font-family:var(--font-mono);font-size:10.5px;color:var(--color-mute)">${b[0]}–${b[1]}</div>`;
            }).join("");
            const showNow = isToday && nowMin >= AX0 && nowMin <= AX0 + SPAN;
            const nowPos = (nowMin - AX0) / SPAN * 100;
            const nowHtml = showNow
              ? `<div style="position:absolute;top:2px;height:32px;width:2px;left:${nowPos}%;background:#b4462f;border-radius:2px;z-index:5"><div style="position:absolute;top:-15px;left:50%;transform:translateX(-50%);white-space:nowrap;font-family:var(--font-mono);font-size:9px;font-weight:600;letter-spacing:.06em;color:#b4462f">${pad2(now.getUTCHours()) + pad2(now.getUTCMinutes())}Z</div></div>`
              : "";
            const todayTagStyle = isMobile
              ? "font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;color:#b4462f;white-space:nowrap"
              : "font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;color:#b4462f;margin-top:4px";
            const todayTag = isToday ? `<div style="${todayTagStyle}">● TODAY</div>` : "";
            const labelWrapStyle = isMobile
              ? "display:flex;align-items:baseline;justify-content:space-between;gap:10px"
              : "padding-top:5px";
            return `<div style="padding:13px 12px;margin:0 -12px;border-radius:12px;background:${isToday ? "color-mix(in srgb,var(--color-atlantic) 8%,transparent)" : "transparent"}">`
              + `<div style="display:grid;grid-template-columns:${gridCols};gap:${rowGap}px;align-items:start">`
              + `<div style="${labelWrapStyle}"><div style="font-size:15px;font-weight:700;letter-spacing:-.01em;color:var(--color-ink)">${r.day}</div>${todayTag}</div>`
              + `<div style="position:relative;height:54px"><div style="position:absolute;top:7px;height:22px;left:0;right:0;background:var(--color-surface-lo);border-radius:8px"></div>${blocksHtml}${nowHtml}</div>`
              + `</div></div>`;
          }).join("");

          const ticksHtml = tickHours.map((h) => {
            const left = (h * 60 - AX0) / SPAN * 100;
            return `<div style="position:absolute;top:5px;left:${left}%;transform:translateX(-50%);font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;color:var(--color-mute)">${pad2(h)}</div>`;
          }).join("");

          const btn = (label: string, on: boolean, col: string) =>
            `<button data-season="${label}" style="cursor:pointer;border:none;border-radius:999px;padding:8px 20px;font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;background:${on ? "var(--color-surface)" : "transparent"};color:${on ? col : "var(--color-mute)"};font-weight:${on ? 600 : 400};box-shadow:${on ? "0 1px 2px rgba(0,0,0,.1)" : "none"};transition:all .15s ease">${label}</button>`;

          const statusPill = `<div style="display:flex;align-items:center;gap:11px;background:var(--color-surface-lo);border:1px solid var(--color-line);border-radius:12px;padding:11px 16px">`
            + `<span style="position:relative;width:9px;height:9px;flex:0 0 auto">${open ? `<span style="position:absolute;inset:0;border-radius:50%;background:${statusCol};animation:pulseDot 2s ease-out infinite"></span>` : ""}<span style="position:absolute;inset:0;border-radius:50%;background:${statusCol}"></span></span>`
            + `<div style="line-height:1.15"><div style="font-size:14px;font-weight:700;letter-spacing:-.01em;color:var(--color-ink)">${statusText}</div><div style="font-family:var(--font-mono);font-size:11px;color:var(--color-mute);margin-top:2px">${statusSub}</div></div></div>`;

          const seasonNote = season === curSeason ? "Current schedule in effect" : "Preview — not in effect now";
          const noteCol = season === curSeason ? "var(--color-ink)" : "#b4462f";

          host.innerHTML =
            `<div style="display:flex;flex-wrap:wrap;gap:16px 20px;align-items:flex-start;justify-content:space-between;margin-bottom:24px">`
            + `<div><div style="font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--color-sand);margin-bottom:9px">Air Traffic Control</div>`
            + `<h3 style="font-family:var(--font-display);font-size:clamp(22px,3vw,27px);font-weight:400;letter-spacing:-.02em;line-height:1.05;margin:0;color:var(--color-ink)">Tower opening hours</h3>`
            + `<div style="font-family:var(--font-mono);font-size:11.5px;letter-spacing:.06em;color:var(--color-mute);margin-top:7px">Donegal · EIDL · all times UTC (Z)</div></div>`
            + statusPill + `</div>`
            + `<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:26px">`
            + `<div style="display:inline-flex;background:var(--color-surface-lo);border-radius:999px;padding:4px;gap:2px">${btn("Winter", season === "Winter", "var(--color-atlantic)")}${btn("Summer", season === "Summer", "var(--color-sand)")}</div>`
            + `<div style="font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.04em;color:${noteCol}">${seasonNote}</div></div>`
            + `<div>${rowsHtml}<div style="display:grid;grid-template-columns:${gridCols};gap:${rowGap}px;margin-top:6px"><div></div><div style="position:relative;height:18px;border-top:1px solid var(--color-line)">${ticksHtml}</div></div></div>`
            + `<div style="margin:26px 0 0;padding-top:20px;border-top:1px solid var(--color-line)">`
            + `<p style="font-size:13.5px;line-height:1.6;color:var(--color-mute);margin:0">The tower is <strong style="color:var(--color-ink);font-weight:600">closed between the blocks shown</strong> (controller rest breaks) and outside them. Movements outside published hours are by out-of-hours arrangement — 48 h notice.</p>`
            + `<div style="display:flex;flex-direction:column;gap:9px;margin-top:16px">`
            + `<div style="display:grid;grid-template-columns:78px 1fr;gap:12px;align-items:baseline"><span style="font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.14em;color:var(--color-sand)">SUMMER</span><span style="font-size:13.5px;line-height:1.5;color:var(--color-mute)">Applies from the last Sunday of March to the last Sunday of October (Irish daylight-saving time).</span></div>`
            + `<div style="display:grid;grid-template-columns:78px 1fr;gap:12px;align-items:baseline"><span style="font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.14em;color:var(--color-atlantic)">WINTER</span><span style="font-size:13.5px;line-height:1.5;color:var(--color-mute)">Applies from the last Sunday of October to the last Sunday of March (standard time).</span></div></div>`
            + `<p style="font-size:13.5px;font-weight:700;color:var(--color-ink);margin:16px 0 0">Variations are promulgated by NOTAM.</p>`
            + `<a href="https://www.airnav.ie/air-traffic-management/notam-notice-to-airmen-24e348473e7b0153452e634c36c72213" target="_blank" rel="noopener" style="display:inline-block;margin-top:8px;font-family:var(--font-mono);font-size:11.5px;font-weight:600;letter-spacing:.06em;color:var(--color-atlantic);text-decoration:underline;text-underline-offset:2px">Current NOTAMs — AirNav Ireland ↗</a></div>`;

          host.querySelectorAll<HTMLElement>("[data-season]").forEach((b) =>
            b.addEventListener("click", () => { view = b.dataset.season || null; render(); }),
          );
        };
        render();
        setInterval(render, 60000);
      }

      function initEidlWeather() {
        const host = document.getElementById("eidl-weather");
        if (!host) return;
        if (eidlWeatherTimer) clearInterval(eidlWeatherTimer);

        const pad2 = (n: number) => ("0" + n).slice(-2);
        const fmtZ = (unixSeconds: number) => {
          const d = new Date(unixSeconds * 1000);
          return `${pad2(d.getUTCDate())}/${pad2(d.getUTCHours())}${pad2(d.getUTCMinutes())}Z`;
        };

        async function load() {
          try {
            const res = await fetch("/api/weather.json?_=" + Date.now());
            const data = await res.json();
            render(data.taf);
          } catch {
            host!.innerHTML = `<p style="font-family:var(--font-mono);font-size:12px;color:var(--color-mute)">Live report unavailable right now — check the current TAF and NOTAMs directly.</p>`;
          }
        }

        // TAF only — EIDL has no automated METAR station outside ATC/AFIS
        // hours, so it isn't reliably available; the forecast (TAF) is.
        function render(taf: any) {
          if (!taf) {
            host!.innerHTML = `<p style="font-family:var(--font-mono);font-size:12px;color:var(--color-mute)">Live report unavailable right now — check the current TAF and NOTAMs directly.</p>`;
            return;
          }

          host!.innerHTML =
            `<div style="margin-bottom:20px">`
            + `<p style="margin:0;font-family:var(--font-mono);font-size:13px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--color-atlantic)">Live weather · TAF</p>`
            + `</div>`
            + `<div>`
            + `<p style="margin:0;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--color-mute)">TAF · valid ${fmtZ(taf.validTimeFrom)} – ${fmtZ(taf.validTimeTo)}</p>`
            + `<p style="margin:12px 0 0;font-family:var(--font-mono);font-size:13px;line-height:1.6;color:var(--color-ink);word-break:break-word">${taf.rawTAF ?? "—"}</p>`
            + `</div>`;
        }

        load();
        eidlWeatherTimer = setInterval(load, 300000);
      }

      function initMapEditor() {
        const canvas = document.getElementById("map-canvas");
        if (!canvas || canvas.dataset.editorReady) return;
        canvas.dataset.editorReady = "1";
        canvas.style.touchAction = "none";
        // The toolbar lives on the wrap (not the canvas) so the mobile
        // preview's rotation — applied to #map-canvas — doesn't drag the
        // toolbar diagonally along with it.
        const wrap = document.getElementById("map-canvas-wrap") || canvas;

        const labelCls = "map-item map-user absolute flex -translate-x-1/2 items-center gap-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] text-atlantic sm:text-[0.74rem]";
        const arrowRight = '<svg viewBox="0 0 24 10" class="h-2 w-6" aria-hidden="true"><line x1="1" y1="5" x2="21" y2="5" stroke="currentColor" stroke-width="1.6"/><polyline points="16,1 22,5 16,9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';

        const bar = document.createElement("div");
        bar.contentEditable = "false";
        bar.style.cssText = "position:absolute;top:8px;left:8px;z-index:30;display:flex;gap:6px;align-items:center;background:rgba(24,29,22,.85);color:#fff;padding:6px 8px;border-radius:8px;font:700 11px/1 ui-monospace,monospace;user-select:none";
        bar.innerHTML = '<span data-handle style="cursor:move;opacity:.75;user-select:none;padding-right:2px">⠿ EDIT</span>'
          + '<button data-act="text" style="cursor:pointer;background:#1a4a6e;color:#fff;border:0;padding:5px 8px;border-radius:5px;font:inherit">+ Text</button>'
          + '<button data-act="arrow" style="cursor:pointer;background:#1a4a6e;color:#fff;border:0;padding:5px 8px;border-radius:5px;font:inherit">+ Text+arrow</button>'
          + '<button data-act="del" style="cursor:pointer;background:#9c3d54;color:#fff;border:0;padding:5px 8px;border-radius:5px;font:inherit">Delete</button>'
          + '<button data-act="copy" style="cursor:pointer;background:#2e7d5b;color:#fff;border:0;padding:5px 8px;border-radius:5px;font:inherit">Copy layout</button>'
          + '<span data-read style="opacity:.85;min-width:96px"></span>';
        wrap.appendChild(bar);
        const read = bar.querySelector("[data-read]") as HTMLElement;
        let selected: HTMLElement | null = null;

        // drag the toolbar itself by its handle
        const handle = bar.querySelector("[data-handle]") as HTMLElement;
        handle.addEventListener("pointerdown", (ev: PointerEvent) => {
          ev.preventDefault();
          const c = wrap.getBoundingClientRect(), r = bar.getBoundingClientRect();
          const gx = ev.clientX - r.left, gy = ev.clientY - r.top;
          bar.style.right = "auto";
          const move = (e: PointerEvent) => {
            bar.style.left = (e.clientX - gx - c.left) + "px";
            bar.style.top = (e.clientY - gy - c.top) + "px";
          };
          const up = () => { document.removeEventListener("pointermove", move); document.removeEventListener("pointerup", up); };
          document.addEventListener("pointermove", move);
          document.addEventListener("pointerup", up);
        });

        // Labels are positioned via left/top % on #map-canvas, which the
        // mobile preview below can rotate as one rigid unit (canvas +
        // every label together) to stand the runway upright. Plain
        // bounding-rect math (mouse px ÷ canvas px) only holds when
        // there's no rotation — once rotated, screen-space deltas point in
        // the wrong direction relative to the canvas's own left/top axes,
        // which read as "backwards" dragging. Rather than hand-derive the
        // rotation trig (error-prone, and it'd need to match whatever
        // angle the other script currently has applied), three invisible
        // 0×0 markers are positioned at local (0%,0%)/(100%,0%)/(0%,100%)
        // — exactly like a real label would be — so their on-screen
        // position after the SAME transform gives the canvas's true local
        // axes empirically, whatever the current rotation happens to be.
        const axisOrigin = document.createElement("span");
        const axisX = document.createElement("span");
        const axisY = document.createElement("span");
        [[axisOrigin, 0, 0], [axisX, 100, 0], [axisY, 0, 100]].forEach(([el, l, t]) => {
          (el as HTMLElement).style.cssText = `position:absolute;left:${l}%;top:${t}%;width:0;height:0;pointer-events:none;`;
          canvas.appendChild(el as HTMLElement);
        });

        const screenToLocalPct = (clientX: number, clientY: number) => {
          const o = axisOrigin.getBoundingClientRect();
          const xr = axisX.getBoundingClientRect();
          const yr = axisY.getBoundingClientRect();
          const ax = xr.left - o.left, ay = xr.top - o.top; // screen vector for +100% left
          const bx = yr.left - o.left, by = yr.top - o.top; // screen vector for +100% top
          const px = clientX - o.left, py = clientY - o.top;
          const det = ax * by - bx * ay || 1;
          return {
            l: +(((px * by - bx * py) / det) * 100).toFixed(2),
            t: +(((ax * py - px * ay) / det) * 100).toFixed(2),
          };
        };

        // Ground-truth current position: labels start out positioned via
        // Tailwind classes (left-[18.3%] etc.), not inline style, so
        // el.style.left is empty until the very first drag ever sets it.
        // Trying to reverse-engineer a rotated element's local % from its
        // (axis-aligned) bounding box turned out fragile — which corner/
        // edge "top" or "left" corresponds to shifts with the rotation
        // angle. Reading the number straight out of the inline style or
        // the class text sidesteps that entirely; only mouse movement
        // itself needs the rotation-aware conversion (screenToLocalPct).
        const posPct = (el: HTMLElement) => {
          const inlineL = parseFloat(el.style.left);
          const inlineT = parseFloat(el.style.top);
          if (!Number.isNaN(inlineL) && !Number.isNaN(inlineT)) return { l: inlineL, t: inlineT };
          const lMatch = el.className.match(/left-\[([\d.]+)%\]/);
          const tMatch = el.className.match(/top-\[([\d.]+)%\]/);
          return { l: lMatch ? parseFloat(lMatch[1]) : 50, t: tMatch ? parseFloat(tMatch[1]) : 50 };
        };
        const select = (el: HTMLElement | null) => {
          if (selected) selected.style.outline = "";
          selected = el;
          if (el) el.style.outline = "1px dashed rgba(26,74,110,.9)";
        };

        const makeDraggable = (el: HTMLElement) => {
          el.style.cursor = "move";
          el.addEventListener("pointerdown", (ev: PointerEvent) => {
            if ((ev.target as HTMLElement).isContentEditable) return;
            ev.preventDefault();
            select(el);
            const prevZ = el.style.zIndex;
            el.style.zIndex = "70"; // above the toolbar (30) and preview panel (60) — dragging near either used to hide the label underneath it
            const startPtr = screenToLocalPct(ev.clientX, ev.clientY);
            const startElPos = posPct(el);
            const grabL = startPtr.l - startElPos.l;
            const grabT = startPtr.t - startElPos.t;
            const move = (e: PointerEvent) => {
              const p = screenToLocalPct(e.clientX, e.clientY);
              el.style.left = (p.l - grabL).toFixed(2) + "%";
              el.style.top = (p.t - grabT).toFixed(2) + "%";
              const pp = posPct(el); read.textContent = pp.l + "% , " + pp.t + "%";
            };
            const up = () => {
              document.removeEventListener("pointermove", move);
              document.removeEventListener("pointerup", up);
              el.style.zIndex = prevZ;
            };
            document.addEventListener("pointermove", move);
            document.addEventListener("pointerup", up);
          });
          el.addEventListener("dblclick", () => {
            const t = (el.querySelector(".map-txt") as HTMLElement) || el;
            t.contentEditable = "true"; t.focus();
            const done = () => { t.contentEditable = "false"; t.removeEventListener("blur", done); };
            t.addEventListener("blur", done);
          });
        };

        [...canvas.querySelectorAll<HTMLElement>(".map-item")].forEach(makeDraggable);

        const addLabel = (withArrow: boolean) => {
          const el = document.createElement("span");
          el.className = labelCls;
          el.style.left = "50%"; el.style.top = "42%";
          el.innerHTML = '<span class="map-txt">TEXT</span>' + (withArrow ? " " + arrowRight : "");
          canvas.appendChild(el);
          makeDraggable(el); select(el);
          const t = el.querySelector(".map-txt") as HTMLElement;
          t.contentEditable = "true"; t.focus();
          getSelection()?.selectAllChildren(t);
          const done = () => { t.contentEditable = "false"; t.removeEventListener("blur", done); };
          t.addEventListener("blur", done);
        };

        bar.addEventListener("click", (ev) => {
          const act = (ev.target as HTMLElement).closest("[data-act]")?.getAttribute("data-act");
          if (act === "text") addLabel(false);
          else if (act === "arrow") addLabel(true);
          else if (act === "del") { if (selected && selected.classList.contains("map-user")) { selected.remove(); select(null); } }
          else if (act === "copy") {
            const out = [...canvas.querySelectorAll<HTMLElement>(".map-item")].map((el) => {
              const p = posPct(el);
              return "left-[" + p.l + "%] top-[" + p.t + "%]  «" + el.textContent!.trim() + "»";
            }).join("\n");
            navigator.clipboard?.writeText(out);
            read.textContent = "copied ✓";
            console.log("[map layout]\n" + out);
          }
        });
      }
    });

    // Runway diagram — mobile only: rotate the (landscape) chart -90° into a
    // straight portrait view, RWY 02/023° at the bottom pointing straight
    // up. Sized to fit the whole drawing within one screen height (no
    // scrolling needed to see the runway shape itself) — at this image's
    // aspect ratio (2896:392) that makes it fairly narrow, so labels near
    // the edges may run close together or extend slightly; the drawing
    // itself staying fully visible was the priority here. The angle is
    // adjustable (see the ?edit panel below) if a tilted, wider-but-off-
    // vertical layout is wanted again later. The canvas keeps its native
    // aspect ratio, just reoriented — its own width is set in JS so the rotated
    // bounding box matches the target height, since a plain CSS transform
    // doesn't resize the element's box. Each label carries the matching
    // counter-rotation (.map-counter-rotate, rotate-[90deg] in the markup)
    // so the numbers stay upright; direction arrows/ruler bars are left
    // un-countered so they end up pointing along the runway's new axis.
    // Desktop is untouched — sm: classes disable all of this and the chart
    // renders exactly as before.
    //
    // Under ?edit, a small angle/height panel lets you tune the rotated,
    // sized result live and read off the values to bake in here as the new
    // defaults. Preview starts on by default (same as real mobile
    // visitors see) — the label-drag editor above measures the canvas's
    // actual current axes on every move, so dragging works correctly
    // whether this is rotated or flattened via the panel's toggle.
    document.addEventListener("astro:page-load", () => {
      const wrap = document.getElementById("map-canvas-wrap");
      const canvas = document.getElementById("map-canvas");
      if (!wrap || !canvas) return;
      const ASPECT = 2896 / 392; // original landscape width/height
      const isEdit = new URLSearchParams(location.search).has("edit");

      let angle = 90; // degrees off vertical — straight portrait orientation
      let heightFrac = 0.72; // fraction of viewport height, capped below
      // Always on by default, edit mode included — the label editor's drag
      // math (in initMapEditor() above) measures the canvas's actual
      // current axes on every move, so it stays correct whether rotated or
      // flat. No more need to flatten the view just to drag labels.
      let previewOn = true;

      const counterRotated = () => Array.from(canvas.querySelectorAll<HTMLElement>(".map-counter-rotate"));

      const reset = () => {
        wrap.style.height = "";
        wrap.style.width = "";
        wrap.style.marginInline = "";
        canvas.style.position = "";
        canvas.style.top = "";
        canvas.style.left = "";
        canvas.style.width = "";
        canvas.style.transform = "";
        counterRotated().forEach((el) => { el.style.rotate = ""; });
      };

      const apply = () => {
        if (window.innerWidth >= 640 || !previewOn) { reset(); return; }
        const rad = (angle * Math.PI) / 180;
        const s = Math.abs(Math.sin(rad));
        const c = Math.abs(Math.cos(rad));
        // Leave room above for the "Runway 02 / 20" heading and the box's
        // own padding so the whole drawing — not just part of it — lands
        // inside one viewport.
        const targetH = Math.min(window.innerHeight * heightFrac, 700);
        // bbox height = Cw*s + (Cw/ASPECT)*c → solve for the canvas's own
        // (pre-rotation) width Cw, then derive the bbox width to match.
        const cw = targetH / (s + c / ASPECT);
        const bboxWidth = cw * c + (cw / ASPECT) * s;
        wrap.style.height = `${targetH}px`;
        wrap.style.width = `${bboxWidth}px`;
        wrap.style.marginInline = "auto";
        canvas.style.position = "absolute";
        canvas.style.top = "50%";
        canvas.style.left = "50%";
        canvas.style.width = `${cw}px`;
        canvas.style.transform = `translate(-50%, -50%) rotate(-${angle}deg)`;
        counterRotated().forEach((el) => { el.style.rotate = `${angle}deg`; });
      };

      apply();
      window.addEventListener("resize", apply);

      if (isEdit) {
        const panel = document.createElement("div");
        panel.contentEditable = "false";
        panel.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:60;display:flex;flex-direction:column;gap:7px;background:rgba(24,29,22,.88);color:#fff;padding:10px 12px;border-radius:10px;font:600 11px/1.4 ui-monospace,monospace;max-width:220px";
        panel.innerHTML =
          '<strong style="font-size:11px;opacity:.85">Runway mobile preview</strong>' +
          '<label style="display:flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" data-rp-toggle> Preview rotated</label>' +
          '<label>Angle <input type="range" data-rp-angle min="0" max="90" step="1" value="90" style="width:100%;vertical-align:middle"></label>' +
          '<label>Height <input type="range" data-rp-height min="30" max="100" step="1" value="72" style="width:100%;vertical-align:middle"></label>' +
          '<span data-rp-read style="opacity:.85"></span>' +
          '<span style="opacity:.6;font-weight:400">Drag labels directly, rotated or flat — angle/height only change the frame.</span>';
        document.body.appendChild(panel);

        const read = panel.querySelector("[data-rp-read]") as HTMLElement;
        const toggleEl = panel.querySelector("[data-rp-toggle]") as HTMLInputElement;
        const angleEl = panel.querySelector("[data-rp-angle]") as HTMLInputElement;
        const heightEl = panel.querySelector("[data-rp-height]") as HTMLInputElement;
        toggleEl.checked = previewOn;

        const updateRead = () => {
          read.textContent = `rotate(-${angle}deg) · ${Math.round(heightFrac * 100)}vh`;
        };
        updateRead();

        toggleEl.addEventListener("change", () => { previewOn = toggleEl.checked; apply(); });
        angleEl.addEventListener("input", () => { angle = +angleEl.value; updateRead(); apply(); });
        heightEl.addEventListener("input", () => { heightFrac = +heightEl.value / 100; updateRead(); apply(); });
      }
    });
  </script>

  <style>
    /* Hero "CFN" — the split engine renders F in Inter (.f-fix); at this
       size it reads larger than the display face's caps, so trim it to match.
       :global reaches the runtime-created span; the cid on .hero-display
       keeps this scoped to the pilots hero (the homepage "Aerfort" F is safe). */
    .hero-display :global(.f-fix) { font-size: 0.91em; }
    [data-nav-link].is-active { border-color: var(--color-atlantic); color: var(--color-ink); }
    .map-item { white-space: nowrap; z-index: 20; }
    .uas-ring { transition: fill-opacity .2s ease, stroke-width .2s ease; cursor: pointer; }
    .uas-ring.is-hot { fill-opacity: .4; stroke-width: 4; }
    .uas-card { transition: background-color .2s ease, border-color .2s ease; outline: none; }
    .uas-card.is-hot { border-color: var(--zc); background: color-mix(in srgb, var(--zc) 9%, var(--color-surface)); }
    @keyframes pulseDot { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.7); opacity: 0; } }
    .dd-fill { width: 0; transition: width 1.1s cubic-bezier(.22,.61,.36,1); }
    #dd.is-in .dd-fill { width: var(--w); }
    @media (prefers-reduced-motion: reduce) { .dd-fill { transition: none; width: var(--w); } }
    details.acc > summary { list-style: none; }
    details.acc > summary::-webkit-details-marker { display: none; }
    .acc-chevron { transition: transform 0.25s ease; display: inline-block; }
    details.acc[open] .acc-chevron { transform: rotate(180deg); }
  </style>
</BaseLayout>
