              <text class="uas-label" data-l="g" x="157" y="41" font-size="11" fill="#3a7a48">EIU35 · 18.5 km</text>
              <text class="uas-label" data-l="a" x="155" y="94" font-size="10" fill="#a5731a">EIU70 · 11.8 km</text>
              <text class="uas-label" data-l="r1" x="151" y="135" font-size="11" fill="#c0392b">EIU69</text>
