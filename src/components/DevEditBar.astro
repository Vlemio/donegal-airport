---
/**
 * DevEditBar — dev-only floating editor.
 * Never rendered in production builds (import.meta.env.DEV guard).
 *
 * Modes:
 *  ✏ Edit  — click any text to edit inline (contenteditable)
 *  🎛 Props — click any element to adjust size/spacing/position live
 *
 * Workflow: edit → 📋 Copy → paste to Claude → implement.
 */
if (!import.meta.env.DEV) return;
---

<style is:inline>
/* ─────────────────────────────────────────────────────────────── */
/*  DEV PROPS PANEL  (right drawer)                               */
/* ─────────────────────────────────────────────────────────────── */
#dev-props {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 9998;
  width: 264px;
  background: rgba(10,13,18,0.97);
  backdrop-filter: blur(20px) saturate(1.2);
  border-left: 1px solid rgba(243,240,234,0.10);
  display: flex; flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.22s cubic-bezier(0.25,0.46,0.45,0.94);
  font-family: "Space Mono", ui-monospace, monospace;
  overflow: hidden;
  box-shadow: -12px 0 40px rgba(0,0,0,0.5);
}
#dev-props.open { transform: translateX(0); }

/* Panel header */
.dp-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.85rem 1rem 0.6rem;
  border-bottom: 1px solid rgba(243,240,234,0.08);
  gap: 0.5rem; flex-shrink: 0;
}
.dp-el-name {
  font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: #c49a50;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dp-close {
  background: none; border: none; cursor: pointer;
  color: rgba(243,240,234,0.35); font-size: 1.1rem; line-height: 1;
  padding: 0; flex-shrink: 0;
  transition: color 0.12s;
}
.dp-close:hover { color: #f3f0ea; }

/* Tabs */
.dp-tabs {
  display: flex; flex-shrink: 0;
  border-bottom: 1px solid rgba(243,240,234,0.08);
}
.dp-tab {
  flex: 1; background: none; border: none; cursor: pointer;
  font-family: inherit; font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase;
  padding: 0.5rem 0; color: rgba(243,240,234,0.35);
  border-bottom: 2px solid transparent; margin-bottom: -1px;
  transition: color 0.12s, border-color 0.12s;
}
.dp-tab:hover { color: rgba(243,240,234,0.7); }
.dp-tab.active { color: #c49a50; border-bottom-color: #c49a50; }

/* Tab content */
.dp-pane { display: none; flex-direction: column; overflow-y: auto; flex: 1; padding-bottom: 1rem; }
.dp-pane.active { display: flex; }

/* Property row */
.dp-prop {
  display: flex; flex-direction: column; gap: 4px;
  padding: 0.55rem 1rem 0.5rem;
  border-bottom: 1px solid rgba(243,240,234,0.05);
}
.dp-prop-head {
  display: flex; align-items: center; justify-content: space-between;
}
.dp-prop-label { font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(243,240,234,0.4); }
.dp-prop-val   { font-size: 0.68rem; color: #c49a50; min-width: 54px; text-align: right; }
input[type=range].dp-range {
  width: 100%; accent-color: #c49a50; cursor: pointer;
  height: 3px; margin: 0;
}
select.dp-select {
  background: rgba(243,240,234,0.05); border: 1px solid rgba(243,240,234,0.12);
  color: #f3f0ea; font-family: inherit; font-size: 0.65rem;
  padding: 4px 8px; border-radius: 3px; cursor: pointer; width: 100%; margin-top: 2px;
}
/* Colour swatches */
.dp-swatches { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
.dp-swatch {
  width: 22px; height: 22px; border-radius: 3px; cursor: pointer; flex-shrink: 0;
  border: 2px solid transparent;
  transition: border-color 0.12s, transform 0.1s;
}
.dp-swatch:hover  { transform: scale(1.18); }
.dp-swatch.active { border-color: #fff !important; }

/* Reset row */
.dp-reset {
  margin: 0.75rem 1rem 0;
  background: rgba(248,81,73,0.08); border: 1px solid rgba(248,81,73,0.2);
  color: rgba(248,81,73,0.7); font-family: inherit;
  font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase;
  padding: 0.35rem; border-radius: 3px; cursor: pointer;
  transition: background 0.12s, color 0.12s; flex-shrink: 0;
}
.dp-reset:hover { background: rgba(248,81,73,0.18); color: #f85149; }

/* ─────────────────────────────────────────────────────────────── */
/*  CHIP BAR  (bottom-right)                                       */
/* ─────────────────────────────────────────────────────────────── */
#dev-bar {
  position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999;
  display: flex; align-items: center; gap: 0.45rem;
  font-family: "Space Mono", ui-monospace, monospace;
}
.dev-chip {
  display: flex; align-items: center; gap: 0.5rem;
  background: rgba(13,17,23,0.88); color: #f3f0ea;
  font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
  padding: 0.36rem 0.8rem; border-radius: 4px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(243,240,234,0.12);
  cursor: pointer; white-space: nowrap; user-select: none;
  transition: background 0.14s, border-color 0.14s, color 0.14s;
  text-decoration: none;
}
.dev-chip:hover           { background: rgba(40,50,60,0.96); border-color: rgba(243,240,234,0.28); }
.dev-chip.amber:hover     { background: rgba(196,154,80,0.88); border-color: #c49a50; color: #0d1117; }
.dev-chip.green:hover     { background: rgba(86,211,100,0.15); border-color: #56d364; color: #56d364; }
.dev-chip.red:hover       { background: rgba(248,81,73,0.15); border-color: #f85149; color: #f85149; }
.dev-chip.active-mode     { border-color: rgba(196,154,80,0.55); background: rgba(196,154,80,0.12); }

/* Pulsing dot */
.dev-dot {
  width: 6px; height: 6px; border-radius: 50%; background: #c49a50; flex-shrink: 0;
  animation: dev-pulse 2s ease-in-out infinite;
}

/* Hide action chips until a mode is active */
.dev-chip.mode-action { display: none; }
body.dev-text-mode   .dev-chip.text-action   { display: flex; }
body.dev-layout-mode .dev-chip.layout-action { display: flex; }
body.dev-text-mode   #dev-chip-text,
body.dev-layout-mode #dev-chip-layout { border-color: rgba(196,154,80,0.55); }

/* Element highlights */
body.dev-text-mode [data-edit] {
  outline: 1.5px dashed rgba(196,154,80,0.65) !important;
  outline-offset: 3px; cursor: text; border-radius: 2px;
}
body.dev-text-mode [data-edit]:focus {
  outline: 2px solid #c49a50 !important; outline-offset: 3px;
}
body.dev-text-mode [data-edit][data-text-changed]  { outline-color: #56d364 !important; }

body.dev-layout-mode [data-edit] {
  outline: 1.5px dashed rgba(100,180,255,0.5) !important;
  outline-offset: 3px; cursor: pointer; border-radius: 2px;
}
body.dev-layout-mode [data-edit]:hover {
  outline: 1.5px solid rgba(100,180,255,0.85) !important;
}
body.dev-layout-mode [data-edit].dp-selected {
  outline: 2px solid #64b4ff !important;
}
body.dev-layout-mode [data-edit][data-css-changed] { outline-color: #56d364 !important; }

@keyframes dev-pulse { 0%,100%{opacity:1}50%{opacity:0.35} }
</style>

<!-- ── Properties panel ─────────────────────────────────────── -->
<div id="dev-props">
  <div class="dp-header">
    <span class="dp-el-name" id="dp-el-name">—</span>
    <button class="dp-close" onclick="dpClose()" title="Close">×</button>
  </div>

  <div class="dp-tabs">
    <button class="dp-tab active" onclick="dpTab(this,'text')">Text</button>
    <button class="dp-tab"        onclick="dpTab(this,'layout')">Layout</button>
  </div>

  <!-- Text tab -->
  <div class="dp-pane active" id="dp-pane-text">

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Font size</span>
        <span class="dp-prop-val" id="dp-val-fontSize">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-fontSize" min="8" max="140" step="1"
        oninput="dpApply('fontSize', this.value+'px', 'font-size')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Font weight</span>
      </div>
      <select class="dp-select" id="dp-fontWeight"
        onchange="dpApply('fontWeight', this.value, 'font-weight')">
        <option value="300">300 · Light</option>
        <option value="400">400 · Regular</option>
        <option value="500">500 · Medium</option>
        <option value="600">600 · SemiBold</option>
        <option value="700">700 · Bold</option>
        <option value="800">800 · ExtraBold</option>
      </select>
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Letter spacing</span>
        <span class="dp-prop-val" id="dp-val-letterSpacing">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-letterSpacing" min="-5" max="40" step="0.5"
        oninput="dpApply('letterSpacing', this.value/100+'em', 'letter-spacing')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Line height</span>
        <span class="dp-prop-val" id="dp-val-lineHeight">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-lineHeight" min="75" max="250" step="1"
        oninput="dpApply('lineHeight', this.value/100, 'line-height')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Colour</span>
      </div>
      <div class="dp-swatches" id="dp-swatches">
        <div class="dp-swatch" style="background:#f3f0ea" title="Cream white" onclick="dpApplyColor('#f3f0ea')"></div>
        <div class="dp-swatch" style="background:#ffffff" title="Pure white"  onclick="dpApplyColor('#ffffff')"></div>
        <div class="dp-swatch" style="background:rgba(243,240,234,0.74)" title="Soft white (74%)" onclick="dpApplyColor('rgba(243,240,234,0.74)')"></div>
        <div class="dp-swatch" style="background:#c49a50" title="Sand gold" onclick="dpApplyColor('#c49a50')"></div>
        <div class="dp-swatch" style="background:#6bcf90" title="Green" onclick="dpApplyColor('#6bcf90')"></div>
        <div class="dp-swatch" style="background:#7d8590" title="Mute grey" onclick="dpApplyColor('#7d8590')"></div>
        <div class="dp-swatch" style="background:#1a4a6e" title="Atlantic blue" onclick="dpApplyColor('#1a4a6e')"></div>
        <div class="dp-swatch" style="background:#181d16" title="Ink black" onclick="dpApplyColor('#181d16')"></div>
      </div>
    </div>
  </div>

  <!-- Layout tab -->
  <div class="dp-pane" id="dp-pane-layout">

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Move left / right</span>
        <span class="dp-prop-val" id="dp-val-marginLeft">0 px</span>
      </div>
      <input type="range" class="dp-range" id="dp-marginLeft" min="-300" max="300" step="1"
        oninput="dpApply('marginLeft', this.value+'px', 'margin-left')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Max-width</span>
        <span class="dp-prop-val" id="dp-val-maxWidth">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-maxWidth" min="100" max="1800" step="10"
        oninput="dpApply('maxWidth', this.value+'px', 'max-width')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Padding top</span>
        <span class="dp-prop-val" id="dp-val-paddingTop">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-paddingTop" min="0" max="200" step="1"
        oninput="dpApply('paddingTop', this.value+'px', 'padding-top')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Padding bottom</span>
        <span class="dp-prop-val" id="dp-val-paddingBottom">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-paddingBottom" min="0" max="200" step="1"
        oninput="dpApply('paddingBottom', this.value+'px', 'padding-bottom')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Margin top</span>
        <span class="dp-prop-val" id="dp-val-marginTop">—</span>
      </div>
      <input type="range" class="dp-range" id="dp-marginTop" min="-100" max="300" step="1"
        oninput="dpApply('marginTop', this.value+'px', 'margin-top')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Height</span>
        <span class="dp-prop-val" id="dp-val-height">auto</span>
      </div>
      <input type="range" class="dp-range" id="dp-height" min="0" max="800" step="4"
        oninput="dpApply('height', this.value > 0 ? this.value+'px' : 'auto', 'height')">
    </div>

    <div class="dp-prop">
      <div class="dp-prop-head">
        <span class="dp-prop-label">Opacity</span>
        <span class="dp-prop-val" id="dp-val-opacity">1.0</span>
      </div>
      <input type="range" class="dp-range" id="dp-opacity" min="0" max="100" step="1"
        oninput="dpApply('opacity', this.value/100, 'opacity')">
    </div>

  </div>

  <button class="dp-reset" onclick="dpResetEl()">↺ Reset this element</button>
</div>

<!-- ── Chip bar ──────────────────────────────────────────────── -->
<div id="dev-bar">
  <!-- Always visible -->
  <a href="/trim-tool.html" target="_blank" class="dev-chip">✂ Trim</a>

  <!-- Text mode actions -->
  <button class="dev-chip green mode-action text-action" onclick="devCopyChanges()">📋 Copy</button>
  <button class="dev-chip red   mode-action text-action" onclick="devExitAll()">✗ Done</button>

  <!-- Layout mode actions -->
  <button class="dev-chip green mode-action layout-action" onclick="devCopyChanges()">📋 Copy</button>
  <button class="dev-chip red   mode-action layout-action" onclick="devExitAll()">✗ Done</button>

  <!-- Mode toggles -->
  <button id="dev-chip-text"   class="dev-chip amber" onclick="devToggleText()">✏ Text</button>
  <button id="dev-chip-layout" class="dev-chip amber" onclick="devToggleLayout()">🎛 Layout</button>
</div>

<script is:inline>
(function () {
  /* ── State ──────────────────────────────────────────────────────── */
  var textMode   = false;
  var layoutMode = false;
  var textOrig   = {};   // label → originalText
  var cssOrig    = {};   // label → { prop: origValue }
  var cssOver    = {};   // label → { prop: newValue, cssName: cssName }
  var selectedEl = null;
  var activeTab  = 'text';

  /* ── Text mode ──────────────────────────────────────────────────── */
  window.devToggleText = function () {
    textMode ? devExitAll() : enterTextMode();
  };

  function enterTextMode() {
    if (layoutMode) exitLayoutMode();
    textMode = true;
    document.body.classList.add('dev-text-mode');
    document.getElementById('dev-chip-text').classList.add('active-mode');

    document.querySelectorAll('[data-edit]').forEach(function (el) {
      var label = el.getAttribute('data-edit');
      textOrig[label] = el.innerText.trim();
      el.setAttribute('contenteditable', 'true');
      el.setAttribute('spellcheck', 'false');
      el.addEventListener('click', stopNav, true);
      el.addEventListener('input', function () {
        var changed = el.innerText.trim() !== textOrig[label];
        if (changed) el.setAttribute('data-text-changed','');
        else         el.removeAttribute('data-text-changed');
      });
    });
  }

  function exitTextMode() {
    textMode = false;
    document.body.classList.remove('dev-text-mode');
    document.getElementById('dev-chip-text').classList.remove('active-mode');
    document.querySelectorAll('[data-edit]').forEach(function (el) {
      el.removeAttribute('contenteditable');
      el.removeAttribute('data-text-changed');
      el.removeEventListener('click', stopNav, true);
    });
    textOrig = {};
  }

  /* ── Layout mode ────────────────────────────────────────────────── */
  window.devToggleLayout = function () {
    layoutMode ? devExitAll() : enterLayoutMode();
  };

  function enterLayoutMode() {
    if (textMode) exitTextMode();
    layoutMode = true;
    document.body.classList.add('dev-layout-mode');
    document.getElementById('dev-chip-layout').classList.add('active-mode');

    document.querySelectorAll('[data-edit]').forEach(function (el) {
      el.addEventListener('click', onElClick, true);
      el.addEventListener('click', stopNav, true);
    });
  }

  function exitLayoutMode() {
    layoutMode = false;
    document.body.classList.remove('dev-layout-mode');
    document.getElementById('dev-chip-layout').classList.remove('active-mode');
    dpClose();
    document.querySelectorAll('[data-edit]').forEach(function (el) {
      el.removeEventListener('click', onElClick, true);
      el.removeEventListener('click', stopNav, true);
      el.classList.remove('dp-selected');
    });
    selectedEl = null;
  }

  window.devExitAll = function () {
    if (textMode)   exitTextMode();
    if (layoutMode) exitLayoutMode();
  };

  /* ── Element click in layout mode ──────────────────────────────── */
  function onElClick(e) {
    e.preventDefault(); e.stopPropagation();
    if (!layoutMode) return;
    selectElement(e.currentTarget);
  }

  function selectElement(el) {
    document.querySelectorAll('[data-edit]').forEach(function (x) { x.classList.remove('dp-selected'); });
    el.classList.add('dp-selected');
    selectedEl = el;
    openPropsPanel(el);
  }

  /* ── Properties panel ───────────────────────────────────────────── */
  function openPropsPanel(el) {
    var label = el.getAttribute('data-edit');
    document.getElementById('dp-el-name').textContent = label;
    document.getElementById('dev-props').classList.add('open');

    var cs = window.getComputedStyle(el);

    /* Text tab */
    setSliderPx('dp-fontSize',     'dp-val-fontSize',     parseFloat(cs.fontSize)        || 16,   'px');
    setSlider  ('dp-lineHeight',   'dp-val-lineHeight',   (parseFloat(cs.lineHeight) / parseFloat(cs.fontSize) * 100) || 100, function(v){ return (v/100).toFixed(2); });
    setSliderPx('dp-letterSpacing','dp-val-letterSpacing', parseFloat(cs.letterSpacing)  || 0,    'px');
    setSelectVal('dp-fontWeight',  cs.fontWeight || '400');

    /* Layout tab */
    setSliderPx('dp-paddingTop',    'dp-val-paddingTop',    parseFloat(cs.paddingTop)    || 0, 'px');
    setSliderPx('dp-paddingBottom', 'dp-val-paddingBottom', parseFloat(cs.paddingBottom) || 0, 'px');
    setSliderPx('dp-marginTop',     'dp-val-marginTop',     parseFloat(cs.marginTop)     || 0, 'px');
    setSliderPx('dp-marginLeft',    'dp-val-marginLeft',    parseFloat(cs.marginLeft)    || 0, 'px');
    setSliderPx('dp-maxWidth',      'dp-val-maxWidth',      parseFloat(cs.maxWidth) > 9000 ? 1200 : (parseFloat(cs.maxWidth) || 600), 'px');
    setSliderPx('dp-height',        'dp-val-height',        parseFloat(cs.height) || 0,   'px');
    setSlider  ('dp-opacity',       'dp-val-opacity',       parseFloat(cs.opacity || '1') * 100, function(v){ return (v/100).toFixed(2); });

    /* Mark active colour swatch */
    var currentColor = cs.color;
    document.querySelectorAll('.dp-swatch').forEach(function (sw) {
      sw.classList.remove('active');
    });
  }

  window.dpClose = function () {
    document.getElementById('dev-props').classList.remove('open');
    if (selectedEl) { selectedEl.classList.remove('dp-selected'); selectedEl = null; }
  };

  window.dpTab = function (btn, name) {
    document.querySelectorAll('.dp-tab').forEach(function(t){ t.classList.remove('active'); });
    document.querySelectorAll('.dp-pane').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('dp-pane-' + name).classList.add('active');
    activeTab = name;
  };

  /* ── Apply CSS property ─────────────────────────────────────────── */
  window.dpApply = function (jsProp, value, cssName) {
    if (!selectedEl) return;
    var label = selectedEl.getAttribute('data-edit');
    selectedEl.style[jsProp] = value;
    selectedEl.setAttribute('data-css-changed', '');

    if (!cssOrig[label]) cssOrig[label] = {};
    if (!cssOver[label]) cssOver[label] = {};
    cssOver[label][cssName] = { value: value, js: jsProp };

    /* Update display value */
    var valEl = document.getElementById('dp-val-' + jsProp);
    if (valEl) valEl.textContent = value;
  };

  window.dpApplyColor = function (color) {
    if (!selectedEl) return;
    dpApply('color', color, 'color');
    document.querySelectorAll('.dp-swatch').forEach(function (sw) {
      sw.classList.toggle('active', sw.title && color.indexOf(sw.getAttribute('data-color')) > -1);
    });
  };

  window.dpResetEl = function () {
    if (!selectedEl) return;
    var label = selectedEl.getAttribute('data-edit');
    if (cssOver[label]) {
      Object.keys(cssOver[label]).forEach(function (cssName) {
        selectedEl.style[cssOver[label][cssName].js] = '';
      });
      delete cssOver[label];
      selectedEl.removeAttribute('data-css-changed');
    }
    openPropsPanel(selectedEl); // re-read
  };

  /* ── Copy all changes to clipboard ─────────────────────────────── */
  window.devCopyChanges = function () {
    var lines = ['HOME EDITS — paste to Claude', '─'.repeat(42), ''];
    var anyChange = false;

    /* Text changes */
    var textLines = [];
    document.querySelectorAll('[data-edit]').forEach(function (el) {
      var label   = el.getAttribute('data-edit');
      var current = el.innerText.trim();
      var orig    = textOrig[label] || '';
      if (current !== orig) {
        textLines.push('  ★ [' + label + ']  ' + JSON.stringify(current));
        anyChange = true;
      }
    });
    if (textLines.length) {
      lines.push('TEXT CHANGES:');
      textLines.forEach(function(l){ lines.push(l); });
      lines.push('');
    }

    /* CSS changes */
    var cssLines = [];
    Object.keys(cssOver).forEach(function (label) {
      var props = Object.keys(cssOver[label]).map(function (cssName) {
        return cssName + ': ' + cssOver[label][cssName].value;
      }).join(' · ');
      cssLines.push('  ★ [' + label + ']  ' + props);
      anyChange = true;
    });
    if (cssLines.length) {
      lines.push('CSS OVERRIDES (apply in index.astro or global.css):');
      cssLines.forEach(function(l){ lines.push(l); });
      lines.push('');
    }

    if (!anyChange) {
      lines.push('(no changes yet)');
    }

    var text = lines.join('\n');
    navigator.clipboard.writeText(text).then(function () {
      /* Flash the Copy buttons green */
      document.querySelectorAll('.dev-chip.green.mode-action').forEach(function (btn) {
        var orig = btn.textContent;
        btn.textContent = '✓ Copied!';
        btn.style.color = '#56d364'; btn.style.borderColor = '#56d364';
        setTimeout(function () {
          btn.textContent = orig;
          btn.style.color = ''; btn.style.borderColor = '';
        }, 2000);
      });
    }).catch(function () { alert(text); });
  };

  /* ── Helpers ────────────────────────────────────────────────────── */
  function stopNav(e) { e.preventDefault(); e.stopPropagation(); }

  function setSliderPx(sliderId, valId, px, unit) {
    var sl = document.getElementById(sliderId);
    var vl = document.getElementById(valId);
    if (!sl) return;
    sl.value = Math.max(parseFloat(sl.min), Math.min(parseFloat(sl.max), px));
    if (vl) vl.textContent = Math.round(px) + (unit || 'px');
  }

  function setSlider(sliderId, valId, val, fmt) {
    var sl = document.getElementById(sliderId);
    var vl = document.getElementById(valId);
    if (!sl) return;
    sl.value = Math.max(parseFloat(sl.min), Math.min(parseFloat(sl.max), val));
    if (vl) vl.textContent = fmt ? fmt(val) : val;
  }

  function setSelectVal(id, val) {
    var sel = document.getElementById(id);
    if (!sel) return;
    /* Round font-weight to nearest 100 */
    var w = Math.round(parseFloat(val) / 100) * 100;
    sel.value = String(w) || val;
  }
})();
</script>
