---
/*
  StoryEditor — in-browser visual tuner for the /story timeline.

  DEV-ONLY. Gated behind `import.meta.env.DEV` with an `is:inline` script, so
  it is NEVER emitted into the production build / the published site. Run the
  local dev server ("Donegal Airport" in the preview launcher); a small ✎
  button appears bottom-right.

  Per chapter you get live sliders + −/+ buttons to move/resize the photo, the
  text and the year, plus fields to edit the year, title and caption text.
  Nothing is auto-saved to source: press "Copiar valores" and paste them back
  (or into the `chapters` array in story.astro). Tweaks survive reloads via
  localStorage. Only knobs you actually touch are applied/exported, so opening
  the editor never silently freezes anything (e.g. the responsive year size).
*/
---

{
  import.meta.env.DEV && (
    <Fragment>
      <button id="se-toggle" type="button" aria-label="Editar story">✎</button>
      <aside id="se-panel" hidden>
        <header>
          <strong>Editor del story</strong>
          <span>solo local · no sale publicado</span>
        </header>
        <div id="se-body" />
        <footer>
          <button id="se-copy" type="button">📋 Copiar valores</button>
          <button id="se-reset" type="button">↺ Reset</button>
        </footer>
      </aside>

      <script is:inline>
        (function () {
          const LS = "story-editor-v2";
          const saved = JSON.parse(localStorage.getItem(LS) || "{}");

          // knob definitions ----------------------------------------------
          //  big = step for the −/+ buttons. skip = value treated as default
          //  (omitted from the copy output). yearSize has no numeric default
          //  (it's a responsive clamp) so it is never auto-applied.
          const KNOBS = [
            { key: "photoShiftY", prop: "--photo-shift", unit: "px", def: 0, min: -160, max: 320, step: 1, big: 5, skip: 0, label: "Foto ↕" },
            { key: "cardShiftY", prop: "--card-shift", unit: "px", def: 58, min: -160, max: 360, step: 1, big: 5, skip: 58, label: "Texto ↕" },
            { key: "photoH", prop: "--photo-h", unit: "vh", def: 78, min: 40, max: 105, step: 1, big: 3, skip: 78, label: "Tamaño", tall: true },
            { key: "photoW", prop: "--photo-w", unit: "%", def: 52, min: 28, max: 60, step: 0.5, big: 2, skip: 52, label: "Tamaño", wide: true },
            { key: "yearShiftY", prop: "--year-shift", unit: "px", def: 0, min: -200, max: 300, step: 1, big: 6, skip: 0, label: "Año ↕" },
            { key: "yearSize", prop: "--year-size", unit: "rem", def: null, min: 7, max: 32, step: 0.5, big: 1, skip: null, label: "Año tamaño" },
          ];

          const chapters = [].slice.call(document.querySelectorAll("[data-story-chapter]"));
          const sel = (ch, q) => ch.querySelector(q);
          const isTall = (ch) => ch.classList.contains("has-tall-photo");
          const hasPhoto = (ch) => ch.classList.contains("has-photo");
          const yearEl = (ch) => sel(ch, ".story-year-bg");
          const titleEl = (ch) => sel(ch, ".story-card h2");
          const capEl = (ch) => sel(ch, "figcaption");
          const yearSpanEl = (ch) => sel(ch, ".story-card p span");

          // state -----------------------------------------------------------
          const st = chapters.map((ch, i) => {
            const s = saved[i] || {};
            const o = { val: {}, had: {}, touched: {}, text: {} };
            KNOBS.forEach((k) => {
              const inline = ch.style.getPropertyValue(k.prop).trim();
              o.had[k.key] = inline !== "";
              if (s.val && s.val[k.key] != null) { o.val[k.key] = s.val[k.key]; o.touched[k.key] = true; }
              else if (inline) o.val[k.key] = parseFloat(inline);
              else if (k.key === "yearSize" && yearEl(ch)) o.val[k.key] = Math.round((parseFloat(getComputedStyle(yearEl(ch)).fontSize) / 16) * 2) / 2;
              else o.val[k.key] = k.def;
            });
            o.text.year = (s.text && s.text.year) != null ? s.text.year : (yearEl(ch) ? yearEl(ch).textContent.trim() : "");
            o.text.title = (s.text && s.text.title) != null ? s.text.title : (titleEl(ch) ? titleEl(ch).textContent.trim() : "");
            o.text.caption = (s.text && s.text.caption) != null ? s.text.caption : (capEl(ch) ? capEl(ch).textContent.trim() : "");
            return o;
          });

          const live = (i, key) => st[i].touched[key] || st[i].had[key];

          function applyPos(i, key) {
            const ch = chapters[i], k = KNOBS.find((x) => x.key === key), v = st[i].val[key];
            if (live(i, key) && v != null && !isNaN(v)) ch.style.setProperty(k.prop, v + k.unit);
            else ch.style.removeProperty(k.prop);
          }
          function applyText(i) {
            const ch = chapters[i], t = st[i].text;
            if (yearEl(ch)) yearEl(ch).textContent = t.year;
            if (yearSpanEl(ch)) yearSpanEl(ch).textContent = t.year;
            if (titleEl(ch)) titleEl(ch).textContent = t.title;
            if (capEl(ch) && t.caption) capEl(ch).textContent = t.caption;
          }
          function save() {
            localStorage.setItem(LS, JSON.stringify(st.map((o) => {
              const v = {}; Object.keys(o.touched).forEach((k) => { if (o.touched[k]) v[k] = o.val[k]; });
              return { val: v, text: o.text };
            })));
          }

          // build UI --------------------------------------------------------
          const body = document.getElementById("se-body");
          chapters.forEach((ch, i) => {
            if (!hasPhoto(ch)) return;
            const tall = isTall(ch);
            const det = document.createElement("details");
            if (i === 0) det.open = true;
            const sum = document.createElement("summary");
            sum.textContent = "Sección " + (i + 1) + " · " + st[i].text.year;
            det.appendChild(sum);

            // text fields
            [["Año", "year"], ["Título", "title"], ["Pie", "caption"]].forEach(([lab, key]) => {
              if (key === "caption" && !capEl(ch)) return;
              const row = document.createElement("label");
              row.className = "se-text";
              row.innerHTML = "<span>" + lab + "</span>";
              const inp = document.createElement("input");
              inp.type = "text"; inp.value = st[i].text[key];
              inp.addEventListener("input", () => { st[i].text[key] = inp.value; applyText(i); save(); });
              row.appendChild(inp);
              det.appendChild(row);
            });

            // sliders with −/+ buttons
            KNOBS.forEach((k) => {
              if (k.tall && !tall) return;
              if (k.wide && tall) return;
              const row = document.createElement("div");
              row.className = "se-row";
              const lab = document.createElement("span"); lab.className = "se-lab"; lab.textContent = k.label;
              const minus = document.createElement("button"); minus.type = "button"; minus.className = "se-step"; minus.textContent = "−";
              const rng = document.createElement("input"); rng.type = "range"; rng.min = k.min; rng.max = k.max; rng.step = k.step;
              const plus = document.createElement("button"); plus.type = "button"; plus.className = "se-step"; plus.textContent = "+";
              const num = document.createElement("input"); num.type = "number"; num.min = k.min; num.max = k.max; num.step = k.step; num.className = "se-num";
              const cur = st[i].val[k.key];
              rng.value = num.value = cur != null && !isNaN(cur) ? cur : k.def != null ? k.def : 0;
              const set = (v) => {
                v = Math.round(parseFloat(v) * 2) / 2; if (isNaN(v)) return;
                v = Math.max(k.min, Math.min(k.max, v));
                st[i].val[k.key] = v; st[i].touched[k.key] = true;
                rng.value = v; num.value = v; applyPos(i, k.key); save();
              };
              rng.addEventListener("input", () => set(rng.value));
              num.addEventListener("input", () => set(num.value));
              minus.addEventListener("click", () => set(parseFloat(num.value) - k.big));
              plus.addEventListener("click", () => set(parseFloat(num.value) + k.big));
              row.append(lab, minus, rng, plus, num);
              det.appendChild(row);
            });
            body.appendChild(det);
          });

          // copy ------------------------------------------------------------
          document.getElementById("se-copy").addEventListener("click", () => {
            const lines = ["// ==== Valores del editor del story ===="];
            chapters.forEach((ch, i) => {
              if (!hasPhoto(ch)) return;
              const tall = isTall(ch), t = st[i].text, parts = [];
              KNOBS.forEach((k) => {
                if (k.tall && !tall) return; if (k.wide && tall) return;
                if (!live(i, k.key)) return;
                const v = st[i].val[k.key];
                if (v == null || isNaN(v) || (k.skip != null && v === k.skip)) return;
                parts.push(k.key + ": " + (k.unit === "px" ? v : '"' + v + k.unit + '"'));
              });
              lines.push("// Sección " + (i + 1) + " (" + t.year + ")");
              lines.push("  " + (parts.length ? parts.join(", ") : "(posición por defecto)"));
              lines.push('  year: "' + t.year + '", title: "' + t.title.replace(/"/g, '\\"') + '"' + (t.caption ? ', photoCaption: "' + t.caption.replace(/"/g, '\\"') + '"' : ""));
            });
            const out = lines.join("\n");
            navigator.clipboard.writeText(out).then(
              () => { const b = document.getElementById("se-copy"); b.textContent = "✓ Copiado"; setTimeout(() => (b.textContent = "📋 Copiar valores"), 1500); },
              () => window.prompt("Copia esto:", out)
            );
          });

          document.getElementById("se-reset").addEventListener("click", () => {
            if (!confirm("¿Descartar tus cambios del editor y volver a los valores del archivo?")) return;
            localStorage.removeItem(LS); location.reload();
          });

          const panel = document.getElementById("se-panel");
          document.getElementById("se-toggle").addEventListener("click", () => { panel.hidden = !panel.hidden; });

          // initial apply (only touched/inline knobs + any saved text)
          st.forEach((o, i) => { KNOBS.forEach((k) => applyPos(i, k.key)); applyText(i); });
        })();
      </script>

      <style is:global>
        #se-toggle {
          position: fixed; right: 18px; bottom: 18px; z-index: 9999;
          width: 46px; height: 46px; border-radius: 999px; border: none;
          background: #181d16; color: #f3f2ee; font-size: 20px; cursor: pointer;
          box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
        }
        #se-panel {
          position: fixed; right: 18px; bottom: 74px; z-index: 9999;
          width: 360px; max-height: 80vh; overflow-y: auto;
          background: #fffefb; color: #181d16; border: 1px solid rgba(0, 0, 0, 0.12);
          border-radius: 14px; box-shadow: 0 12px 48px rgba(0, 0, 0, 0.28);
          font-family: ui-sans-serif, system-ui, sans-serif; font-size: 12px;
          padding: 12px 14px;
        }
        #se-panel[hidden] { display: none; }
        #se-panel header { display: flex; flex-direction: column; margin-bottom: 8px; }
        #se-panel header strong { font-size: 13px; }
        #se-panel header span { color: #8a8a82; font-size: 10px; }
        #se-panel details { border-top: 1px solid rgba(0, 0, 0, 0.08); padding: 6px 0; }
        #se-panel summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
        #se-panel .se-text { display: grid; grid-template-columns: 46px 1fr; align-items: center; gap: 6px; margin: 4px 0; }
        #se-panel .se-text span { color: #56605a; }
        #se-panel .se-text input { width: 100%; padding: 3px 6px; border: 1px solid rgba(0, 0, 0, 0.18); border-radius: 6px; font-size: 11px; }
        #se-panel .se-row { display: grid; grid-template-columns: 70px 22px 1fr 22px 50px; align-items: center; gap: 5px; margin: 5px 0; }
        #se-panel .se-lab { color: #56605a; }
        #se-panel .se-row input[type="range"] { width: 100%; }
        #se-panel .se-step { width: 22px; height: 22px; padding: 0; border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 5px; background: #f3f2ee; cursor: pointer; font-size: 14px; line-height: 1; }
        #se-panel .se-step:hover { background: #e6e4dc; }
        #se-panel .se-num { width: 100%; padding: 2px 4px; border: 1px solid rgba(0, 0, 0, 0.18); border-radius: 5px; font-size: 11px; }
        #se-panel footer { display: flex; gap: 8px; margin-top: 10px; }
        #se-panel footer button { flex: 1; padding: 7px; border: 1px solid rgba(0, 0, 0, 0.18); border-radius: 7px; background: #f3f2ee; cursor: pointer; font-size: 11px; }
        #se-panel footer button#se-copy { background: #2c5430; color: #fff; border-color: #2c5430; }
      </style>
    </Fragment>
  )
}
