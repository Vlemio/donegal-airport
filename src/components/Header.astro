---
import { getLocale, altLocalePath, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? getLocale(Astro.url.pathname);
const altPath = altLocalePath(Astro.url.pathname, locale);
const prefix = locale === "ga" ? "/ga" : "";

const nav = [
  { key: "home", href: prefix || "/" },
  { key: "flights", href: `${prefix}/flights` },
  { key: "plan", href: `${prefix}/plan` },
  { key: "discover", href: `${prefix}/discover` },
  { key: "about", href: `${prefix}/story` },
  { key: "pilots", href: `${prefix}/pilots` },
  { key: "contact", href: `${prefix}/contact` },
] as const;

const { pathname } = Astro.url;
const normalise = (p: string) =>
  p.endsWith("/") && p.length > 1 ? p.slice(0, -1) : p;
const isActive = (href: string) => {
  const a = normalise(href);
  const b = normalise(pathname);
  // Home links match only when exactly on the home page
  if (a === "/" || a === "/ga") return b === a || b === "";
  return b.startsWith(a);
};

const switchToLabel = t("languageToggle.switchTo", locale);
---

{/* The header starts off-screen above; animations.ts reveals it on
    scroll-up (or near top). Deliberate break from Errigal's
    translucent fixed bar. */}
<header
  data-header
  class="fixed inset-x-0 top-0 z-50"
>
  <div
    class:list={[
      // justify-between is the base for both locales — needed at mobile
      // widths so brand and the hamburger button stay pinned to opposite
      // edges either way.
      "mx-auto flex h-[var(--header-h)] items-center justify-between px-6",
      // Gaeilge nav labels need more room than the English ones ever do —
      // widen just this bar for "ga" rather than cramp the nav together.
      // The page content below keeps the normal max-w-7xl either way.
      //
      // At lg+ (where the desktop nav shows), Gaeilge switches to a
      // centered group with one consistent gap across brand → nav →
      // lang-toggle. Plain justify-between here would've dumped all the
      // extra width from the wider bar into just the two outer gaps,
      // leaving brand and "GAEILGE/ENGLISH" looking far more separated
      // from the nav links than the nav links are from each other.
      locale === "ga" ? "max-w-[96rem] lg:justify-center lg:gap-6" : "max-w-7xl",
    ]}
  >
    <a
      href={prefix || "/"}
      class="relative z-50 flex items-baseline gap-3 leading-none"
    >
      <span data-brand-name class="font-display text-xl font-normal tracking-tight text-ink">
        {t("site.name", locale)}
      </span>
      <span
        data-brand-code
        class="hidden font-mono text-[0.6rem] uppercase tracking-[0.28em] text-mute sm:inline"
      >
        CFN · EIDL
      </span>
    </a>

    {/* Gaeilge labels run noticeably longer ("Pleanáil do thuras", "Faigh
        amach Dún na nGall") — the wider bar above gives this room to
        breathe without touching English's sizing or spacing at all. */}
    <nav
      class:list={["hidden items-center lg:flex", locale === "ga" ? "gap-6" : "gap-7"]}
      aria-label={t("a11y.mainNavigation", locale)}
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "whitespace-nowrap text-[0.78rem] uppercase tracking-[0.18em] transition-colors duration-200 hover:text-atlantic",
              isActive(item.href) ? "text-atlantic" : "text-ink/70",
            ]}
          >
            {t(`nav.${item.key}` as any, locale)}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={altPath}
        data-lang-toggle
        class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-ink/70 transition-colors hover:text-atlantic"
        aria-label={`${t("languageToggle.switchToAria", locale)} ${switchToLabel}`}
      >
        {switchToLabel}
      </a>
    </div>

    <button
      data-nav-toggle
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t("a11y.openMenu", locale)}
      class="relative z-50 text-ink lg:hidden"
    >
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

{/* Sibling of <header>, not a child — on at least one page (/flights) a
    "fixed inset-0" panel nested inside the also-fixed <header> was
    measuring at the header's own ~76px content height instead of the
    full viewport (reproduced via getBoundingClientRect; forcing
    position/inset back with inline !important on the panel itself did
    not fix it, so something about the nesting itself was the trigger,
    not an overridable CSS property). Moving it out to a sibling removes
    that dependency regardless of the exact mechanism. */}
<div
  id="mobile-nav"
  data-mobile-nav
  class="fixed inset-0 z-40 translate-x-full bg-surface transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] lg:hidden"
>
  <nav
    class="flex h-full flex-col items-center justify-center gap-4"
    aria-label={t("a11y.siteNavigation", locale)}
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            // The panel opens by moving focus to this first link (a11y: lands
            // keyboard/screen-reader users inside it) — outline-none here plus
            // focus-visible below keeps that tab-accessible while dropping the
            // focus rectangle iOS Safari otherwise leaves stuck on tap-open.
            "max-w-[85vw] text-center font-display text-4xl outline-none transition-colors hover:text-atlantic focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-atlantic",
            isActive(item.href) ? "text-atlantic" : "text-ink",
          ]}
        >
          {t(`nav.${item.key}` as any, locale)}
        </a>
      ))
    }
    <a
      href={altPath}
      class="mt-6 font-mono text-xs uppercase tracking-[0.24em] text-ink/70"
    >
      {switchToLabel}
    </a>
  </nav>
</div>
