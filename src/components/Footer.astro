---
import { t, type Locale, getLocale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? getLocale(Astro.url.pathname);
const prefix = locale === "ga" ? "/ga" : "";
const year = new Date().getFullYear();

const nav = [
  { key: "flights", href: `${prefix}/flights` },
  { key: "plan", href: `${prefix}/plan` },
  { key: "discover", href: `${prefix}/discover` },
  { key: "about", href: `${prefix}/story` },
  { key: "pilots", href: `${prefix}/pilots` },
  { key: "contact", href: `${prefix}/contact` },
] as const;

// Footer body copy that isn't in the i18n dictionary yet — kept here as a
// simple locale branch (same pattern as Header.astro's gap-width tweak)
// rather than expanding en.json/ga.json for a one-off handful of strings.
const address = locale === "ga"
  ? { l1: "Carraig Fhinn, Cionn Caslach", l2: "Leitir Ceanainn, Co. Dhún na nGall", l3: "F94 X2RH, Éire" }
  : { l1: "Carrickfinn, Kincasslagh", l2: "Letterkenny, Co. Donegal", l3: "F94 X2RH, Ireland" };

const routesLabel = locale === "ga" ? "Bealaí" : "Routes";
const routes = locale === "ga"
  ? [
      { name: "Baile Átha Cliath", freq: "Gach lá · 2× fillte" },
      { name: "Glaschú", freq: "Laethanta roghnaithe" },
    ]
  : [
      { name: "Dublin", freq: "Daily · 2× return" },
      { name: "Glasgow", freq: "Select days" },
    ];

const legalLinks = locale === "ga"
  ? ["Príobháideachas", "Sábháilteacht", "Comhshaol"]
  : ["Privacy", "Safety", "Environmental"];

const socials = [
  { label: "Facebook", href: "https://www.facebook.com/donegalairport" },
  { label: "Instagram", href: "https://www.instagram.com/donegalairport" },
  { label: "X", href: "https://twitter.com/DonegalA" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/donegal-airport" },
  { label: "YouTube", href: "https://www.youtube.com/@donegalairport89" },
  { label: "TikTok", href: "https://www.tiktok.com/@donegalairport" },
];

// Marquee strip — Solari/flap-display feel. The IATA codes for the
// current routes from CFN tick across; clicking jumps to that
// destination card. Animation is pure CSS (see global.css). Content
// is duplicated inline so the loop seam is invisible. */
const marqueeItems = [
  "CFN → DUB · DUBLIN",
  "EI 3401 · EI 3402",
  "CFN → GLA · GLASGOW",
  "EI 3403 · EI 3408",
  "WORLD'S MOST SCENIC RUNWAY",
  "CARRICKFINN · 55.04°N 8.34°W",
  "ELEV 30 FT",
  "RUNWAY 02/20 · 1495M",
  "ATC 129.805",
];
---

<footer data-footer class="relative bg-surface text-ink">
  {/* Marquee — pure CSS animation defined in global.css. */}
  <div class="marquee border-y border-line py-3" aria-hidden="true">
    <div class="marquee-track text-[0.72rem] uppercase tracking-[0.2em] text-mute">
      {/* Content duplicated so the seam is invisible. */}
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span class="whitespace-nowrap">{item}</span>
      ))}
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pt-24 pb-12">
    <div class="grid gap-14 md:grid-cols-12">
      {/* Wordmark + tagline */}
      <div data-animate="fade-up" class="md:col-span-5">
        <p class="font-display text-4xl leading-[0.95] sm:text-5xl">
          {t("site.name", locale)}
        </p>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-mute">
          {t("site.description", locale)}
        </p>
        <p class="mt-8 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-sand">
          IATA · CFN &nbsp;/&nbsp; ICAO · EIDL
        </p>
      </div>

      {/* NAP */}
      <div data-animate="fade-up" data-animate-delay="0.08" class="md:col-span-3">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-sand">
          {t("footer.visit", locale)}
        </p>
        <address class="mt-5 text-sm not-italic leading-relaxed text-mute">
          {address.l1}<br />
          {address.l2}<br />
          {address.l3}
        </address>
        <p class="mt-4 text-sm">
          <a
            href="tel:+353749548284"
            class="text-ink transition-colors hover:text-sand"
          >
            +353 (0)74 9548284
          </a>
        </p>
        <p class="mt-1 text-sm">
          <a
            href="mailto:info@donegalairport.ie"
            class="text-ink transition-colors hover:text-sand"
          >
            info@donegalairport.ie
          </a>
        </p>
        <div class="mt-6 border-t border-line pt-5">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-sand">{routesLabel}</p>
          <ul class="mt-3 space-y-2 text-sm text-mute">
            {routes.map((r) => (
              <li>
                <span class="text-ink">{r.name}</span>
                <span class="ml-2 font-mono text-[0.64rem] tracking-[0.1em]">{r.freq}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Nav */}
      <div data-animate="fade-up" data-animate-delay="0.16" class="md:col-span-2">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-sand">
          {t("footer.explore", locale)}
        </p>
        <ul class="mt-5 space-y-2 text-sm">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-mute transition-colors hover:text-sand"
              >
                {t(`nav.${item.key}` as any, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Social */}
      <div data-animate="fade-up" data-animate-delay="0.24" class="md:col-span-2">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-sand">
          {t("footer.follow", locale)}
        </p>
        <ul class="mt-5 space-y-2 text-sm">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="text-mute transition-colors hover:text-sand"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div
      class="mt-20 flex flex-col gap-3 border-t border-line pt-8 text-[0.7rem] uppercase tracking-[0.2em] text-mute sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {t("site.name", locale)}. {t("footer.rights", locale)}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {legalLinks.map((label) => (
          <li><a href="#" class="hover:text-sand">{label}</a></li>
        ))}
        <li><a href="#" class="hover:text-sand">Ráiteas Beartas Teanga</a></li>
      </ul>
    </div>
  </div>
</footer>
